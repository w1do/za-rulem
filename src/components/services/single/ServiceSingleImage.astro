---
import ContentImage from '../../shared/ui/ContentImage.astro';

const { image = '/images/service-single-image.jpg', alt = '' } = Astro.props;
---

<!-- Page Single Image Start -->
<div class="page-single-image">
	<figure class="image-anime reveal">
		<ContentImage src={image} alt={alt} width={1200} height={600} loading="eager" />
	</figure>
</div>
<!-- Page Single Image End -->

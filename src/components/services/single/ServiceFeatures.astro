---
interface Props {
	title?: string;
	description?: string;
	items?: Array<{ icon: string; title: string }>;
	footerBadge?: string;
	footerText?: string;
	footerLinkLabel?: string;
	footerLinkHref?: string;
	service?: string;
	subject?: string;
	requestTitle?: string;
}

const {
	title = 'Что я предлагаю',
	description,
	items = [],
	footerBadge = '24/7',
	footerText = 'Опишите ситуацию, и я выеду на место.',
	footerLinkLabel = 'Оставить заявку.',
	footerLinkHref = '/contacts',
	service,
	subject,
	requestTitle = 'Вызвать помощь',
} = Astro.props;
---

{
	items.length > 0 && (
		<div class="service-features-box">
			<h2 class="text-anime-style-3">{title}</h2>
			{description && <p class="wow fadeInUp">{description}</p>}

			<!-- Service Feature Item List Start -->
			<div class="service-feature-item-list">
				{items.map((item, i) => (
					<div class="service-feature-item wow fadeInUp" data-wow-delay={`${(i + 1) * 0.2}s`}>
						<div class="icon-box">
							<img src={item.icon} alt={item.title} />
						</div>
						<div class="service-feature-item-content">
							<h3>{item.title}</h3>
						</div>
					</div>
				))}
			</div>
			<!-- Service Feature Item List End -->

			<!-- Section Footer Text Start -->
			<div class="section-footer-text wow fadeInUp" data-wow-delay="0.8s">
				<p><span>{footerBadge}</span> {footerText} <a
					href={footerLinkHref}
					data-service-request
					data-service={service}
					data-service-subject={subject}
					data-service-title={requestTitle}
				>{footerLinkLabel}</a></p>
			</div>
			<!-- Section Footer Text End -->
		</div>
	)
}

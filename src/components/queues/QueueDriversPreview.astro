---
import type { QueueDriver } from '../../data/queueDrivers';
import QueueDriverCard from './QueueDriverCard.astro';

interface Props {
	drivers: QueueDriver[];
	stations: string[];
	subtitle?: string;
	title?: string;
	description?: string;
	ctaHref?: string;
	ctaText?: string;
}

const {
	drivers,
	stations,
	subtitle = 'Очередь без ожидания',
	title = 'Водители, которые займут очередь на АЗС',
	description = 'Я собрал свободных водителей, готовых заранее приехать на заправку и занять место в очереди. Связаться и договориться о времени можно напрямую.',
	ctaHref = '/queue',
	ctaText = 'Посмотреть всех водителей',
} = Astro.props;
---

<section class="queue-drivers-section">
	<div class="container">
		<div class="section-title queue-drivers-section__title">
			<span class="section-sub-title wow fadeInUp">{subtitle}</span>
			<h2 class="text-anime-style-3" data-cursor="-opaque">{title}</h2>
			<p class="wow fadeInUp" data-wow-delay="0.2s">{description}</p>
		</div>

		<div class="queue-stations wow fadeInUp" data-wow-delay="0.3s" aria-label="Доступные сети АЗС">
			<span class="queue-stations__label">Любая из заправок:</span>
			<ul>
				{stations.map((station) => <li>{station}</li>)}
			</ul>
		</div>

		<div class="queue-drivers-grid">
			{drivers.map((driver) => <QueueDriverCard driver={driver} />)}
		</div>

		<div class="queue-drivers-section__action">
			<a href={ctaHref} class="btn-default">{ctaText}</a>
		</div>
	</div>
</section>

<style>
	.queue-drivers-section { padding: 70px 0 120px; }
	.queue-drivers-section__title { max-width: 820px; margin: 0 auto 32px; text-align: center; }
	.queue-drivers-section__title p { margin-bottom: 0; }
	.queue-stations { display: flex; align-items: center; justify-content: center; gap: 14px; margin-bottom: 40px; }
	.queue-stations__label { color: var(--primary-color); font-weight: 700; }
	.queue-stations ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 0; padding: 0; list-style: none; }
	.queue-stations li { padding: 8px 14px; border-radius: 999px; background: var(--secondary-color); color: var(--primary-color); font-size: 14px; font-weight: 600; }
	.queue-drivers-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
	.queue-drivers-section__action { margin-top: 40px; text-align: center; }

	@media (max-width: 991px) {
		.queue-drivers-section { padding: 50px 0 80px; }
		.queue-drivers-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (max-width: 767px) {
		.queue-drivers-section { padding: 35px 0 60px; }
		.queue-drivers-section__title { margin-bottom: 24px; text-align: left; }
		.queue-stations { align-items: flex-start; flex-direction: column; margin-bottom: 28px; }
		.queue-stations ul { justify-content: flex-start; }
		.queue-drivers-grid { grid-template-columns: 1fr; }
		.queue-drivers-section__action { margin-top: 30px; }
		.queue-drivers-section__action .btn-default { display: block; width: 100%; text-align: center; }
	}
</style>
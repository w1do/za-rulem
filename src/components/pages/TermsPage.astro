---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/shared/header/Header.astro';
import Footer from '../../components/shared/footer/Footer.astro';
import PageHeaderHelpButton from '../../components/shared/PageHeaderHelpButton.astro';
import { webPageNode, breadcrumbNode } from '../../lib/seo';
import type { ChatCity } from '../../data/cities';
import { replaceCityPlaceholders, getCityUrl } from '../../lib/city';

export interface Props {
	city: ChatCity;
}

const { city } = Astro.props;

const title = replaceCityPlaceholders("Условия обслуживания — техпомощь {inCity} | За рулём", city);
const description = replaceCityPlaceholders("Условия оказания автопомощи и техпомощи на дороге {inCity}: маркетплейс помощи от водителей, мониторинг цен на топливо и локальные чаты.", city);

const jsonLd = [
	webPageNode({
		type: 'WebPage',
		name: replaceCityPlaceholders('Условия обслуживания — маркетплейс техпомощи на дороге {inCity} «За рулём»', city),
		description: replaceCityPlaceholders('Условия работы маркетплейса автопомощи и мониторинга цен на топливо {inCity}: как оформить вызов, ответственность сторон и локальные чаты.', city),
		url: getCityUrl('/terms', city.slug),
	}),
	breadcrumbNode([
		{ name: 'Главная', url: getCityUrl('/', city.slug) },
		{ name: 'Условия обслуживания', url: getCityUrl('/terms', city.slug) },
	]),
];
---

<Layout
	title={title}
	description={description}
	keywords={replaceCityPlaceholders("условия обслуживания, техпомощь {city}, автопомощь на дороге, вызов помощи, оплата на месте", city)}
	jsonLd={jsonLd}
    city={city}
>
	<Header city={city} />

	<!-- Page Header Section Start -->
	<div class="page-header parallaxie">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<!-- Page Header Box Start -->
					<div class="page-header-box">
						<h1 class="text-anime-style-3" data-cursor="-opaque">Условия обслуживания</h1>
						<nav class="wow fadeInUp">
							<div class="post-single-meta wow fadeInUp">
								<ol class="breadcrumb">
									<li><i class="fa-regular fa-clock"></i> Обновлено 30 июля 2026</li>
								</ol>
							</div>
						</nav>
						<PageHeaderHelpButton />
					</div>
					<!-- Page Header Box End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Header Section End -->

	<!-- Page Single Post Start -->
	<div class="page-single-post">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<!-- Post Single Content Start -->
					<div class="post-content">
						<!-- Post Entry Start -->
						<div class="post-entry">
							<p class="wow fadeInUp">
								{replaceCityPlaceholders("Наш сервис предоставляет помощь на дороге и мониторинг цен для помощи водителей {inCity} и области. За рулём — это маркетплейс помощи ближайших водителей. Оставляя заявку на сайте или используя наши сервисы, вы соглашаетесь с данными условиями.", city)}
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="0.2s">Как работает наш сервис</h2>
							<p class="wow fadeInUp" data-wow-delay="0.4s">
								Мы специализируемся на оперативной помощи водителям в сложных ситуациях. Мы создали локальные чаты по каждому городу для взаимовыручки и быстрого обмена информацией.
								Наш маркетплейс помогает решить проблемы, если у водителя сломалось авто, нужен бензин или машина застряла в грязи.
							</p>
							<ul class="wow fadeInUp" data-wow-delay="0.6s">
								<li>Мы обрабатываем поступающие заявки в режиме реального времени.</li>
								<li>Как только заявка поступает, свободный ближайший водитель берет её в работу и выезжает на помощь.</li>
								<li>Мы также помогаем нашим клиентам отслеживать актуальные цены на топливо по разным городам, чтобы вы могли экономить.</li>
							</ul>

							<h2 class="wow fadeInUp" data-wow-delay="0.8s">Как вызвать помощь</h2>
							<p class="wow fadeInUp" data-wow-delay="1s">
								Чтобы получить помощь, оставьте заявку на сайте или воспользуйтесь локальным чатом вашего города. Укажите характер проблемы и ваше местоположение. Ближайший к вам водитель откликнется на запрос.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="1.2s">Стоимость и мониторинг цен</h2>
							<p class="wow fadeInUp" data-wow-delay="1.4s">
								Итоговая стоимость помощи согласуется напрямую с водителем, принявшим заявку, до начала выполнения работ. Сервис мониторинга цен на топливо предоставляется информационно и помогает ориентироваться в актуальной стоимости бензина и дизеля {city.inCity}.
							</p>

							<blockquote class="wow fadeInUp" data-wow-delay="1.6s">
								<p>
									Наш приоритет — скорость и прозрачность. Мы объединяем водителей для взаимопомощи и предоставляем актуальные данные о ценах на АЗС.
								</p>
							</blockquote>

							<h2 class="wow fadeInUp" data-wow-delay="1.8s">Ответственность сторон</h2>
							<p class="wow fadeInUp" data-wow-delay="2s">
								Сервис «За рулём» выступает платформой, соединяющей нуждающегося в помощи водителя с ближайшим исполнителем. Исполнители несут ответственность за качество оказываемых услуг на месте. Мы стремимся поддерживать высокий уровень сообщества в локальных чатах и актуальность данных мониторинга.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="2.2s">Ограничения</h2>
							<p class="wow fadeInUp" data-wow-delay="2.4s">
								Мы помогаем в решении дорожных проблем, которые можно устранить на месте или путем эвакуации. Мы не гарантируем наличие свободного водителя в каждую секунду времени, но делаем всё возможное для быстрого распределения заявок.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="2.6s">Изменения условий</h2>
							<p class="wow fadeInUp" data-wow-delay="2.8s">
								Мы можем обновлять данные условия обслуживания. Актуальная версия всегда доступна на этой странице.
								Если у вас возникли вопросы, свяжитесь с нами на странице
								<a href={getCityUrl("/contacts", city.slug)}>контактов</a>.
							</p>
						</div>
						<!-- Post Entry End -->
					</div>
					<!-- Post Single Content End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Single Post End -->

	<Footer city={city} />
</Layout>

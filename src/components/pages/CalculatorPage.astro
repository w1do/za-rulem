---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/shared/header/Header.astro';
import Footer from '../../components/shared/footer/Footer.astro';
import PageHeader from '../../components/shared/PageHeader.astro';
import FuelDeliveryCalculator from '../../components/calculators/FuelDeliveryCalculator';
import HomeHowItWork from '../../components/home/HomeHowItWork.astro';
import HubFaqs from '../../components/hub/HubFaqs.astro';
import AboutCta from '../../components/about/AboutCta.astro';
import { breadcrumbNode, faqNode, webPageNode } from '../../lib/seo';
import type { ChatCity } from '../../lib/cities';
import { replaceCityPlaceholders, getCityUrl } from '../../lib/cities';
import { MIN_TOTAL_PRICE, DEPARTURE_PRICE_PER_KM, MIN_FUEL_LITERS } from '../../data/prices';

export interface Props {
	city: ChatCity;
}

const { city } = Astro.props;

const title = replaceCityPlaceholders('Расчет доставки топлива {inCity} | Цена подвоза топлива', city);
const description = replaceCityPlaceholders(`Рассчитайте цену доставки бензина {inCity}: минимальный выезд от ${MIN_TOTAL_PRICE.toLocaleString('ru-RU')} ₽ (включая ${MIN_FUEL_LITERS} л), скидка 10% от 60 л. Посмотрите предварительную стоимость и оставьте заявку.`, city);
const url = getCityUrl('/calculator', city.slug);

const faqs = [
	{
		question: 'Что входит в расчет доставки топлива?',
		answer: `Калькулятор складывает минимальную стоимость выезда от ${MIN_TOTAL_PRICE.toLocaleString('ru-RU')} ₽ (в неё уже входит ${MIN_FUEL_LITERS} литров бензина) и выезд за город по ${DEPARTURE_PRICE_PER_KM} ₽ за километр. Если топлива нужно больше ${MIN_FUEL_LITERS} литров, они оплачиваются отдельно.`,
	},
	{
		question: 'Какой объём бензина можно рассчитать?',
		answer: 'В калькуляторе можно выбрать от 1 до 100 литров АИ-92 или АИ-95. При заказе от 60 литров автоматически применяется скидка 10% на весь чек.',
	},
	{
		question: 'Почему итоговая цена может измениться?',
		answer: 'На окончательную сумму влияет адрес подачи. Поэтому расчёт на странице служит ориентиром, а точную цену я называю и фиксирую до выезда.',
	},
	{
		question: 'Как заказать подвоз после расчета?',
		answer: 'После выбора топлива и объёма нужно нажать кнопку заказа. В заявку автоматически попадут параметры расчёта, останется указать контакты и место подачи.',
	},
];

const jsonLd = [
	webPageNode({ name: title, description, url }),
	breadcrumbNode([
		{ name: 'Главная', url: getCityUrl('/', city.slug) },
		{ name: 'Калькулятор доставки топлива', url },
	]),
	faqNode(faqs),
].filter(Boolean);
---

<Layout title={title} description={description} keywords="расчет доставки топлива, цена подвоза топлива, калькулятор доставки бензина" jsonLd={jsonLd} city={city}>
	<Header city={city} />

	<PageHeader
		title="Расчет доставки топлива"
		items={[{ label: 'главная', href: getCityUrl('/', city.slug) }, { label: 'калькулятор доставки топлива' }]}
	/>

	<main>
		<section class="calculator-intro">
			<div class="container">
				<div class="calculator-intro__content section-title wow fadeInUp">
					<span class="section-sub-title wow fadeInUp">Цена до оформления заявки</span>
					<h2>Стоимость подвоза бензина</h2>
					<p>{replaceCityPlaceholders(`Я сделал расчёт прозрачным: минимальная стоимость выезда от ${MIN_TOTAL_PRICE.toLocaleString('ru-RU')} ₽. В неё уже включено ${MIN_FUEL_LITERS} литров бензина. От 60 литров действует скидка 10% на общую сумму. Выезд за город показан отдельно, а выбранные марка и объём сохранятся в заявке.`, city)}</p>
					<ul>
						<li>АИ-92, АИ-95 или дизель</li>
						<li>Выезд от {MIN_TOTAL_PRICE.toLocaleString('ru-RU')} ₽ (включает {MIN_FUEL_LITERS} л)</li>
						<li>Скидка 10% при заказе от 60 л</li>
						<li>Сверх {MIN_FUEL_LITERS} литров — оплата по чеку АЗС</li>
						<li>До 100 литров</li>
						<li>Разбивка суммы до заказа</li>
					</ul>
				</div>

				<FuelDeliveryCalculator client:visible />
			</div>
		</section>

		<HomeHowItWork
			city={city}
			subtitle="Как заказать"
			title="От расчета до доставки — три шага"
			steps={[
				{ icon: '/images/icon-how-it-work-1-gold.svg', number: '01', title: 'Выбираю топливо', text: 'Указываю марку бензина и объём.' },
				{ icon: '/images/icon-how-it-work-2-gold.svg', number: '02', title: 'Проверяю расчет', text: 'Сразу вижу топливо, выезд и предварительную итоговую цену.' },
				{ icon: '/images/icon-how-it-work-3-gold.svg', number: '03', title: 'Оставляю заявку', text: 'Передаю адрес, после чего я подтверждаю и фиксирую сумму.' },
			]}
			footerList={[`Выезд от ${MIN_TOTAL_PRICE.toLocaleString('ru-RU')} ₽ (с ${MIN_FUEL_LITERS} л)`, 'Скидка 10% от 60 л', 'До 100 литров', replaceCityPlaceholders('Выезд {byCity}', city)]}
			footerText="Нужен бензин на дороге?"
			footerLinkText="Рассчитать цену"
			footerLinkHref="#fuel-calculator-title"
		/>

		<HubFaqs
			subtitle="Частые вопросы"
			title="Вопросы о расчете и цене подвоза топлива"
			description="Я собрал ответы о составе расчёта, доступном объёме и оформлении заявки на доставку бензина."
			faqs={faqs}
		/>

		<section class="calculator-cta">
			<AboutCta city={city} />
		</section>
	</main>

	<Footer city={city} />
</Layout>

<style>
	.calculator-intro {
		padding: 120px 0;
	}

	.calculator-intro__content {
		max-width: 820px;
		margin: 0 auto 30px;
		text-align: center;
	}

	.calculator-intro__content h2 {
		margin: 20px 0;
		font-size: 46px;
	}

	.calculator-intro__content p {
		margin-bottom: 20px;
	}

	.calculator-intro__content ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.calculator-intro__content li {
		padding: 9px 14px;
		border-radius: 100px;
		background: var(--secondary-color);
		color: var(--primary-color);
		font-size: 14px;
		font-weight: 700;
	}

	.calculator-cta {
		padding: 120px 0;
	}

	.calculator-cta :global(.about-contact-box) {
		display: none;
	}

	@media (max-width: 767px) {
		.calculator-intro {
			padding: 60px 0;
		}

		.calculator-intro__content {
			text-align: left;
		}

		.calculator-intro__content h2 {
			font-size: 30px;
		}

		.calculator-intro__content ul {
			justify-content: flex-start;
		}

		.calculator-cta {
			padding: 60px 0;
		}
	}
</style>

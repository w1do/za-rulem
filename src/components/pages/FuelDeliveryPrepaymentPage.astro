---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/shared/header/Header.astro';
import Footer from '../../components/shared/footer/Footer.astro';
import PageHeaderHelpButton from '../../components/shared/PageHeaderHelpButton.astro';
import { breadcrumbNode, webPageNode } from '../../lib/seo';
import { getCityUrl, type ChatCity } from '../../lib/cities';

export interface Props {
	city: ChatCity;
}

const { city } = Astro.props;

const pageUrl = '/pochemu-neobhodima-predoplata';
const title = 'Почему необходима предоплата на доставку топлива | За рулём';
const description =
	'Объясняем, зачем нужна добровольная предоплата при высоком спросе и временном дефиците топлива, как ищем курьера и когда возвращаем остаток средств.';

const jsonLd = [
	webPageNode({
		type: 'WebPage',
		name: 'Почему необходима предоплата на доставку топлива',
		description,
		url: pageUrl,
	}),
	breadcrumbNode([
		{ name: 'Главная', url: '/' },
		{ name: 'Почему необходима предоплата', url: pageUrl },
	]),
];
---

<Layout
	title={title}
	description={description}
	ogTitle="Почему необходима предоплата на доставку топлива"
	ogDescription="Как предоплата помогает искать курьера при высоком спросе, чем отличаются очереди и что происходит, если исполнитель не найден за пять дней."
	keywords="предоплата на доставку топлива, доставка бензина при дефиците, поиск курьера, очередь на доставку бензина, возврат предоплаты"
	jsonLd={jsonLd}
	city={city}
>
	<Header city={city} />

	<!-- Page Header Section Start -->
	<div class="page-header parallaxie">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<!-- Page Header Box Start -->
					<div class="page-header-box">
						<h1 class="text-anime-style-3" data-cursor="-opaque">
							Почему необходима предоплата на доставку топлива
						</h1>
						<nav class="wow fadeInUp" aria-label="Навигация по странице">
							<div class="post-single-meta wow fadeInUp">
								<ol class="breadcrumb">
									<li><i class="fa-regular fa-circle-question"></i> Условия поиска курьера</li>
								</ol>
							</div>
						</nav>
						<PageHeaderHelpButton
							label="Оставить заявку на доставку"
							service="toplivo"
							subject="Доставка топлива — заявка"
							title="Заказать доставку топлива"
						/>
					</div>
					<!-- Page Header Box End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Header Section End -->

	<!-- Page Single Post Start -->
	<div class="page-single-post">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<!-- Post Single Content Start -->
					<div class="post-content">
						<!-- Post Entry Start -->
						<div class="post-entry">
							<p class="wow fadeInUp">
								Когда на отдельных АЗС временно заканчивается нужная марка топлива, вводятся
								ограничения на отпуск или резко растёт число обращений, свободного курьера
								может не оказаться рядом с автомобилем. В такой ситуации обычного размещения
								заявки иногда недостаточно: нужно расширять географию поиска, связываться с
								водителями из соседних районов и повторно проверять доступность бензина или
								дизельного топлива. Предоплата позволяет запустить такой приоритетный поиск,
								но не является обещанием немедленной доставки.
							</p>

							<p class="wow fadeInUp" data-wow-delay="0.2s">
								Za-Rulem работает как агрегатор: мы принимаем обращение, уточняем город,
								местоположение и параметры заказа, после чего ищем подходящего исполнителя.
								Мы не располагаем собственным постоянным штатом курьеров в каждом городе и не
								можем заранее гарантировать наличие свободного водителя. Поэтому клиент сам
								выбирает: остаться в общей очереди без предоплаты или оплатить приоритетный
								поиск на условиях, описанных ниже.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="0.4s">
								Почему при дефиците и высоком спросе поиск становится сложнее
							</h2>
							<p class="wow fadeInUp" data-wow-delay="0.6s">
								Под дефицитом мы понимаем не постоянную нехватку топлива по всей стране, а
								конкретную ситуацию в городе, районе или на маршруте. Например, на ближайшей
								АЗС может временно отсутствовать АИ-95, поставка дизельного топлива может
								задерживаться, а на доступных станциях могут образоваться очереди. В такие
								периоды одновременно увеличивается количество людей, которым нужен подвоз,
								а число водителей с подходящей тарой, автомобилем и возможностью выехать
								остаётся ограниченным.
							</p>

							<p class="wow fadeInUp" data-wow-delay="0.8s">
								На возможность доставки влияют марка и объём топлива, расстояние до клиента,
								дорожная обстановка, направление движения на трассе и наличие безопасной
								канистры у исполнителя. Курьер, который может привезти десять литров бензина
								в пределах города, не всегда готов ехать за десятки километров или доставлять
								дизельное топливо. Из-за этого поиск нельзя свести к одному звонку ближайшему
								водителю: заявку приходится сопоставлять с несколькими анкетами и районами.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="1s">
								На что направляется предоплата
							</h2>
							<p class="wow fadeInUp" data-wow-delay="1.2s">
								Предоплата запускает расширенный приоритетный поиск курьера. Мы можем
								повторно связаться с зарегистрированными водителями, проверить соседние
								районы, разместить информацию о заявке в доступных региональных каналах и
								привлечь новых исполнителей. В итоговой сумме учитывается организационная
								часть такой работы. Размер платежа показывается до перехода в платёжную форму,
								поэтому клиент может отказаться и остаться в общей очереди.
							</p>

							<ul class="wow fadeInUp" data-wow-delay="1.4s">
								<li>проверка анкет исполнителей в городе и соседних районах;</li>
								<li>повторные обращения к водителям с учётом марки и объёма топлива;</li>
								<li>размещение и продвижение заявки в доступных региональных каналах;</li>
								<li>уточнение маршрута, расстояния и возможности безопасной доставки;</li>
								<li>связь с клиентом при появлении подходящего исполнителя.</li>
							</ul>

							<blockquote class="wow fadeInUp" data-wow-delay="1.6s">
								<p>
									Предоплата означает приоритет поиска, а не покупку гарантированного приезда.
									Если свободный курьер не найден, услуга доставки не считается автоматически
									выполненной только из-за размещения заявки.
								</p>
							</blockquote>

							<h2 class="wow fadeInUp" data-wow-delay="1.8s">
								Чем общая очередь отличается от приоритетной
							</h2>
							<p class="wow fadeInUp" data-wow-delay="2s">
								В общей очереди заявка сохраняется без предоплаты. Если свободный курьер
								увидит подходящее обращение, он сможет связаться с клиентом и согласовать
								условия. Такая очередь подходит человеку, который готов ждать и не хочет
								оплачивать дополнительную организацию поиска. Позиция и срок ответа в общей
								очереди не гарантируются.
							</p>

							<p class="wow fadeInUp" data-wow-delay="2.2s">
								После успешной предоплаты заявка включается в приоритетный список, который в
								интерфейсе также может называться «белым списком». Это рабочее обозначение
								заявок, для которых поиск продолжается активнее и охватывает больше доступных
								каналов. Приоритет не отменяет объективные ограничения: нужного топлива может
								не быть поблизости, а подходящие водители могут оставаться занятыми.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="2.4s">
								Как проходит поиск в течение пяти дней
							</h2>
							<p class="wow fadeInUp" data-wow-delay="2.6s">
								Срок приоритетного поиска составляет до пяти календарных дней с момента
								успешной оплаты. Отсчёт начинается не при нажатии кнопки и не при создании
								платёжной ссылки, а после фактического подтверждения платежа. В заявке важно
								оставить действующий телефон, точный город, адрес или геолокацию, нужную марку
								топлива и примерный объём. Если данные изменились, клиенту следует сообщить об
								этом через страницу контактов, иначе найденный курьер может не подойти под
								новые условия.
							</p>

							<ol class="wow fadeInUp" data-wow-delay="2.8s">
								<li>Клиент описывает ситуацию и передаёт местоположение.</li>
								<li>Система проверяет доступных курьеров и показывает результат первичного поиска.</li>
								<li>Клиент добровольно выбирает общую либо приоритетную очередь.</li>
								<li>После успешной оплаты начинается расширенный поиск сроком до пяти дней.</li>
								<li>Если исполнитель найден, стороны согласуют объём, итоговую цену и время выезда.</li>
								<li>Если исполнитель не найден, запускается предусмотренная процедура возврата.</li>
							</ol>

							<h2 class="wow fadeInUp" data-wow-delay="3s">
								Что происходит, если курьер не найден
							</h2>
							<p class="wow fadeInUp" data-wow-delay="3.2s">
								Если за пять календарных дней подходящий исполнитель не найден, мы инициируем
								возврат остатка предоплаты не позднее окончания пятого дня. Из внесённой суммы
								могут быть вычтены только фактически понесённые и подтверждаемые расходы,
								непосредственно связанные с организацией приоритетного поиска по конкретной
								заявке. Произвольные штрафы за отсутствие курьера не начисляются.
							</p>

							<p class="wow fadeInUp" data-wow-delay="3.4s">
								Инициирование возврата и зачисление денег на счёт — разные этапы. После того
								как возврат передан платёжному провайдеру, фактический срок поступления зависит
								от банка и использованного способа оплаты. Для уточнения статуса понадобятся
								номер телефона из заявки, дата платежа и доступный идентификатор операции. Не
								следует отправлять через обычную форму полный номер карты, срок действия или
								защитный код.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="3.6s">
								Почему оплата остаётся добровольной
							</h2>
							<p class="wow fadeInUp" data-wow-delay="3.8s">
								Мы не требуем предоплату для самого факта обращения. После первичного поиска
								клиент может выбрать кнопку «Остаться в общей очереди» и продолжить ожидание
								без платежа. Переход к оплате происходит только после отдельного выбора
								приоритетной очереди, проверки текста заявки, местоположения и телефона. Если
								условия или сумма не подходят, платёж можно не завершать.
							</p>

							<p class="wow fadeInUp" data-wow-delay="4s">
								Перед оплатой полезно оценить срочность. Если автомобиль находится в опасном
								месте, мешает движению или существует угроза людям, ожидание курьера не заменяет
								обращение в экстренные службы. Если ситуация допускает ожидание, можно сначала
								проверить <a href="/drivers">каталог водителей</a>, посмотреть условия
								<a href={getCityUrl('/services/toplivo')}>доставки топлива</a> и уточнить наличие нужной
								марки в локальном чате.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="4.2s">
								Какие данные нужны для результативного поиска
							</h2>
							<p class="wow fadeInUp" data-wow-delay="4.4s">
								Даже приоритетную заявку невозможно корректно распределить без исходных
								данных. Укажите город, адрес или координаты, направление движения на трассе,
								марку топлива, объём, описание автомобиля и телефон. Эти сведения позволяют
								отсеять исполнителей, которые находятся слишком далеко, не перевозят нужное
								топливо или не располагают подходящей тарой. Порядок обработки информации
								описан в <a href="/privacy-policy">политике конфиденциальности</a>.
							</p>

							<p class="wow fadeInUp" data-wow-delay="4.6s">
								Карточные реквизиты вводятся на стороне платёжного провайдера. Za-Rulem не
								просит сообщать исполнителю или оператору код из SMS, защитный код карты или
								пароль от банковского приложения. Если кто-либо запрашивает такие сведения от
								имени сервиса, платёж следует остановить и сообщить об этом через официальные
								<a href="/contacts">контакты</a>.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="4.8s">
								Что проверить перед подтверждением
							</h2>
							<ul class="wow fadeInUp" data-wow-delay="5s">
								<li>правильно ли указаны город, адрес и телефон;</li>
								<li>совпадает ли выбранная марка топлива с требованиями автомобиля;</li>
								<li>понятны ли сумма предоплаты и назначение приоритетного поиска;</li>
								<li>готовы ли вы ожидать до пяти календарных дней;</li>
								<li>согласны ли вы с правилами расходов и возврата остатка;</li>
								<li>сохранены ли сведения, позволяющие идентифицировать платёж.</li>
							</ul>

							<p class="wow fadeInUp" data-wow-delay="5.2s">
								Полные правила закреплены в <a href="/terms">условиях обслуживания</a>. Если
								вы готовы выполнять такие заявки в своём регионе, заполните
								<a href="/partners">анкету курьера по доставке топлива</a>. Новые исполнители
								помогают сокращать расстояние поиска и увеличивают вероятность отклика, но
								каждая заявка всё равно оценивается отдельно по месту, времени и параметрам
								доставки.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="5.4s">
								Главное о предоплате
							</h2>
							<p class="wow fadeInUp" data-wow-delay="5.6s">
								Предоплата нужна не для искусственного ограничения заявок, а для организации
								расширенного поиска в периоды, когда спрос превышает число доступных курьеров.
								Она добровольна, переводит обращение в приоритетный список и даёт нам основание
								тратить ресурсы на поиск в разных районах. При этом клиент заранее знает срок,
								ограничения и порядок возврата, а выбор общей очереди остаётся доступным без
								оплаты.
							</p>
						</div>
						<!-- Post Entry End -->
					</div>
					<!-- Post Single Content End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Single Post End -->

	<Footer city={city} />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/shared/header/Header.astro';
import Footer from '../../components/shared/footer/Footer.astro';
import PageHeaderHelpButton from '../../components/shared/PageHeaderHelpButton.astro';
import { webPageNode, breadcrumbNode } from '../../lib/seo';
import type { ChatCity } from '../../data/cities';
import { replaceCityPlaceholders, getCityUrl } from '../../lib/city';

export interface Props {
	city: ChatCity;
}

const { city } = Astro.props;

const title = replaceCityPlaceholders("Политика конфиденциальности — техпомощь {inCity} | За рулём", city);
const description = replaceCityPlaceholders("Как наш сервис собирает, использует и защищает персональные данные при вызове автопомощи и техпомощи на дороге {inCity}. Ваши права и порядок обработки заявок.", city);

const jsonLd = [
	webPageNode({
		type: 'PrivacyPolicy',
		name: replaceCityPlaceholders('Политика конфиденциальности — маркетплейс техпомощи «За рулём» {inCity}', city),
		description: replaceCityPlaceholders('Как мы обрабатываем и защищаем персональные данные пользователей при вызове автопомощи и мониторинге цен на топливо {inCity}.', city),
		url: getCityUrl('/privacy-policy', city.slug),
	}),
	breadcrumbNode([
		{ name: 'Главная', url: getCityUrl('/', city.slug) },
		{ name: 'Политика конфиденциальности', url: getCityUrl('/privacy-policy', city.slug) },
	]),
];
---

<Layout
	title={title}
	description={description}
	ogTitle={replaceCityPlaceholders("Политика конфиденциальности сервиса «За рулём» {inCity}", city)}
	ogDescription={replaceCityPlaceholders("Обработка и защита персональных данных при обращении за техпомощью на дороге {inCity}.", city)}
	keywords={replaceCityPlaceholders("политика конфиденциальности, обработка персональных данных, защита данных, техпомощь {city}", city)}
	jsonLd={jsonLd}
    city={city}
>
	<Header city={city} />

	<!-- Page Header Section Start -->
	<div class="page-header parallaxie">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<!-- Page Header Box Start -->
					<div class="page-header-box">
						<h1 class="text-anime-style-3" data-cursor="-opaque">Политика конфиденциальности</h1>
						<nav class="wow fadeInUp">
							<div class="post-single-meta wow fadeInUp">
								<ol class="breadcrumb">
									<li><i class="fa-regular fa-clock"></i> Обновлено 30 июля 2026</li>
								</ol>
							</div>
						</nav>
						<PageHeaderHelpButton />
					</div>
					<!-- Page Header Box End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Header Section End -->

	<!-- Page Single Post Start -->
	<div class="page-single-post">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<!-- Post Single Content Start -->
					<div class="post-content">
						<!-- Post Entry Start -->
						<div class="post-entry">
							<p class="wow fadeInUp">
								Мы заботимся о конфиденциальности каждого, кто обращается за помощью на дороге или пользуется нашими сервисами.
								Наш сервис — это маркетплейс помощи ближайших водителей по разным городам, а также площадка для мониторинга цен на топливо.
								Эта политика объясняет, какие персональные данные мы получаем через сайт za-rulem.org, зачем они нужны и как мы их защищаем.
								Оставляя заявку на сайте или вступая в локальные чаты, пользователь соглашается с описанным ниже порядком обработки данных.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="0.2s">Какие данные мы собираем</h2>
							<p class="wow fadeInUp" data-wow-delay="0.4s">
								Мы собираем только те данные, которые необходимы для входа в локальные чаты городов и для выезда водителей на помощь по заявкам.
							</p>
							<ul class="wow fadeInUp" data-wow-delay="0.6s">
								<li>Данные для входа в чат — чтобы обеспечить доступ к локальному сообществу водителей {city.inCity}.</li>
								<li>Контактные данные и номер телефона — чтобы водитель мог связаться с вами для оказания помощи.</li>
								<li>Точная геолокация — передается только при добровольном нажатии кнопки отправки местоположения для выезда на заявку.</li>
								<li>Сведения об автомобиле и характере поломки — марка авто, госномер и описание проблемы, чтобы ближайший водитель мог подготовиться к выезду.</li>
							</ul>

							<h2 class="wow fadeInUp" data-wow-delay="0.8s">Как мы используем данные</h2>
							<p class="wow fadeInUp" data-wow-delay="1s">
								Полученные данные используются исключительно для организации оперативной помощи на дороге: поиска ближайшего свободного водителя, построения маршрута и связи.
								Также мы помогаем отслеживать актуальные цены на топливо в разных городах, используя агрегированную информацию.
								Мы не используем ваши личные контакты для рекламных рассылок и не передаем их сторонним компаниям для маркетинга.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="1.2s">Передача данных третьим лицам</h2>
							<p class="wow fadeInUp" data-wow-delay="1.4s">
								В рамках модели маркетплейса ваши данные (номер телефона, локация, описание проблемы) передаются ближайшему водителю, который принял вашу заявку к исполнению.
								Мы не продаем персональные данные. Исключение составляют случаи, когда передача данных обязательна по закону.
							</p>

							<blockquote class="wow fadeInUp" data-wow-delay="1.6s">
								<p>
									Мы собираем минимально необходимый набор данных для входа в чат и организации выезда на помощь.
									Ваша геолокация становится доступна только в момент активного запроса помощи.
								</p>
							</blockquote>

							<h2 class="wow fadeInUp" data-wow-delay="1.8s">Как мы храним и защищаем информацию</h2>
							<p class="wow fadeInUp" data-wow-delay="2s">
								Заявки поступают в систему маркетплейса и хранятся до момента завершения оказания помощи.
								Мы принимаем технические и организационные меры для защиты данных от несанкционированного доступа и удаляем сведения, когда цель их сбора достигнута.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="2.2s">Локальные чаты и мониторинг цен</h2>
							<p class="wow fadeInUp" data-wow-delay="2.4s">
								Для удобства водителей мы создали локальные чаты по каждому городу. Данные для входа в эти чаты используются только для идентификации пользователя в сообществе.
								Сервис мониторинга цен на топливо работает с открытыми данными и помогает водителям {city.inCity} находить выгодные предложения.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="2.6s">Ваши права</h2>
							<p class="wow fadeInUp" data-wow-delay="2.8s">
								Вы имеете право запросить информацию о своих данных, хранящихся у нас, потребовать их исправления или удаления.
								Для этого свяжитесь с нами через страницу контактов.
							</p>

							<h2 class="wow fadeInUp" data-wow-delay="3s">Изменения политики</h2>
							<p class="wow fadeInUp" data-wow-delay="3.2s">
								Мы можем обновлять эту политику. Актуальная версия всегда доступна на этой странице.
								По любым вопросам пишите нам через форму на странице <a href={getCityUrl("/contacts", city.slug)}>контактов</a>.
							</p>
						</div>
						<!-- Post Entry End -->
					</div>
					<!-- Post Single Content End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Single Post End -->

	<Footer city={city} />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/shared/header/Header.astro';
import Footer from '../../components/shared/footer/Footer.astro';

import AboutPageHeader from '../../components/about/AboutPageHeader.astro';
import AboutIntro from '../../components/about/AboutIntro.astro';
import AboutApproach from '../../components/about/AboutApproach.astro';
import AboutWhyChoose from '../../components/about/AboutWhyChoose.astro';
import AboutWhatWeDo from '../../components/about/AboutWhatWeDo.astro';
import AboutCta from '../../components/about/AboutCta.astro';
import AboutExpertise from '../../components/about/AboutExpertise.astro';
import AboutFaqs from '../../components/about/AboutFaqs.astro';
import AboutTestimonials from '../../components/about/AboutTestimonials.astro';
import HomeDrivers from "../../components/home/HomeDrivers.astro";

import { webPageNode, breadcrumbNode } from '../../lib/seo';

const title = 'О сервисе «За рулём» — помощь водителям в регионах России';
const description = 'Как работает сервис «За рулём»: заявки на дорожную помощь, поиск доступных исполнителей, локальные чаты, цены на топливо и поддержка водителей в регионах России.';

const jsonLd = [
	webPageNode({
		type: 'AboutPage',
		name: 'О сервисе «За рулём»',
		description: description,
		url: '/about',
	}),
	breadcrumbNode([
		{ name: 'Главная', url: '/' },
		{ name: 'О сервисе', url: '/about' },
	]),
];
---

<Layout
	title={title}
	description={description}
	ogTitle="«За рулём» — о сервисе помощи водителям"
	ogDescription="Заявки на дорожную помощь, локальные сервисы, поиск доступных исполнителей и информация о топливе в регионах России."
	keywords="о сервисе За рулём, помощь водителям, техпомощь на дороге, доставка топлива, локальные чаты водителей"
	jsonLd={jsonLd}
	isNational={true}
>
	<Header isNational={true} />

	<AboutPageHeader />
	<AboutIntro />
	<AboutApproach />
	<AboutWhyChoose />
	<AboutWhatWeDo />
	<HomeDrivers />
	<AboutCta isGlobal={true} />
	<AboutExpertise />
	<AboutFaqs />
	<AboutTestimonials />

	<Footer isNational={true} nationalVariant="system" />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/shared/header/Header.astro';
import Footer from '../../components/shared/footer/Footer.astro';
import PageHeaderHelpButton from '../../components/shared/PageHeaderHelpButton.astro';
import ContactForm from '../../components/forms/ContactForm.tsx';

import { webPageNode, breadcrumbNode } from '../../lib/seo';
import type { ChatCity } from '../../lib/cities';
import { replaceCityPlaceholders, getCityUrl } from '../../lib/cities';

export interface Props {
	city: ChatCity;
}

const { city } = Astro.props;

const title = replaceCityPlaceholders("Контакты — техпомощь на дороге {inCity} | За рулём", city);
const description = replaceCityPlaceholders("Свяжитесь со мной для вызова техпомощи {inCity} и области: выезд только по заявке, круглосуточно. Оставьте заявку — перезвоню в течение пары минут.", city);

const jsonLd = [
	webPageNode({
		type: 'ContactPage',
		name: replaceCityPlaceholders('Контакты — вызов автопомощи и техпомощи {inCity}', city),
		description: description,
		url: getCityUrl('/contacts', city.slug),
	}),
	breadcrumbNode([
		{ name: 'Главная', url: getCityUrl('/', city.slug) },
		{ name: 'Контакты', url: getCityUrl('/contacts', city.slug) },
	]),
];
---

<Layout
	title={title}
	description={description}
	keywords={replaceCityPlaceholders("контакты техпомощь {city}, вызвать автопомощь {city}, телефон техпомощь на дороге", city)}
	jsonLd={jsonLd}
    city={city}
>
	<Header city={city} />

	<!-- Page Header Section Start -->
	<div class="page-header parallaxie">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<!-- Page Header Box Start -->
					<div class="page-header-box">
						<h1 class="text-anime-style-3" data-cursor="-opaque">Контакты</h1>
						<nav class="wow fadeInUp">
							<ol class="breadcrumb">
								<li class="breadcrumb-item"><a href={getCityUrl('/', city.slug)}>главная</a></li>
								<li class="breadcrumb-item active" aria-current="page">Контакты</li>
							</ol>
						</nav>
						<PageHeaderHelpButton />
					</div>
					<!-- Page Header Box End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Header Section End -->

	<!-- Page Contact Us Start -->
	<div class="page-contact-us">
		<div class="container">
			<div class="row">
				<div class="col-xl-6">
					<!-- Contact Us Image Box Start -->
					<div class="contact-us-image-box">
						<!-- Contact us Image Start -->
						<div class="contact-us-image">
							<figure class="image-anime reveal">
								<img src="/images/contact-us-image.jpg" alt={replaceCityPlaceholders("Техпомощь на дороге {inCity}", city)} />
							</figure>
						</div>
						<!-- Contact us Image End -->

						<!-- Contact Info Content Box Start -->
						<div class="contact-info-content-box">
							<!-- Contact Info Title Start -->
							<div class="contact-info-title wow fadeInUp">
								<h2>Как со мной связаться:</h2>
							</div>
							<!-- Contact Info Title End -->

							<!-- Contact Info List Start -->
							<div class="contact-info-list wow fadeInUp" data-wow-delay="0.2s">
								<!-- Contact Info Item Start -->
								<div class="contact-info-item">
									<div class="icon-box">
										<img src="/images/icon-phone-primary.svg" alt="Заявка" />
									</div>
									<div class="contact-info-item-content">
										<p>Выезд только по заявке:</p>
										<h3><a href={getCityUrl("/contacts", city.slug)} data-service-request data-service-title="Вызвать помощь">Оставить заявку 24/7</a></h3>
									</div>
								</div>
								<!-- Contact Info Item End -->

								<!-- Contact Info Item Start -->
								<div class="contact-info-item">
									<div class="icon-box">
										<img src="/images/icon-mail-primary.svg" alt="Зона выезда" />
									</div>
									<div class="contact-info-item-content">
										<p>Зона выезда:</p>
										<h3>{replaceCityPlaceholders("{city} и область", city)}</h3>
									</div>
								</div>
								<!-- Contact Info Item End -->
							</div>
							<!-- Contact Info List End -->
						</div>
						<!-- Contact Info Content Box End -->
					</div>
					<!-- Contact Us Image Box End -->
				</div>

				<div class="col-xl-6">
					<!-- Contact Us Form Start -->
					<div class="contact-us-form">
						<!-- Section Title Start -->
						<div class="section-title">
							<span class="section-sub-title wow fadeInUp">
								<span data-contact-default>Оставить заявку</span>
								<span data-contact-courier hidden>Анкета водителя</span>
							</span>
							<h2 class="text-anime-style-3" data-cursor="-opaque">
								<span data-contact-default>Свяжитесь со мной</span>
								<span data-contact-courier hidden>Стать курьером по доставке топлива</span>
							</h2>
							<p class="wow fadeInUp" data-wow-delay="0.2s">
								<span data-contact-default>
									{replaceCityPlaceholders("Опишите ситуацию на дороге и оставьте номер — я перезвоню в течение пары минут и выеду к вам {inCity} или области. Работаю круглосуточно.", city)}
								</span>
								<span data-contact-courier hidden>
									Укажите город, автомобиль и сколько времени ежедневно готовы уделять доставке
									топлива. Оставьте номер телефона для связи.
								</span>
							</p>
						</div>
						<!-- Section Title End -->

						<!-- Contact Form Start -->
						<div class="contact-form wow fadeInUp" data-wow-delay="0.4s">
							<ContactForm
								client:visible
								subject={replaceCityPlaceholders('Заявка со страницы контактов {city}', city)}
								courierSubject={replaceCityPlaceholders('Анкета курьера по доставке топлива — {city}', city)}
							/>
						</div>
						<!-- Contact Form End -->
					</div>
					<!-- Contact Us Form End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Contact Us End -->

	<script>
		const isFuelCourierApplication =
			new URLSearchParams(window.location.search).get('intent') === 'fuel-courier';

		if (isFuelCourierApplication) {
			document.querySelectorAll<HTMLElement>('[data-contact-default]').forEach((element) => {
				element.hidden = true;
			});
			document.querySelectorAll<HTMLElement>('[data-contact-courier]').forEach((element) => {
				element.hidden = false;
			});
		}
	</script>

	<!-- Google Map Start -->
	<div class="google-map">
		<div class="container">
			<div class="row section-row">
				<div class="col-lg-12">
					<!-- Section Title Start -->
					<div class="section-title section-title-center">
						<span class="section-sub-title wow fadeInUp">Зона выезда</span>
						<h2 class="text-anime-style-3" data-cursor="-opaque">{replaceCityPlaceholders("Работаю {byCity} и области", city)}</h2>
						<p class="wow fadeInUp" data-wow-delay="0.2s">
							{replaceCityPlaceholders("Выезжаю в любой район {ofCity} и по области. Оставьте заявку — доеду до вас, где бы вы ни остановились.", city)}
						</p>
					</div>
					<!-- Section Title End -->
				</div>
			</div>

			<div class="row">
				<div class="col-lg-12">
					<!-- Google Map Start -->
					<div class="google-map-iframe wow fadeInUp" data-wow-delay="0.4s">
						<iframe
							src={`https://www.google.com/maps?q=${encodeURIComponent(city.name)}&output=embed`}
							allowfullscreen=""
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"></iframe>
					</div>
					<!-- Google Map End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Google Map End -->

	<Footer city={city} />
</Layout>

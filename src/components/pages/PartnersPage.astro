---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/shared/header/Header.astro';
import Footer from '../../components/shared/footer/Footer.astro';
import HomeHero from '../../components/home/HomeHero.astro';
import HomeAbout from '../../components/home/HomeAbout.astro';
import HomeServices from '../../components/home/HomeServices.astro';
import HomeWhyChoose from '../../components/home/HomeWhyChoose.astro';
import HomeFleets from '../../components/home/HomeFleets.astro';
import HomeDrivers from '../../components/home/HomeDrivers.astro';
import HomeHowItWork from '../../components/home/HomeHowItWork.astro';
import HubFaqs from '../../components/hub/HubFaqs.astro';
import PartnersOtherCities from '../../components/partners/PartnersOtherCities.astro';
import { breadcrumbNode, faqNode, webPageNode } from '../../lib/seo';
import type { ChatCity } from '../../lib/cities';
import { getCityUrl, replaceCityPlaceholders } from '../../lib/cities';

export interface Props {
	city: ChatCity;
}

const { city } = Astro.props;
const partnersUrl = getCityUrl('/partners', city.slug);
const contactsUrl = getCityUrl('/contacts', city.slug);
const partnerService = 'partner-fuel-courier';
const partnerTitle = replaceCityPlaceholders('Анкета курьера по доставке топлива {inCity}', city);
const partnerSubject = replaceCityPlaceholders('Анкета курьера по доставке топлива — {city}', city);

const title = replaceCityPlaceholders('Курьер по доставке топлива {inCity} — заявки Za-Rulem', city);
const description = replaceCityPlaceholders(
	'Ищем водителей на своём авто для доставки АИ-92, АИ-95, АИ-100 и ДТ {inCity}. Оставьте анкету для получения подходящих заявок на дороге.',
	city,
);

const services = [
	{
		icon: '/images/icon-service-1.svg',
		title: 'Доставлять топливо водителям',
		text: replaceCityPlaceholders(
			'Получить заявку, уточнить АИ-92, АИ-95, АИ-100 или ДТ, купить согласованный объём на АЗС и привезти его к автомобилю {inCity}.',
			city,
		),
		href: contactsUrl,
		linkText: 'Оставить анкету',
	},
	{
		icon: '/images/icon-service-2.svg',
		title: 'Принимать заявки в своём районе',
		text: replaceCityPlaceholders(
			'В анкете указываются районы {ofCity}, радиус за городом и время готовности. Можно оценить адрес и отказаться от неподходящей заявки до подтверждения.',
			city,
		),
		href: contactsUrl,
		linkText: 'Указать район',
	},
	{
		icon: '/images/icon-service-3.svg',
		title: 'Оказывать автотехпомощь',
		text: 'Если есть бустер, инструмент и опыт, дополнительно укажите запуск двигателя, замену колеса и другую помощь, которую можете безопасно выполнить на месте.',
		href: contactsUrl,
		linkText: 'Указать навыки',
	},
];

const benefits = [
	{
		icon: '/images/icon-hero-info-list-1-gold.svg',
		title: '01. Свой автомобиль',
		text: 'Нужны водительские права, исправный автомобиль, телефон и возможность безопасно перевозить согласованный объём топлива.',
	},
	{
		icon: '/images/icon-hero-info-list-2-gold.svg',
		title: '02. Своя география',
		text: replaceCityPlaceholders(
			'Вы сами указываете районы {ofCity}, допустимое расстояние за городом и время, когда готовы рассматривать заявки.',
			city,
		),
	},
	{
		icon: '/images/icon-hero-info-list-3-gold.svg',
		title: '03. Подходящие заявки',
		text: 'Za-Rulem сопоставляет местоположение и параметры заявки с анкетами курьеров, но не гарантирует количество или регулярность заказов.',
	},
];

const steps = [
	{
		icon: '/images/icon-how-it-work-1-gold.svg',
		number: '01',
		title: 'Оставьте анкету',
		text: 'Назовите город, автомобиль, доступные марки топлива, районы, время готовности и номер телефона.',
	},
	{
		icon: '/images/icon-how-it-work-2-gold.svg',
		number: '02',
		title: 'Дождитесь подходящей заявки',
		text: 'Агрегатор сопоставит ваше местоположение и возможности с обращением автомобилиста. Наличие заявки заранее не гарантируется.',
	},
	{
		icon: '/images/icon-how-it-work-3-gold.svg',
		number: '03',
		title: 'Подтвердите условия',
		text: 'До выезда уточните топливо, объём, адрес, расстояние, срок и расчёт. Выезжайте только после согласования с заказчиком.',
	},
];

const faqs = [
	{
		question: replaceCityPlaceholders('Как стать курьером по доставке топлива {inCity}?', city),
		answer:
			'Оставьте голосовую анкету и назовите город, автомобиль, районы выезда, доступные марки топлива и время готовности. После проверки данных анкета может участвовать в подборе под локальные заявки.',
	},
	{
		question: 'Какие марки топлива нужно доставлять?',
		answer:
			'Основные направления — бензин АИ-92, АИ-95, АИ-100 и дизельное топливо. Перед каждым выездом нужно отдельно подтвердить марку и объём, чтобы исключить ошибку при покупке.',
	},
	{
		question: 'Гарантирует ли Za-Rulem постоянную работу и доход?',
		answer:
			'Нет. Za-Rulem — агрегатор поиска курьеров, а не работодатель. Количество обращений зависит от города, времени, спроса и совпадения параметров заявки с вашей анкетой.',
	},
	{
		question: 'Можно ли принимать только заявки рядом с собой?',
		answer: replaceCityPlaceholders(
			'Да. Укажите районы {ofCity} и максимальный радиус выезда. До подтверждения можно оценить расстояние и не принимать заявку, которая находится вне вашей географии.',
			city,
		),
	},
	{
		question: 'Можно ли дополнительно оказывать автотехпомощь?',
		answer:
			'Да, если у вас есть опыт и безопасное оборудование. В анкете можно указать запуск двигателя, замену колеса и другие доступные работы. Не отмечайте услуги, которые не можете выполнить самостоятельно.',
	},
	{
		question: 'Кто согласовывает стоимость и время выезда?',
		answer:
			'Курьер и заказчик подтверждают условия до выезда. Страница не обещает фиксированную оплату, комиссию или количество заявок: актуальные условия зависят от конкретного обращения.',
	},
];

const jsonLd = [
	webPageNode({
		name: replaceCityPlaceholders('Поиск курьеров по доставке топлива {inCity}', city),
		description,
		url: partnersUrl,
	}),
	breadcrumbNode([
		{ name: 'Главная', url: getCityUrl('/', city.slug) },
		{ name: 'Курьерам', url: partnersUrl },
	]),
	faqNode(faqs),
].filter((node): node is Record<string, unknown> => node !== null);
---

<Layout
	title={title}
	description={description}
	ogTitle={replaceCityPlaceholders('Заявки курьерам по доставке топлива {inCity}', city)}
	ogDescription="Оставьте анкету водителя на своём авто для доставки АИ-92, АИ-95, АИ-100, ДТ и дополнительной автотехпомощи."
	keywords={replaceCityPlaceholders(
		'курьер по доставке топлива {city}, работа курьером на своем авто {city}, доставка бензина работа, водитель курьер {city}, заявки автопомощь на дороге, доставка АИ-92 АИ-95 АИ-100 ДТ',
		city,
	)}
	jsonLd={jsonLd}
	city={city}
	robots={city.isIndexable ? undefined : 'noindex, follow'}
>
	<Header city={city} />

	<div
		data-selection-voice-request
		data-request-service={partnerService}
		data-request-subject={partnerSubject}
		data-request-title={partnerTitle}
		data-request-city={city.name}
	>
		<HomeHero
			city={city}
			subtitle={replaceCityPlaceholders('Заявки для водителей на своём авто {inCity}', city)}
			title={replaceCityPlaceholders(
				'Ищем курьеров для доставки АИ-92, АИ-95, АИ-100 и ДТ {inCity}',
				city,
			)}
			description={replaceCityPlaceholders(
				'Оставьте анкету, если готовы покупать согласованный объём топлива на АЗС и доставлять его к автомобилю {inCity}. Za-Rulem сопоставляет заявки с курьерами по местоположению и возможностям, но не гарантирует постоянный поток заказов.',
				city,
			)}
			ctaText="Оставить анкету курьера"
			ctaHref={contactsUrl}
			secondaryCtaText="Какие заявки бывают"
			secondaryCtaHref={getCityUrl('/services/toplivo', city.slug)}
			reviewText={replaceCityPlaceholders('Локальный подбор заявок {inCity}', city)}
			counterValue="4"
			counterText="Четыре направления топлива: АИ-92, АИ-95, АИ-100 и дизельное топливо."
			benefits={benefits}
			showClientImages={false}
		/>

		<HomeAbout
			city={city}
			subtitle="Работа и подработка на своём авто"
			title={replaceCityPlaceholders('Кому подходит доставка топлива {inCity}', city)}
			taskTitle="Что делает курьер"
			taskText="Уточняет марку и объём, подтверждает адрес, покупает топливо на согласованной АЗС, сохраняет чек и доставляет заказ к автомобилю без самовольной замены топлива."
			principleTitle="Как работает Za-Rulem"
			principleText="Сервис выступает агрегатором: принимает обращение автомобилиста и ищет курьера по местоположению, району выезда и возможностям анкеты. Если совпадение найдено, стороны связываются и согласуют условия."
			counters={[
				{ value: '4', suffix: '', label: 'Вида топлива' },
				{ value: '1', suffix: '', label: 'Город в анкете' },
				{ value: '0', suffix: '', label: 'Гарантий по числу заявок' },
				{ value: '100', suffix: '%', label: 'Условий согласуются до выезда' },
			]}
			footerText="Есть исправный автомобиль и готовность принимать локальные заявки —"
			footerLinkText="оставить анкету"
			footerLinkHref={contactsUrl}
		/>

		<HomeServices
			city={city}
			subtitle="Формат заявок"
			title="Что может делать курьер Za-Rulem"
			services={services}
			footerText="Указывайте только те районы и виды помощи, которые действительно доступны —"
			footerLinkText="заполнить анкету"
			footerLinkHref={contactsUrl}
			rating="4"
			ratingText="Марки топлива для доставки"
		/>

		<HomeFleets
			city={city}
			subtitle="Доставка топлива"
			title="Заявки на АИ-92, АИ-95, АИ-100 и дизель"
			slides={[
				{
					image: '/images/fleets-image-1.jpg',
					label: 'Бензин Regular',
					price: 'АИ-92',
					priceUnit: '',
					amenities: ['Марка и объём в заявке', 'Чек с АЗС'],
					href: contactsUrl,
				},
				{
					image: '/images/fleets-image-2.jpg',
					label: 'Бензин Premium',
					price: 'АИ-95',
					priceUnit: '',
					amenities: ['Без замены марки', 'Адрес до выезда'],
					href: contactsUrl,
				},
				{
					image: '/images/fleets-image-3.jpg',
					label: 'Высокооктановый бензин',
					price: 'АИ-100',
					priceUnit: '',
					amenities: ['По запросу водителя', 'Согласованная АЗС'],
					href: contactsUrl,
				},
				{
					image: '/images/fleets-image-4.jpg',
					label: 'Дизельное топливо',
					price: 'ДТ',
					priceUnit: '',
					amenities: ['Сезонность уточняется', 'Объём подтверждается'],
					href: contactsUrl,
				},
			]}
			footerText="Готовы доставлять одну или несколько марок топлива —"
			footerLinkText="указать в анкете"
			footerLinkHref={contactsUrl}
		/>

		<HomeWhyChoose
			city={city}
			subtitle="Требования к курьеру"
			title="Что нужно указать до получения заявки"
			description={replaceCityPlaceholders(
				'Для подбора заявки нужны город, районы {ofCity}, данные автомобиля, доступные марки топлива, допустимый радиус и время готовности. Чем точнее анкета, тем меньше неподходящих обращений.',
				city,
			)}
			items={[
				{
					icon: '/images/icon-why-choose-body-1-gold.svg',
					title: 'Исправный автомобиль и связь',
					text: 'Курьер самостоятельно отвечает за законность управления автомобилем, его исправность, связь и соблюдение правил безопасной перевозки.',
				},
				{
					icon: '/images/icon-why-choose-body-2-gold.svg',
					title: 'Точные условия до выезда',
					text: 'Марка, объём, АЗС, адрес, расстояние, срок и расчёт подтверждаются с заказчиком до покупки топлива и начала маршрута.',
				},
			]}
			ctaText="Заполнить анкету"
			ctaHref={contactsUrl}
			authorName="Za-Rulem.org"
			authorText="Агрегатор поиска курьеров"
		/>

		<HomeDrivers
			subtitle="Дополнительная автотехпомощь"
			title="Какие навыки можно добавить к анкете курьера"
			drivers={[
				{
					image: '/images/driver/ekip-1.jpg',
					title: 'Курьер по топливу',
					text: 'Доставляет согласованные АИ-92, АИ-95, АИ-100 или ДТ к автомобилю в отмеченных районах.',
					href: contactsUrl,
				},
				{
					image: '/images/driver/ekip-2.jpg',
					title: 'Водитель с бустером',
					text: 'Помимо топлива может принять заявку на запуск двигателя, если умеет безопасно работать с пусковым устройством.',
					href: contactsUrl,
				},
				{
					image: '/images/driver/ekip-3.jpg',
					title: 'Специалист автопомощи',
					text: 'Указывает замену колеса или другие дорожные работы только при наличии опыта, инструмента и подходящего оснащения.',
					href: contactsUrl,
				},
			]}
			footerText="Есть дополнительные навыки и оборудование —"
			footerLinkText="добавить в анкету"
			footerLinkHref={contactsUrl}
		/>

		<HomeHowItWork
			city={city}
			subtitle="Подключение курьера"
			title="Как начать получать подходящие заявки в своём городе"
			steps={steps}
			footerList={[
				'Город и районы',
				'Автомобиль и телефон',
				'Марки топлива',
				'Время готовности',
			]}
			footerText="Za-Rulem передаёт контакт только при подходящем обращении; постоянная занятость и число заявок не гарантируются."
			footerLinkText="Оставить анкету курьера"
			footerLinkHref={contactsUrl}
		/>

		<HubFaqs
			subtitle="Вопросы курьеров"
			title={replaceCityPlaceholders('FAQ о доставке топлива {inCity}', city)}
			description="Условия конкретной заявки согласуются до выезда. Ниже — ответы о роли агрегатора, географии и доступных направлениях."
			faqs={faqs}
			benefits={[
				'Анкета не гарантирует трудоустройство или заказы',
				'Курьер сам подтверждает подходящий выезд',
			]}
			buttonLabel="Оставить анкету"
			buttonHref={contactsUrl}
			class="partners-faq"
		/>
	</div>

	<PartnersOtherCities city={city} />
	<Footer city={city} />
</Layout>

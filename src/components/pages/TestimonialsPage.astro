---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/shared/header/Header.astro';
import Footer from '../../components/shared/footer/Footer.astro';
import TestimonialsPageHeader from '../../components/testimonials/TestimonialsPageHeader.astro';
import TestimonialsGrid from '../../components/testimonials/TestimonialsGrid.astro';
import TestimonialsCoreFeatures from '../../components/testimonials/TestimonialsCoreFeatures.astro';
import TestimonialsWhyChoose from '../../components/testimonials/TestimonialsWhyChoose.astro';
import TestimonialsFaqs from '../../components/testimonials/TestimonialsFaqs.astro';
import TestimonialsExpertise from '../../components/testimonials/TestimonialsExpertise.astro';
import { breadcrumbNode, webPageNode } from '../../lib/seo';

const title = 'Отзывы водителей о доставке топлива и дорожной помощи | За рулём';
const description = 'Отзывы и истории обращений водителей за доставкой бензина и помощью на дороге в городе, за городом и на трассе.';

const jsonLd = [
	webPageNode({
		name: 'Отзывы о доставке топлива и дорожной помощи',
		description: description,
		url: '/testimonials',
	}),
	breadcrumbNode([
		{ name: 'Главная', url: '/' },
		{ name: 'Отзывы', url: '/testimonials' },
	]),
];
---

<Layout
	title={title}
	description={description}
	ogTitle={title}
	ogDescription="Истории обращений за доставкой топлива к остановившемуся автомобилю в городе, за городом или на трассе."
	keywords="доставка бензина отзывы, подвоз бензина отзывы, доставка топлива, привезти бензин на дорогу, бензин на трассу"
	jsonLd={jsonLd}
	isNational={true}
>
	<Header isNational={true} />
	<main>
		<TestimonialsPageHeader />
		<TestimonialsGrid />
		<TestimonialsCoreFeatures />
		<TestimonialsWhyChoose />
		<TestimonialsFaqs />
		<TestimonialsExpertise />
	</main>
	<Footer isNational={true} nationalVariant="system" />
</Layout>

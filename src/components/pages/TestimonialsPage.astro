---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/shared/header/Header.astro';
import Footer from '../../components/shared/footer/Footer.astro';
import TestimonialsPageHeader from '../../components/testimonials/TestimonialsPageHeader.astro';
import TestimonialsGrid from '../../components/testimonials/TestimonialsGrid.astro';
import TestimonialsCoreFeatures from '../../components/testimonials/TestimonialsCoreFeatures.astro';
import TestimonialsWhyChoose from '../../components/testimonials/TestimonialsWhyChoose.astro';
import TestimonialsFaqs from '../../components/testimonials/TestimonialsFaqs.astro';
import TestimonialsExpertise from '../../components/testimonials/TestimonialsExpertise.astro';
import { breadcrumbNode, webPageNode } from '../../lib/seo';
import type { ChatCity } from '../../data/cities';
import { replaceCityPlaceholders, getCityUrl } from '../../lib/city';

export interface Props {
	city: ChatCity;
}

const { city } = Astro.props;

const title = replaceCityPlaceholders("Отзывы о доставке бензина {inCity} | За рулём", city);
const description = replaceCityPlaceholders("Отзывы водителей о доставке бензина {inCity} и области: срочный подвоз топлива к автомобилю в городе, за городом и на трассе.", city);

const jsonLd = [
	webPageNode({
		name: replaceCityPlaceholders('Отзывы о доставке бензина {inCity}', city),
		description: description,
		url: getCityUrl('/testimonials', city.slug),
	}),
	breadcrumbNode([
		{ name: 'Главная', url: getCityUrl('/', city.slug) },
		{ name: 'Отзывы', url: getCityUrl('/testimonials', city.slug) },
	]),
];
---

<Layout
	title={title}
	description={description}
	ogTitle={title}
	ogDescription={replaceCityPlaceholders("Истории водителей, которым я привёз бензин к остановившемуся автомобилю {inCity}, за городом или на трассе.", city)}
	keywords={replaceCityPlaceholders("доставка бензина отзывы, подвоз бензина {city} отзывы, доставка топлива {city}, привезти бензин на дорогу, бензин на трассу", city)}
	jsonLd={jsonLd}
    city={city}
>
	<Header city={city} />
	<main>
		<TestimonialsPageHeader city={city} />
		<TestimonialsGrid city={city} />
		<TestimonialsCoreFeatures city={city} />
		<TestimonialsWhyChoose city={city} />
		<TestimonialsFaqs city={city} />
		<TestimonialsExpertise city={city} />
	</main>
	<Footer city={city} />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/shared/header/Header.astro';
import Footer from '../../components/shared/footer/Footer.astro';
import PageHeader from '../../components/shared/PageHeader.astro';
import ReasonsSlider from '../../components/shared/ReasonsSlider.astro';
import ServiceFaqs from '../../components/services/single/ServiceFaqs.astro';
import AboutCta from '../../components/about/AboutCta.astro';
import InteractiveRequestMap from '../../features/interactive-requests/ui/InteractiveRequestMap';
import { ASSISTANCE_TARIFFS, URGENCY_META, URGENCY_ORDER } from '../../features/interactive-requests/model/constants';
import { applyUrgencyMarkup, formatPrice, getMinimalPrice } from '../../features/interactive-requests/model/pricing';
import { toMapStations } from '../../features/interactive-requests/model/mapStations';
import { fetchCityGasStations, getBoundsCenter } from '../../lib/gasStations';
import { getCityUrl, replaceCityPlaceholders, type ChatCity } from '../../lib/cities';

export interface Props {
	city: ChatCity;
}

const { city } = Astro.props;
const [cityLat, cityLng] = getBoundsCenter(city.bounds);

// АЗС города нужны и здесь: по ним водитель ориентируется, когда ставит метку поломки.
const stations = toMapStations(await fetchCityGasStations(city.slug));

const title = replaceCityPlaceholders('Автопомощь на дороге {inCity} — карта вызовов 24/7', city);
const description = replaceCityPlaceholders(
	'Буксировка, прикурить АКБ, замена ГРМ, подвоз топлива, лебёдка и вскрытие авто {inCity}. Поставьте метку на карте — ближайший мастер перезвонит.',
	city,
);

const assistanceReasons = [
	{
		icon: '🔋',
		title: 'Сел аккумулятор',
		text: 'Утром машина не завелась, а вам на работу — мастер прикурит или привезёт новый АКБ на место.',
	},
	{
		icon: '⛽',
		title: 'Закончилось топливо',
		text: 'До заправки не дотянули или топлива нет на АЗС — закажите подвоз канистры прямо к машине.',
	},
	{
		icon: '🛠️',
		title: 'Авто встало на дороге',
		text: 'ГРМ, генератор, патрубки: выездной мастер поставит диагноз и сделает мелкий ремонт на месте.',
	},
	{
		icon: '🔩',
		title: 'Пробили колесо',
		text: 'Нет запаски, домкрата или сил менять в дороге — мобильный шиномонтаж приедет к вам.',
	},
	{
		icon: '🧊',
		title: 'Машина замёрзла',
		text: 'Сильный мороз и авто не запускается — тепловая пушка и отогрев вернут её к жизни.',
	},
	{
		icon: '🏕️',
		title: 'Застряли в грязи или снегу',
		text: 'Засели на даче, в колее или во дворе — вытащат лебёдкой без повреждений кузова.',
	},
	{
		icon: '🔑',
		title: 'Ключи внутри салона',
		text: 'Захлопнули дверь с ключами или ребёнком внутри — аккуратное вскрытие без взлома.',
	},
	{
		icon: '🚛',
		title: 'Нужно дотащить до сервиса',
		text: 'Ремонт на месте невозможен — буксировка довезёт машину до СТО или гаража.',
	},
];

const faqs = [
	{
		question: 'Как вызвать помощь через карту?',
		answer:
			'Нажмите на карту там, где стоит машина, выберите услугу и уровень срочности, оставьте телефон и опишите ситуацию. Заявка с ценой появится на карте, и её увидят все мастера города.',
	},
	{
		question: 'Какие услуги можно заказать?',
		answer:
			'Буксировка и «дотащить до сервиса», прикурить или заменить аккумулятор, замена ГРМ и мелкий выездной ремонт, подвоз топлива, отогрев авто, вытаскивание лебёдкой из грязи и снега, замена колеса, вскрытие замков.',
	},
	{
		question: 'Как считается стоимость?',
		answer:
			'Итоговая сумма зависит от срочности: +80% для срочного выезда, +65% если можно немного подождать и +30% когда время терпит. Итоговая сумма видна на метке карты сразу.',
	},
	{
		question: 'Как связаться с мастером?',
		answer:
			'Нажмите на метку заявки: откроется карточка с ценой, описанием и кнопкой звонка. Мастер и водитель договариваются напрямую, без посредников и предоплаты сервису.',
	},
];
---

<Layout title={title} description={description} city={city}>
	<Header city={city} />

	<PageHeader
		title={replaceCityPlaceholders('Автопомощь на дороге {inCity} — карта вызовов', city)}
		items={[
			{ label: 'Главная', href: getCityUrl('/', city.slug) },
			{ label: 'Автопомощь на карте' },
		]}
		helpLabel="Вызвать автопомощь"
		helpService="Автопомощь на дороге"
		helpSubject="Заявка на автопомощь"
	/>

	<ReasonsSlider
		title="С чем чаще всего вызывают автопомощь"
		lead={replaceCityPlaceholders(
			'Сломались, разрядились или застряли? Отметьте место на карте {ofCity} — ближайший мастер увидит заявку с ценой и перезвонит.',
			city,
		)}
		slides={assistanceReasons}
	/>

	<section class="assist-map-section" aria-label="Карта заявок на автопомощь">
		<InteractiveRequestMap
			client:only="react"
			kind="assistance"
			citySlug={city.slug}
			cityName={city.name}
			cityLat={cityLat}
			cityLng={cityLng}
			stations={stations}
		/>
	</section>

	<section class="assist-services">
		<div class="container">
			<h2>Услуги выездной автопомощи</h2>
			<p class="assist-services__lead">
				Базовый тариф каждой услуги растёт вместе со срочностью: +30%, +65% или +80%.
			</p>

			<div class="assist-services__grid">
				{ASSISTANCE_TARIFFS.map((tariff) => (
					<article class="assist-service-card">
						<span class="assist-service-card__icon" aria-hidden="true">{tariff.icon}</span>
						<h3>{tariff.label}</h3>
						<p>{tariff.hint}</p>
						<p class="assist-service-card__price">
							от {formatPrice(getMinimalPrice(tariff))}
							<span>срочно — {formatPrice(applyUrgencyMarkup(tariff.basePrice, 'red'))}</span>
						</p>
					</article>
				))}
			</div>

			<div class="assist-urgency">
				{URGENCY_ORDER.map((level) => (
					<article class="assist-urgency__item" style={`--urgency-color:${URGENCY_META[level].color}`}>
						<h3>{URGENCY_META[level].label} · +{URGENCY_META[level].markupPercent}%</h3>
						<p>{URGENCY_META[level].hint}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="assist-faq-section">
		<div class="container">
			<ServiceFaqs faqs={faqs} title="Частые вопросы об автопомощи" />
		</div>
	</section>

	<section class="assist-cta-section">
		<AboutCta city={city} />
	</section>

	<Footer city={city} />

	<style>
		.assist-map-section {
			width: 100%;
		}

		.assist-services {
			padding: 72px 0;
		}

		.assist-services h2 {
			margin-bottom: 12px;
		}

		.assist-services__lead {
			max-width: 720px;
			margin-bottom: 36px;
		}

		.assist-services__grid {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 20px;
		}

		.assist-service-card {
			display: flex;
			flex-direction: column;
			gap: 8px;
			padding: 24px;
			border-radius: 20px;
			background: var(--secondary-color);
		}

		.assist-service-card__icon {
			font-size: 28px;
			line-height: 1;
		}

		.assist-service-card h3 {
			margin: 0;
			font-size: 18px;
		}

		.assist-service-card p {
			margin: 0;
		}

		.assist-service-card__price {
			display: flex;
			flex-direction: column;
			margin-top: auto;
			padding-top: 12px;
			font-weight: 700;
		}

		.assist-service-card__price span {
			font-size: 13px;
			font-weight: 500;
			opacity: 0.75;
		}

		.assist-urgency {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 20px;
			margin-top: 32px;
		}

		.assist-urgency__item {
			padding: 24px;
			border-left: 4px solid var(--urgency-color);
			border-radius: 16px;
			background: var(--secondary-color);
		}

		.assist-urgency__item h3 {
			margin-bottom: 8px;
			font-size: 18px;
		}

		.assist-urgency__item p {
			margin-bottom: 0;
		}

		.assist-faq-section {
			padding-bottom: 100px;
		}

		.assist-faq-section :global(.page-single-faqs) {
			max-width: 980px;
			margin: 0 auto;
		}

		.assist-faq-section :global(.section-title) {
			margin-bottom: 40px;
			text-align: center;
		}

		.assist-cta-section {
			padding-bottom: 120px;
		}

		@media (max-width: 1199px) {
			.assist-services__grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (max-width: 767px) {
			.assist-services__grid,
			.assist-urgency {
				grid-template-columns: 1fr;
			}

			.assist-services {
				padding: 56px 0;
			}

			.assist-faq-section {
				padding-bottom: 72px;
			}

			.assist-cta-section {
				padding-bottom: 80px;
			}
		}
	</style>
</Layout>

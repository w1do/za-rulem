---
import PageHeaderHelpButton from '../shared/PageHeaderHelpButton.astro';
import PageHeaderChatButton from '../shared/PageHeaderChatButton.astro';

import { getCityBySlug, replaceCityPlaceholders, getCityUrl } from '../../lib/city';
import type { ChatCity } from '../../data/cities';

// Шапка хаба услуги. Разметка перенесена из шаблона (page-header parallaxie),
// как на странице «О сервисе», с хлебными крошками до раздела услуг.
interface Props {
	city?: ChatCity;
	title?: string;
	breadcrumb?: string;
	showChatButton?: boolean;
	chatLink?: string;
}

const { city: propCity } = Astro.props;
const city = propCity ?? getCityBySlug();

const {
	title: propTitle,
	breadcrumb = 'Техпомощь',
	showChatButton = false,
	chatLink,
} = Astro.props;

const title = propTitle ?? replaceCityPlaceholders('Техпомощь на дороге {inCity}', city);
---

<!-- Page Header Section Start -->
<div class="page-header parallaxie">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<!-- Page Header Box Start -->
				<div class="page-header-box">
					<h1 class="text-anime-style-3" data-cursor="-opaque">{title}</h1>
					<nav class="wow fadeInUp">
						<ol class="breadcrumb">
							<li class="breadcrumb-item"><a href={getCityUrl('/', city.slug)}>главная</a></li>
							<li class="breadcrumb-item"><a href={getCityUrl('/services', city.slug)}>услуги</a></li>
							<li class="breadcrumb-item active" aria-current="page">{breadcrumb}</li>
						</ol>
					</nav>
					<PageHeaderHelpButton />
					{showChatButton && <PageHeaderChatButton href={chatLink} />}
				</div>
				<!-- Page Header Box End -->
			</div>
		</div>
	</div>
</div>
<!-- Page Header Section End -->

---
import { getCityBySlug, replaceCityPlaceholders, getCityUrl } from '../../lib/city';
import type { ChatCity } from '../../data/cities';

// Блок «Мой подход» хаба. Разметка our-apporach из source. Контент — через props.
interface ApproachItem {
	title: string;
	description: string;
	points?: string[];
	icon?: string;
}

interface Props {
	city?: ChatCity;
	subtitle?: string;
	title?: string;
	items?: ApproachItem[];
	image?: string;
	imageAlt?: string;
	footerText?: string;
	footerLinkHref?: string;
	footerLinkLabel?: string;
	footerBadge?: string;
}

const { city: propCity } = Astro.props;
const city = propCity ?? getCityBySlug();

const defaultItems: ApproachItem[] = [
	{
		title: 'Быстрый выезд',
		description: 'Я беру трубку сам и выезжаю к машине с нужным оборудованием.',
		icon: '/images/icon-approach-item-1.svg',
		points: [
			replaceCityPlaceholders('Подача {byCity} за 20–40 минут', city),
			'Работаю круглосуточно, включая мороз',
		],
	},
	{
		title: 'Честный расчёт',
		description: 'Я называю цену до выезда и не навязываю лишние работы.',
		icon: '/images/icon-approach-item-2.svg',
		points: ['Оплата наличными или переводом на месте', 'Объясняю причину поломки простыми словами'],
	},
];

const {
	subtitle = 'Мой подход',
	title = 'Я решаю проблему на месте, без лишнего ожидания',
	items = defaultItems,
	image = '/images/approach-image.jpg',
	imageAlt = replaceCityPlaceholders('Выездная автопомощь {inCity}', city),
	footerText = 'Полный список дорожной помощи —',
	footerLinkHref: propFooterLinkHref,
	footerLinkLabel = 'смотреть услуги',
	footerBadge = 'На связи круглосуточно',
} = Astro.props;

const footerLinkHref = propFooterLinkHref ?? getCityUrl('/services', city.slug);

const approachIcons = [
	'/images/icon-approach-item-1.svg',
	'/images/icon-approach-item-2.svg',
];
---

<!-- Our Approach Section Start -->
<div class="our-apporach bg-section">
	<div class="container">
		<div class="row section-row">
			<div class="col-xl-12">
				<!-- Section Title Start -->
				<div class="section-title section-title-center">
					<span class="section-sub-title wow fadeInUp">{subtitle}</span>
					<h2 class="text-anime-style-3" data-cursor="-opaque">{title}</h2>
				</div>
				<!-- Section Title End -->
			</div>
		</div>

		<div class="row">
			<div class="col-xl-6">
				<!-- Approach Item List Start -->
				<div class="approach-item-list">
					{
						items.map((item, index) => (
							<div
								class="approach-item wow fadeInUp"
								data-wow-delay={index === 0 ? undefined : `${index * 0.2}s`}
							>
								<div class="approach-item-header">
									<div class="icon-box">
										<img
											src={item.icon ?? approachIcons[index] ?? approachIcons[0]}
											alt={item.title}
										/>
									</div>
									<div class="approach-item-content">
										<h3>{item.title}</h3>
										<p>{item.description}</p>
									</div>
								</div>
								{(item.points?.length ?? 0) > 0 && (
									<div class="approach-item-body-list">
										<ul>
											{item.points!.map((point) => (
												<li>{point}</li>
											))}
										</ul>
									</div>
								)}
							</div>
						))
					}
				</div>
				<!-- Approach Item List End -->
			</div>

			<div class="col-xl-6">
				<!-- Approach Image Start -->
				<div class="approach-image">
					<figure class="image-anime reveal">
						<img src={image} alt={imageAlt} />
					</figure>
				</div>
				<!-- Approach Image End -->
			</div>

			<div class="col-lg-12">
				<!-- Section Footer Text Start -->
				<div class="section-footer-text section-satisfy-img wow fadeInUp" data-wow-delay="0.2s">
					<!-- Satisfy Client Images Start -->
					<div class="satisfy-client-images">
						<div class="satisfy-client-image">
							<figure class="image-anime">
								<img src="/images/author-1.jpg" alt="Мастер техпомощи" />
							</figure>
						</div>
						<div class="satisfy-client-image add-more">
							<img src="/images/icon-phone-primary.svg" alt="Телефон" />
						</div>
					</div>
					<!-- Satisfy Client Images End -->
					<p>
						{footerText}{' '}
						<a href={footerLinkHref}>{footerLinkLabel}</a>
					</p>
					<ul>
						<li><span class="counter">24</span>/7</li>
						<li>
							<i class="fa-solid fa-star"></i>
							<i class="fa-solid fa-star"></i>
							<i class="fa-solid fa-star"></i>
							<i class="fa-solid fa-star"></i>
							<i class="fa-solid fa-star"></i>
						</li>
						<li>{footerBadge}</li>
					</ul>
				</div>
				<!-- Section Footer Text End -->
			</div>
		</div>
	</div>
</div>
<!-- Our Approach Section End -->

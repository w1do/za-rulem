---
import { defaultCity, replaceCityPlaceholders } from '../../lib/cities';
import type { ChatCity } from '../../lib/cities';
import { Image } from 'astro:assets';

import whyChooseImg1 from '../../assets/images/why-choose-image-1.jpg';
import whyChooseImg2 from '../../assets/images/why-choose-image-2.jpg';
import author1 from '../../assets/images/author-1.jpg';
import author2 from '../../assets/images/author-2.jpg';
import author3 from '../../assets/images/author-3.jpg';

// Блок «Почему я» хаба. Разметка why-choose-us из source. Контент — через props.
interface WhyChooseItem {
	title: string;
	description: string;
	icon?: string;
}

interface Props {
	city?: ChatCity;
	subtitle?: string;
	title?: string;
	items?: WhyChooseItem[];
	image1?: any;
	image1Alt?: string;
	image2?: any;
	image2Alt?: string;
	counterLabel?: string;
}

const { city: propCity } = Astro.props;
const city = propCity ?? defaultCity;

const defaultItems: WhyChooseItem[] = [
	{
		title: 'Цена заранее',
		description: 'Я называю стоимость по телефону, до выезда и без скрытых доплат.',
		icon: '/images/icon-why-choose-item-1.svg',
	},
	{
		title: 'Бережная работа',
		description: 'Я работаю аккуратно, без риска повредить электронику и кузов.',
		icon: '/images/icon-why-choose-item-2.svg',
	},
	{
		title: 'Свои запчасти',
		description: 'Привожу аккумуляторы, бустер и топливо — большинство задач решаю на месте.',
		icon: '/images/icon-why-choose-item-3.svg',
	},
	{
		title: 'Выезд 24/7',
		description: replaceCityPlaceholders('Я работаю круглосуточно {inCity} и области.', city),
		icon: '/images/icon-why-choose-item-4.svg',
	},
];

const {
	subtitle = 'Почему я',
	title: propTitle,
	items: propItems,
	image1 = whyChooseImg1,
	image1Alt = 'Автопомощь на дороге',
	image2 = whyChooseImg2,
	image2Alt = 'Круглосуточная техпомощь',
	counterLabel = 'На связи всегда',
} = Astro.props;

const title = propTitle ?? replaceCityPlaceholders('Почему водители {ofCity} вызывают меня', city);
const items = (propItems ?? defaultItems).map((item) => ({
	...item,
	title: replaceCityPlaceholders(item.title, city),
	description: replaceCityPlaceholders(item.description, city),
}));

const whyIcons = [
	'/images/icon-why-choose-item-1.svg',
	'/images/icon-why-choose-item-2.svg',
	'/images/icon-why-choose-item-3.svg',
	'/images/icon-why-choose-item-4.svg',
];

// Разметка source: два списка по два пункта
const columns: WhyChooseItem[][] = [];
for (let i = 0; i < items.length; i += 2) {
	columns.push(items.slice(i, i + 2));
}
---

<!-- Why Choose Us Section Start -->
<div class="why-choose-us">
	<div class="container">
		<div class="row align-items-center">
			<div class="col-xl-6">
				<!-- Why Choose Content Start -->
				<div class="why-choose-content">
					<!-- Section Title Start -->
					<div class="section-title">
						<span class="section-sub-title wow fadeInUp">{subtitle}</span>
						<h2 class="text-anime-style-3" data-cursor="-opaque">{title}</h2>
					</div>
					<!-- Section Title End -->

					<!-- Why Choose Body Start -->
					<div class="why-choose-body">
						{
							columns.map((column, colIndex) => (
								<div
									class="why-choose-items-list wow fadeInUp"
									data-wow-delay={colIndex === 0 ? '0.2s' : `${0.2 + colIndex * 0.2}s`}
								>
									{column.map((item, itemIndex) => {
										const globalIndex = colIndex * 2 + itemIndex;
										return (
											<div class="why-choose-item">
												<div class="icon-box">
													<img
														src={item.icon ?? whyIcons[globalIndex] ?? whyIcons[0]}
														alt={item.title}
													/>
												</div>
												<div class="why-choose-item-content">
													<h3>{item.title}</h3>
													<p>{item.description}</p>
												</div>
											</div>
										);
									})}
								</div>
							))
						}
					</div>
					<!-- Why Choose Body End -->
				</div>
				<!-- Why Choose Content End -->
			</div>

			<div class="col-xl-6">
				<!-- Why Choose Image Box Start -->
				<div class="why-choose-image-box wow fadeInUp" data-wow-delay="0.2s">
					<!-- Why Choose Image Box 1 Start -->
					<div class="why-choose-image-box-1">
						<!-- Why Choose Image Start -->
						<div class="why-choose-image">
							<figure class="image-anime">
								<Image src={image1} alt={image1Alt} width={600} />
							</figure>
						</div>
						<!-- Why Choose Image End -->
					</div>
					<!-- Why Choose Image Box 1 End -->

					<!-- Why Choose Image Box 2 Start -->
					<div class="why-choose-image-box-2">
						<!-- Why Choose Counter Box Start -->
						<div class="why-choose-counter-box">
							<!-- Why Choose Counter Number Start -->
							<div class="why-choose-counter-no">
								<h2><span class="counter">24</span>/7</h2>
							</div>
							<!-- Why Choose Counter Number End -->

							<!-- Why Choose Counter Content Start -->
							<div class="why-choose-counter-content">
								<!-- Client Satisfaction Image Start -->
								<div class="satisfy-client-images">
									<div class="satisfy-client-image">
										<figure class="image-anime">
											<Image src={author1} alt="Отзыв о помощи" width={60} height={60} />
										</figure>
									</div>
									<div class="satisfy-client-image">
										<figure class="image-anime">
											<Image src={author2} alt="Отзыв о помощи" width={60} height={60} />
										</figure>
									</div>
									<div class="satisfy-client-image">
										<figure class="image-anime">
											<Image src={author3} alt="Отзыв о помощи" width={60} height={60} />
										</figure>
									</div>
								</div>
								<!-- Client Satisfaction Image End -->

								<!-- Why Choose Satisfy Content Start -->
								<div class="why-choose-client-content">
									<p>{counterLabel}</p>
								</div>
								<!-- Why Choose Satisfy Content End -->
							</div>
							<!-- Why Choose Counter Content End -->
						</div>
						<!-- Why Choose Counter Box End -->

						<!-- Why Choose Image Start -->
						<div class="why-choose-image">
							<figure class="image-anime">
								<Image src={image2} alt={image2Alt} width={600} />
							</figure>
						</div>
						<!-- Why Choose Image End -->
					</div>
					<!-- Why Choose Image Box 2 End -->
				</div>
				<!-- Why Choose Image Box End -->
			</div>
		</div>
	</div>
</div>
<!-- Why Choose Us Section End -->

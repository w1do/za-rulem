---
// Блок призыва к действию хаба. Разметка перенесена из шаблона (cta-box bg-section dark-section parallaxie).
interface Props {
	subtitle?: string;
	title?: string;
	description?: string;
	btnText?: string;
	btnHref?: string;
	contactTitle?: string;
	contactText?: string;
	contactLinkText?: string;
	contactLinkHref?: string;
	features?: string[];
}

const {
	subtitle = "Связаться со мной",
	title = "Нужна техпомощь на дороге?",
	description = "Я принимаю заявки на выезд в Тюмени и Тюменской области круглосуточно. Оставьте заявку — уточню ситуацию и назову цену заранее.",
	btnText = "Оставить заявку",
	btnHref = "/contacts",
	contactTitle = "Круглосуточно, 24/7",
	contactText = "Выезд по заявке",
	contactLinkText = "Выезд по заявке",
	contactLinkHref = "/contacts",
	features = ["Выезжаю на место поломки", "Работаю круглосуточно, 24/7"]
} = Astro.props;
---

<!-- CTA Section Start -->
<div class="cta-box bg-section dark-section parallaxie">
	<div class="container">
		<div class="row">
			<div class="col-xl-6">
				<div class="cta-box-content">
					<!-- Section Title Start -->
					<div class="section-title">
						<span class="section-sub-title wow fadeInUp">{subtitle}</span>
						<h2 class="text-anime-style-3" data-cursor="-opaque">{title}</h2>
						<p class="wow fadeInUp" data-wow-delay="0.2s">{description}</p>
					</div>
					<!-- Section Title End -->

					<!-- CTA Body Start -->
					{features && features.length > 0 && (
						<div class="cta-content-body wow fadeInUp" data-wow-delay="0.4s">
							<ul>
								{features.map((feature) => <li>{feature}</li>)}
							</ul>
						</div>
					)}
					<!-- CTA Body End -->

					<!-- CTA Content Footer Start -->
					<div class="cta-content-footer wow fadeInUp" data-wow-delay="0.4s">
						<!-- CTA Button Start -->
						<div class="cta-content-btn">
							<a href={btnHref} class="btn-default btn-highlighted">{btnText}</a>
						</div>
						<!-- CTA Button End -->

						<!-- About Contact Box Start -->
						<div class="about-contact-box">
							<div class="icon-box">
								<img src="/images/icon-phone-primary.svg" alt="Заявка" />
							</div>
							<div class="about-contact-box-content">
								<p>{contactTitle}</p>
								<h3><a href={contactLinkHref} class="btn-default" data-service-request data-service-title={contactLinkText}>{contactLinkText}</a></h3>
							</div>
						</div>
						<!-- About Contact Box End -->
					</div>
					<!-- CTA Content Footer End -->
				</div>
			</div>
		</div>
	</div>
</div>
<!-- CTA Section End -->

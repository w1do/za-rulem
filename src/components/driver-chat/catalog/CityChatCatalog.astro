---
import CityChatCard from './CityChatCard.astro';
import CityChatJoinModal from './CityChatJoinModal';
import type { CityChatCatalogCard, CityChatSearchOption } from './model';

interface Props {
	cards: CityChatCatalogCard[];
	cities: CityChatSearchOption[];
}

const { cards, cities } = Astro.props;
---

<CityChatJoinModal client:load cities={cities} />

<section id="city-chat-catalog" class="our-pricing-gold city-chat-catalog" aria-labelledby="city-chat-catalog-title">
	<div class="container">
		<div class="row section-row">
			<div class="col-xl-12">
				<div class="section-title section-title-center">
					<span class="section-sub-title">10 рекомендованных городов</span>
					<h2 id="city-chat-catalog-title">Чаты с полным свежим срезом по топливу</h2>
					<p>
						Рейтинг учитывает число свежих наблюдений по АИ-92, АИ-95 и дополнительному виду топлива.
						Это показатель полноты данных, а не гарантия остатка на конкретной АЗС.
					</p>
				</div>
			</div>
		</div>

		{cards.length > 0 ? (
			<div class="row">
				{cards.map((card) => <CityChatCard card={card} />)}
			</div>
		) : (
			<div class="row">
				<div class="col-lg-12">
					<div class="pricing-item-gold city-chat-catalog__empty" role="status">
						<div class="pricing-item-list-gold">
							<h3>Свежая сводка временно недоступна</h3>
							<p>Города без достаточных свежих данных не попадают в рекомендации. Используйте поиск выше или откройте общий чат.</p>
							<a class="btn-default" href="/chat">Открыть общий чат</a>
						</div>
					</div>
				</div>
			</div>
		)}
	</div>
</section>

<style>
	.city-chat-catalog .section-title { max-width: 920px; margin-inline: auto; }
	.city-chat-catalog__empty { max-width: 760px; margin: 0 auto 30px; }
	.city-chat-catalog__empty .pricing-item-list-gold { text-align: center; }
	.city-chat-catalog__empty p { margin-bottom: 24px; }
</style>

<style is:global>
	.city-chat-search { padding: 120px 0; }
	.city-chat-search .section-title { margin-bottom: 0; }
	.city-chat-search__form { padding: 40px; }
	.city-chat-search__field { position: relative; }
	.city-chat-search__field i { position: absolute; top: 50%; left: 20px; z-index: 1; color: var(--accent-color); transform: translateY(-50%); }
	.city-chat-search__field .form-control { padding: 20px 20px 20px 52px; border: 0; border-radius: 10px; background: var(--bg-color); box-shadow: none; }
	.city-chat-search__results { display: grid; gap: 10px; margin-top: 16px; }
	.city-chat-search__results > button { display: flex; align-items: center; justify-content: space-between; gap: 20px; width: 100%; padding: 14px 16px; border: 1px solid var(--divider-color); border-radius: 10px; background: var(--white-color); color: var(--primary-color); text-align: left; cursor: pointer; }
	.city-chat-search__results > button:hover { border-color: var(--accent-color); }
	.city-chat-search__results > button span:first-child { display: grid; gap: 2px; }
	.city-chat-search__results small { color: var(--text-color); }
	.city-chat-search__results .readmore-btn { flex: 0 0 auto; }
	.city-chat-search__notice { margin: 0; color: var(--text-color); }
	.service-request-modal .form-control { padding: 18px 20px; border: 0; border-radius: 10px; background: var(--bg-color); box-shadow: none; }
	.city-chat-join__hint,
	.city-chat-join__error { min-height: 20px; margin: 7px 0 0; font-size: 12px; }
	.city-chat-join__error { color: #b42318; }
	.city-chat-join__submit { width: 100%; border: 0; cursor: pointer; }
	.city-chat-join__privacy { display: block; margin-top: 14px; color: var(--text-color); text-align: center; }
	.city-chat-join__privacy a { color: var(--primary-color); text-decoration: underline; }
	.city-chat-search button:focus-visible,
	.service-request-modal button:focus-visible,
	.city-chat-search input:focus-visible,
	.service-request-modal input:focus-visible,
	.service-request-modal a:focus-visible { outline: 3px solid rgba(245, 183, 84, .55); outline-offset: 2px; }

	@media (max-width: 991px) {
		.city-chat-search .section-title { margin-bottom: 35px; }
	}

	@media (max-width: 767px) {
		.city-chat-search { padding: 60px 0; }
		.city-chat-search__form { padding: 24px 18px; }
		.city-chat-search__results > button { align-items: flex-start; flex-direction: column; gap: 8px; }
	}
</style>

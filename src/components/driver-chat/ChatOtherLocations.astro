---
import { chatCities, chatFuels, DEFAULT_CITY_SLUG, cityLandingUrl, fuelLandingUrl, chatAppUrl } from '../../data/chatCluster';

interface Props {
    currentCitySlug: string;
    currentFuelSlug?: string;
}

const { currentCitySlug, currentFuelSlug } = Astro.props;

const otherCities = chatCities.filter(c => c.slug !== currentCitySlug);

// Для SEO-заголовка секции
const sectionTitle = currentFuelSlug 
    ? `Этот бензин в других городах` 
    : `Другие локации чата`;
---

<section class="chat-other-locations py-5 bg-section">
	<div class="container">
		<div class="row section-row">
			<div class="col-lg-12">
				<div class="section-title section-title-center">
					<span class="section-sub-title">Локации</span>
					<h2>{sectionTitle}</h2>
					<p>Я развиваю сеть чатов по всему региону. Если вы планируете поездку в соседний город, загляните в местный чат, чтобы спланировать заправки заранее.</p>
				</div>
			</div>
		</div>

		<div class="row">
			{
				otherCities.map((city, index) => (
					<div class="col-xl-4 col-md-6 mb-4">
						<div class="service-item wow fadeInUp" data-wow-delay={`${index * 0.1}s`}>
							<div class="icon-box">
								<img src="/images/icon-location-primary.svg" alt={city.name} />
							</div>
							<div class="service-item-body">
								<div class="service-item-content">
									<h3>
                                        <a href={currentFuelSlug ? fuelLandingUrl(city.slug, currentFuelSlug) : cityLandingUrl(city.slug)}>
                                            {city.name}
                                        </a>
                                    </h3>
									<p>{city.hint}</p>
								</div>
								
								<div class="service-item-btn mt-3">
									<div class="mb-3">
										<a href={currentFuelSlug ? fuelLandingUrl(city.slug, currentFuelSlug) : cityLandingUrl(city.slug)} class="readmore-btn">
											{currentFuelSlug ? `Бензин в ${city.inCity}` : `Перейти в чат ${city.ofCity}`}
										</a>
									</div>
									<div class="fuel-links-grid">
										{chatFuels.map(fuel => (
											<a href={chatAppUrl(city.slug, fuel.slug)} class="fuel-link-item">
												{fuel.name}
											</a>
										))}
									</div>
								</div>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
    .service-item-content h3 {
        font-size: 22px;
        margin-bottom: 10px;
        font-weight: 700;
    }
    .service-item-content h3 a {
        color: var(--primary-color);
        text-decoration: none;
        transition: all 0.3s;
    }
    .service-item-content h3 a:hover {
        color: var(--accent-color);
    }
    .readmore-btn {
        display: inline-flex;
        align-items: center;
        color: var(--primary-color);
        font-weight: 600;
        text-decoration: none;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .readmore-btn::after {
        content: "\f178";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        margin-left: 8px;
        transition: all 0.3s;
    }
    .readmore-btn:hover::after {
        margin-left: 12px;
    }
    .fuel-links-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }
    .fuel-link-item {
        display: block;
        text-align: center;
        padding: 6px;
        background: #f8f9fa;
        border-radius: 8px;
        font-size: 13px;
        color: var(--primary-color);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid #eee;
    }
    .fuel-link-item:hover {
        background: var(--accent-color);
        border-color: var(--accent-color);
    }
</style>
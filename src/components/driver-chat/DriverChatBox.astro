---
// Переиспользуемый блок чата водителей.
// Встраивается на любую страницу как компонент, а также используется
// на отдельной PWA-странице /chat. Стили общие для обоих сценариев.
import { cities, defaultCity, type ChatCity } from '../../lib/cities';
import DriverChat from './DriverChat';
import './driver-chat.css';

interface Props {
	// `section` — карточка внутри страницы, `app` — полноэкранное приложение (PWA).
	variant?: 'section' | 'app';
	city?: ChatCity;
}

const { variant = 'section', city = defaultCity } = Astro.props;

// В island уходит только slug и название: остальные поля городу в браузере не нужны.
const cityOptions = cities.map(({ slug, name }) => ({ slug, name }));
const initialCitySlug = city.slug;
---

<div class:list={["dc-container", { 'dc-container--section': variant === 'section', 'dc-container--app': variant === 'app' }]}>
	<DriverChat client:load variant={variant} cities={cityOptions} defaultCitySlug={initialCitySlug} />
</div>

---
// Переиспользуемый блок чата водителей.
// Встраивается на любую страницу как компонент, а также используется
// на отдельной PWA-странице /chat. Стили общие для обоих сценариев.
import { chatCities } from '../../data/cities';
import DriverChat from './DriverChat';

interface Props {
	// `section` — карточка внутри страницы, `app` — полноэкранное приложение (PWA).
	variant?: 'section' | 'app';
}

const { variant = 'section' } = Astro.props;

// В island уходит только slug и название: остальные поля городу в браузере не нужны.
const cities = chatCities.map(({ slug, name }) => ({ slug, name }));
---

<div class:list={["dc-container", { 'dc-container--section': variant === 'section', 'dc-container--app': variant === 'app' }]}>
	<DriverChat client:load variant={variant} cities={cities} />
</div>

<style is:global>
	/* ==== Чат водителей: общий блок для встраивания и PWA ==== */
	.dc-container--section { min-height: 560px; }
	.dc-container--app { height: 100%; min-height: 0; }

	.dc {
		display: grid;
		grid-template-columns: 300px 1fr;
		background: var(--secondary-color);
		border: 1px solid #ececec;
		border-radius: 24px;
		overflow: hidden;
		box-shadow: 0 24px 70px rgba(18, 18, 18, .10);
		position: relative;
	}
	.dc--section { height: clamp(560px, 72vh, 720px); }
	.dc--app {
		height: 100%;
		min-height: 0;
		border-radius: 0;
		border: none;
		box-shadow: none;
	}
	.dc--login {
		display: block;
		grid-template-columns: none;
		height: auto;
		min-height: 0;
	}

	.dc-avatar {
		flex: 0 0 auto;
		width: 42px;
		height: 42px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--accent-color);
		color: var(--primary-color);
		font-weight: 700;
		font-size: 15px;
	}
	.dc-avatar--lg { width: 56px; height: 56px; font-size: 18px; }
	.dc-avatar--sm { width: 34px; height: 34px; font-size: 13px; background: #eef0f3; color: #6b7280; }

	.dc-status { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: #3f9c5b; }
	.dc-status i { width: 8px; height: 8px; border-radius: 50%; background: #49c875; box-shadow: 0 0 0 3px rgba(73, 200, 117, .18); }
	.dc-status--muted { color: #8a909b; }
	.dc-status--muted i { background: #49c875; }

	/* ---- Боковая колонка каналов ---- */
	.dc-aside {
		display: flex;
		flex-direction: column;
		gap: 18px;
		padding: 24px 20px;
		background: #f7f8fa;
		border-right: 1px solid #ececec;
		min-height: 0;
		overflow-y: auto;
	}
	.dc-aside__profile { display: flex; align-items: center; gap: 14px; }
	.dc-aside__profile-body strong { display: block; font-size: 16px; color: var(--primary-color); }
	.dc-aside__label { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #9aa0aa; }
	.dc-city {
		width: 100%;
		padding: 10px 12px;
		border-radius: 12px;
		border: 1px solid #e2e5e9;
		background: #f7f8fa;
		font-size: 14px;
		color: var(--primary-color);
		margin-bottom: 8px;
		cursor: pointer;
	}
	.dc-city:focus { border-color: var(--accent-color); outline: none; }

	.dc-channels { display: flex; flex-direction: column; gap: 8px; flex: 1; }
	.dc-channel {
		display: flex;
		align-items: center;
		gap: 12px;
		width: 100%;
		padding: 12px;
		text-align: left;
		border: 1px solid transparent;
		border-radius: 14px;
		background: transparent;
		cursor: pointer;
		transition: background .2s ease, border-color .2s ease;
	}
	.dc-channel:hover { background: #eef0f3; }
	.dc-channel.is-active { background: var(--secondary-color); border-color: #e2e5e9; box-shadow: 0 6px 18px rgba(18, 18, 18, .06); }
	.dc-channel__icon {
		flex: 0 0 auto;
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		border-radius: 12px;
		background: #eef0f3;
		color: #6b7280;
		font-size: 16px;
	}
	.dc-channel.is-active .dc-channel__icon { background: var(--accent-color); color: var(--primary-color); }
	.dc-channel__body { display: flex; flex-direction: column; min-width: 0; }
	.dc-channel__body strong { font-size: 14px; color: var(--primary-color); }
	.dc-channel__body span { font-size: 12px; color: #8a909b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

	.dc-aside__cta { justify-content: center; text-align: center; }
	.dc-aside__cta i { margin-right: 8px; }

	/* ---- Основная область ---- */
	.dc-main { display: flex; flex-direction: column; min-width: 0; min-height: 0; background: var(--secondary-color); }
	.dc-main__head {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 16px 22px;
		border-bottom: 1px solid #ececec;
	}
	.dc-main__title { min-width: 0; }
	.dc-main__title strong { display: block; font-size: 16px; color: var(--primary-color); }
	.dc-main__download {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-left: auto;
		padding: 8px 16px;
		border: 1px solid #e2e5e9;
		border-radius: 999px;
		font-size: 14px;
		color: var(--primary-color);
		background: var(--secondary-color);
		cursor: pointer;
		transition: border-color .2s ease;
	}
	.dc-main__download:hover { border-color: var(--accent-color); }
	.dc-main__toggle {
		display: none;
		width: 40px;
		height: 40px;
		border: 1px solid #e2e5e9;
		border-radius: 12px;
		background: var(--secondary-color);
		color: var(--primary-color);
		cursor: pointer;
	}

	.dc-thread {
		flex: 1;
		min-height: 0;
		overflow-y: auto;
		padding: 22px;
		background: #f7f8fa;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.dc-msg { display: flex; align-items: flex-end; gap: 10px; max-width: 82%; }
	.dc-msg--me { align-self: flex-end; flex-direction: row-reverse; }
	.dc-msg--system { align-self: center; max-width: 100%; }
	.dc-msg__system { margin: 4px 0; padding: 8px 16px; border-radius: 999px; background: #eef0f3; color: #6b7280; font-size: 13px; text-align: center; }

	.dc-msg__bubble {
		padding: 11px 15px;
		border-radius: 16px 16px 16px 4px;
		background: var(--secondary-color);
		box-shadow: 0 2px 10px rgba(0, 0, 0, .05);
	}
	.dc-msg--me .dc-msg__bubble { border-radius: 16px 16px 4px 16px; background: var(--accent-color); }
	.dc-msg__bubble b { display: block; font-size: 12px; margin-bottom: 3px; color: #4b5563; }
	.dc-msg__bubble p { margin: 0; color: var(--primary-color); word-break: break-word; }
	.dc-msg__bubble small { display: block; margin-top: 4px; font-size: 10px; opacity: .6; text-align: right; }

	.dc-alert { margin: 14px 22px 0; padding: 12px 16px; border-radius: 12px; background: #fdecec; color: #b42318; font-size: 14px; }
	.dc-alert--inline { margin: 12px 22px 0; }


	.dc-compose { display: flex; align-items: center; gap: 12px; padding: 16px 22px 20px; }
	.dc-compose .form-control { flex: 1; min-width: 0; margin: 0; border-radius: 999px; }
	.dc-send {
		flex: 0 0 auto;
		width: 50px;
		height: 50px;
		display: grid;
		place-items: center;
		border: none;
		border-radius: 50%;
		background: var(--accent-color);
		color: var(--primary-color);
		font-size: 17px;
		cursor: pointer;
		transition: transform .15s ease, filter .2s ease;
	}
	.dc-send:hover { filter: brightness(.96); transform: translateY(-1px); }

	/* ---- Экран входа ---- */
	.dc-login { max-width: 560px; margin: 0 auto; padding: 48px; text-align: center; }
	.dc-login__badge {
		width: 66px;
		height: 66px;
		margin: 0 auto 18px;
		display: grid;
		place-items: center;
		border-radius: 20px;
		background: var(--accent-color);
		color: var(--primary-color);
		font-size: 26px;
	}
	.dc-login h3 { font-size: 30px; margin: 12px 0; }
	.dc-login > p { color: #5f6672; margin-bottom: 26px; }
	.dc-login label { display: block; margin: 0 0 10px; font-weight: 600; text-align: left; }
	.dc-login__row { display: flex; gap: 12px; }
	.dc-login__row .form-control { flex: 1; min-width: 0; margin: 0; }
	.dc-login__row .btn-default { flex: 0 0 auto; white-space: nowrap; }
	.dc-login small { display: block; margin-top: 18px; color: #7d8490; }
	.dc-login small a { color: inherit; text-decoration: underline; }
	.dc-login .dc-alert { margin: 14px 0 0; text-align: left; }
	.dc--app .dc-login { padding: 32px 22px; }

	/* ---- Затемнение под мобильную панель каналов ---- */
	.dc-scrim { display: none; }

	@media (max-width: 991px) {
		.dc { grid-template-columns: 1fr; }
		.dc-main__toggle { display: grid; place-items: center; }
		.dc-aside {
			position: absolute;
			top: 0;
			left: 0;
			bottom: 0;
			width: 280px;
			max-width: 84%;
			z-index: 3;
			transform: translateX(-105%);
			transition: transform .25s ease;
			border-right: 1px solid #ececec;
		}
		.dc--aside-open .dc-aside { transform: translateX(0); box-shadow: 24px 0 60px rgba(0, 0, 0, .18); }
		.dc--aside-open .dc-scrim {
			display: block;
			position: absolute;
			inset: 0;
			z-index: 2;
			border: none;
			background: rgba(15, 15, 15, .35);
		}
	}

	@media (max-width: 575px) {
		.dc--section { border-radius: 18px; }
		.dc-main__download span { display: none; }
		.dc-login { padding: 30px 20px; }
		.dc-login__row { flex-direction: column; }
		.dc-msg { max-width: 90%; }
	}
</style>

---
import { cities, cityLandingUrl, fuelLandingUrl, chatAppUrl } from '../../lib/cities';
import { chatFuels } from '../../data/chatCluster';
---

<section class="chat-cities-section py-5 bg-section">
	<div class="container">
		<div class="row section-row">
			<div class="col-lg-12">
				<div class="section-title section-title-center">
					<span class="section-sub-title">Города чата</span>
					<h2>Выберите свой город</h2>
					<p>Я запустил локальные чаты в крупнейших городах региона. Выбирайте свой, чтобы видеть самую актуальную информацию о наличии топлива и очередях на АЗС рядом с вами.</p>
				</div>
			</div>
		</div>

		<div class="row">
			{
				cities.map((city, index) => (
					<div class="col-xl-4 col-md-6 mb-4">
						<div class="service-item wow fadeInUp" data-wow-delay={`${index * 0.1}s`}>
							<div class="icon-box">
								<img src="/images/icon-location-primary.svg" alt={city.name} />
							</div>
							<div class="service-item-body">
								<div class="service-item-content">
									<h2><a href={cityLandingUrl(city.slug)}>{city.name}</a></h2>
									<p>{city.hint}</p>
								</div>
								
								<div class="service-item-btn mt-3">
									<div class="fuel-links-grid">
										{chatFuels.map(fuel => (
											<a href={fuelLandingUrl(city.slug, fuel.slug)} class="fuel-link-item">
												<i class={`fa-solid ${fuel.icon}`}></i>
                                                <span>{fuel.name}</span>
											</a>
										))}
									</div>
                                    <div class="mt-3">
                                        <a href={cityLandingUrl(city.slug)} class="readmore-btn">
                                            Перейти в чат
                                        </a>
                                    </div>
								</div>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
    .service-item-content h2 {
        font-size: 22px;
        margin-bottom: 10px;
        font-weight: 700;
    }
    .service-item-content h2 a {
        color: var(--primary-color);
        text-decoration: none;
        transition: all 0.3s;
    }
    .service-item-content h2 a:hover {
        color: var(--accent-color);
    }
    .fuel-links-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }
    .fuel-link-item {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px;
        background: #f8f9fa;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        color: var(--primary-color);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid #eee;
    }
    .fuel-link-item i {
        font-size: 14px;
        color: var(--accent-color);
    }
    .fuel-link-item:hover {
        background: var(--primary-color);
        color: var(--white-color);
        border-color: var(--primary-color);
    }
    .fuel-link-item:hover i {
        color: var(--accent-color);
    }
    .readmore-btn {
        display: inline-flex;
        align-items: center;
        color: var(--primary-color);
        font-weight: 600;
        text-decoration: none;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    /* В шаблоне readmore-btn обычно имеет стрелочку, добавлю её если её нет в CSS */
    .readmore-btn::after {
        content: "\f178";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        margin-left: 8px;
        transition: all 0.3s;
    }
    .readmore-btn:hover::after {
        margin-left: 12px;
    }
</style>

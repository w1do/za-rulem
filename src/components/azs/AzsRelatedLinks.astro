---
import { azsRankingUrl, type RankingKind } from '../../features/gas-station-rankings';
import { getCityUrl, type ChatCity } from '../../lib/cities';

interface Props {
	city: ChatCity;
	kind: RankingKind;
}

const { city, kind } = Astro.props;
const otherKind: RankingKind = kind === 'cheapest' ? 'expensive' : 'cheapest';
const otherLabel = otherKind === 'cheapest' ? 'Дешёвые заправки' : 'Дорогие заправки';
const links = [
	{
		icon: '/images/icon-service-1.svg',
		title: otherLabel,
		text: 'Сравните противоположную часть ценового диапазона по тем же видам топлива и адресам.',
		href: azsRankingUrl(city.slug, otherKind),
	},
	{
		icon: '/images/icon-service-2.svg',
		title: 'Все цены и карта АЗС',
		text: 'Откройте полный городской мониторинг с картой, сетями и свежими ценами на топливо.',
		href: getCityUrl('/ceny-na-benzin', city.slug),
	},
	{
		icon: '/images/icon-service-3.svg',
		title: 'Очереди на заправках',
		text: 'Проверьте свежие отметки об очередях и доступных АЗС перед поездкой.',
		href: getCityUrl('/ochered-na-azs', city.slug),
	},
];
---

<!-- page Services Start -->
<div class="page-services bg-section" aria-labelledby="azs-related-title">
	<div class="container">
		<div class="row section-row">
			<div class="col-xl-12">
				<div class="section-title section-title-center">
					<span class="section-sub-title">Проверка перед поездкой</span>
					<h2 id="azs-related-title">Другие данные об АЗС {city.inCity}</h2>
				</div>
			</div>
		</div>
		<div class="row">
			{links.map((link, index) => (
				<div class="col-xl-4 col-md-6">
					<div class="service-item wow fadeInUp" data-wow-delay={`${index * 0.2}s`}>
						<div class="icon-box"><img src={link.icon} alt="" width="50" height="50" /></div>
						<div class="service-item-body">
							<div class="service-item-content">
								<h2><a href={link.href}>{link.title}</a></h2>
								<p>{link.text}</p>
							</div>
							<div class="service-item-btn"><a href={link.href} class="readmore-btn">Открыть</a></div>
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</div>
<!-- page Services End -->

---
import { getCityBySlug, replaceCityPlaceholders, getCityUrl } from '../../lib/city';
import type { ChatCity } from '../../lib/cities/types';
import AppImage from '../shared/ui/AppImage.astro';
import { chatAppUrl } from '../../data/cities';

import author1 from '../../assets/images/author-1.jpg';
import author2 from '../../assets/images/author-2.jpg';
import author3 from '../../assets/images/author-3.jpg';
import author4 from '../../assets/images/author-4.jpg';

interface HeroBenefit {
	icon: string;
	title: string;
	text: string;
}

interface Props {
	city?: ChatCity;
	subtitle?: string;
	title?: string;
	description?: string;
	ctaText?: string;
	ctaHref?: string;
	reviewText?: string;
	counterValue?: string;
	counterText?: string;
	benefits?: HeroBenefit[];
}

const {
	city: propCity,
	subtitle: propSubtitle,
	title: propTitle,
	description: propDescription,
	ctaText = 'Вызвать помощь',
	ctaHref: propCtaHref,
	reviewText: propReviewText,
	counterValue = '6',
	counterText: propCounterText,
	benefits: propBenefits,
} = Astro.props;

const city = propCity ?? getCityBySlug();

const subtitle = propSubtitle ?? replaceCityPlaceholders('Техпомощь на дороге {inCity} 24/7', city);
const title = propTitle ?? replaceCityPlaceholders('Срочная автопомощь на дороге {inCity} с выездом', city);
const description =
	propDescription ??
	replaceCityPlaceholders(
		'Приеду за 20–40 минут и заведу вашу машину: прикурю авто, заменю аккумулятор с выездом, отогрею двигатель, вскрою салон, привезу топливо или подам эвакуатор. Работаю круглосуточно по {inCity}. Выезд только по заявке на сайте.',
		city,
	);
const ctaHref = propCtaHref ?? getCityUrl('/contacts', city.slug);
const reviewText = propReviewText ?? replaceCityPlaceholders('Круглосуточно на связи с водителями {ofCity}', city);
const counterText =
	propCounterText ??
	'Шесть видов техпомощи на дороге — приеду с готовым оборудованием и решу проблему на месте.';

const benefits = propBenefits ?? [
	{
		icon: '/images/icon-hero-info-list-1-gold.svg',
		title: '01. Оставьте заявку',
		text: 'Опишите поломку в форме — подскажу решение и назову цену до выезда.',
	},
	{
		icon: '/images/icon-hero-info-list-2-gold.svg',
		title: '02. Я выезжаю',
		text: replaceCityPlaceholders('Уточню адрес {inCity} и сразу выезжаю к вам с нужным оборудованием.', city),
	},
	{
		icon: '/images/icon-hero-info-list-3-gold.svg',
		title: '03. Завожу на месте',
		text: 'Прикурю авто, заменю аккумулятор или подам эвакуатор, если ремонт на месте невозможен.',
	},
];
---

    <!-- Hero Section Start -->
    <div class="hero-gold dark-section parallaxie">
        <div class="container">
            <div class="row">
                <div class="col-xl-8">
                    <!-- Hero Content Start -->
                    <div class="hero-content-gold">
                        <!-- Section Title Start -->
                        <div class="section-title">
                            <span class="section-sub-title wow fadeInUp">{subtitle}</span>
                            <h1 class="text-anime-style-3" data-cursor="-opaque">{title}</h1>
                            <p class="wow fadeInUp" data-wow-delay="0.2s">{description}</p>
                        </div>
                        <!-- Section Title End -->
                        
                        <!-- Hero Content Button Start -->
                        <div class="hero-content-btn-gold wow fadeInUp" data-wow-delay="0.4s">
                            <a
								href={ctaHref}
								class="btn-default btn-highlighted"
								data-service-request
								data-service-title={ctaText}
							>
								{ctaText}
							</a>
							<a href={chatAppUrl(city.slug)} class="btn-default">
								Перейти в чат
							</a>
                        </div>
                        <!-- Hero Content Button End -->
                    </div>
                    <!-- Hero Content End -->
                </div>

                <div class="col-xl-4">
                    <!-- Hero Info Client Box Start -->
                    <div class="hero-info-client-box-gold wow fadeInUp">
                        <!-- Hero Client Review Box Start -->
                        <div class="hero-client-review-box-gold">
                            <!-- Hero Client Review Counter Start -->
                            <div class="hero-client-review-counter-gold">
                                <p>{reviewText}</p>
                            </div>
                            <!-- Hero Client Review Counter End -->

                            <!-- Satisfy Client Images Start -->
                            <div class="satisfy-client-images">
                                <div class="satisfy-client-image">
                                    <figure class="image-anime">
                                        <AppImage src={author1} alt="Водитель 1" width={60} height={60} />
                                    </figure>
                                </div>
                                <div class="satisfy-client-image">
                                    <figure class="image-anime">
                                        <AppImage src={author2} alt="Водитель 2" width={60} height={60} />
                                    </figure>
                                </div>
                                <div class="satisfy-client-image">
                                    <figure class="image-anime">
                                        <AppImage src={author3} alt="Водитель 3" width={60} height={60} />
                                    </figure>
                                </div>
                                <div class="satisfy-client-image">
                                    <figure class="image-anime">
                                        <AppImage src={author4} alt="Водитель 4" width={60} height={60} />
                                    </figure>
                                </div>
                            </div>
                            <!-- Satisfy Client Images End -->
                        </div>
                        <!-- Hero Client Review Box End -->

                        <!-- Hero Client Counter Box Start -->
                        <div class="hero-client-counter-box-gold">
                            <h2><span class="counter">{counterValue}</span>+</h2>
                            <p>{counterText}</p>
                        </div>
                        <!-- Hero Client Counter Box End -->
                    </div>
                    <!-- Hero Info Client Box End -->
                </div>

                <div class="col-lg-12">
                    <!-- Hero Benefit Item List Start -->
                    <div class="hero-benefit-item-list-gold">
                        {benefits.map((item, index) => (
                        <div class="hero-benefit-item-gold wow fadeInUp" data-wow-delay={index === 0 ? undefined : `${index * 0.2}s`}>
                            <div class="icon-box">
                                <img src={item.icon} alt="" width="60" height="60" />
                            </div>
                            <div class="hero-benefit-item-content-gold">
                                <h3>{item.title}</h3>
                                <p>{item.text}</p>
                            </div>
                        </div>
                        ))}
                    </div>
                    <!-- Hero Benefit Item List End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Hero Section End -->

<style>
	.hero-content-btn-gold {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
	}

	@media (max-width: 767px) {
		.hero-content-btn-gold {
			gap: 15px;
		}
	}
</style>

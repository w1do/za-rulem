---
import { type ChatCity } from '../../data/cities';
import { getCityBySlug, replaceCityPlaceholders, getCityUrl } from '../../lib/city';
import AppImage from '../shared/ui/AppImage.astro';

import fleet1 from '../../assets/images/fleets-image-1.jpg';
import fleet2 from '../../assets/images/fleets-image-2.jpg';
import fleet3 from '../../assets/images/fleets-image-3.jpg';
import fleet4 from '../../assets/images/fleets-image-4.jpg';
import fleet5 from '../../assets/images/fleets-image-5.jpg';
import author1 from '../../assets/images/author-1.jpg';

interface FleetSlide {
	image: any;
	alt?: string;
	cursor?: string;
	label: string;
	price: string;
	priceUnit?: string;
	/** Мелкая пометка под ценой (напр. минимум за выезд) */
	priceNote?: string;
	amenities: string[];
	href: string;
}

interface Props {
	city?: ChatCity;
	subtitle?: string;
	title?: string;
	slides?: FleetSlide[];
	footerText?: string;
	footerLinkText?: string;
	footerLinkHref?: string;
}

const amenityIcons = ['/images/icon-amenity-item-1.svg', '/images/icon-amenity-item-2.svg'];

const {
	city: propCity,
	subtitle = 'Направления выезда',
	title: propTitle,
	slides: propSlides,
	footerText = 'Собрал все услуги техпомощи на дороге —',
	footerLinkText = 'посмотреть все услуги',
	footerLinkHref: propFooterLinkHref,
} = Astro.props;

const city = propCity ?? getCityBySlug();

const title = propTitle ?? replaceCityPlaceholders('Чем помогу на дороге {inCity}', city);
const footerLinkHref = propFooterLinkHref ?? getCityUrl('/services', city.slug);

const slides = propSlides ?? [
	{
		image: fleet1,
		cursor: 'Замена аккумулятора',
		label: 'Замена аккумулятора',
		price: 'от 5 500 ₽',
		priceUnit: '/выезд',
		amenities: ['Привезу батарею', 'Установлю на месте'],
		href: getCityUrl('/services/tehpomosch/zamena-akkumulyatora', city.slug),
	},
	{
		image: fleet2,
		cursor: 'Отогрев авто',
		label: 'Отогрев авто',
		price: 'от 5 500 ₽',
		priceUnit: '/выезд',
		amenities: ['Отогрею двигатель', 'Заведу на месте'],
		href: getCityUrl('/services/tehpomosch/otogrev-avto', city.slug),
	},
	{
		image: fleet3,
		cursor: 'Автоэлектрик и диагностика',
		label: 'Автоэлектрик и диагностика',
		price: 'от 5 500 ₽',
		priceUnit: '/выезд',
		amenities: ['Найду причину поломки', 'Проверю электрику авто'],
		href: getCityUrl('/services/tehpomosch', city.slug),
	},
	{
		image: fleet4,
		cursor: 'Подвоз топлива',
		label: 'Подвоз топлива',
		price: 'от 6 500 ₽',
		priceUnit: '/выезд',
		priceNote: 'включено 20 л',
		amenities: ['20 л бензина включено', 'АИ-92, АИ-95 и дизель'],
		href: getCityUrl('/services/toplivo', city.slug),
	},
	{
		image: fleet5,
		cursor: 'Вызвать эвакуатор',
		label: 'Эвакуатор',
		price: 'от 5 500 ₽',
		priceUnit: '/выезд',
		amenities: ['Погружу автомобиль', 'Доставлю по адресу'],
		href: getCityUrl('/services/tehpomosch', city.slug),
	},
	{
		image: fleet1,
		cursor: 'Прикурить авто',
		label: 'Прикурить авто',
		price: 'от 5 500 ₽',
		priceUnit: '/выезд',
		amenities: ['Подам питание', 'Запущу двигатель'],
		href: getCityUrl('/services/tehpomosch/prikurit-avto', city.slug),
	},
];
---

    <!-- Our Fleets Section Start -->
    <div class="our-fleets bg-section">
        <div class="container">
            <div class="row section-row">
                <div class="col-xl-12">
                    <!-- Section Title Start -->
                    <div class="section-title section-title-center">
                        <span class="section-sub-title wow fadeInUp">{subtitle}</span>
                        <h2 class="text-anime-style-3" data-cursor="-opaque">{title}</h2>
                    </div>
                    <!-- Section Title End -->
                </div>
            </div>

            <div class="row">
                <div class="col-lg-12">
                    <!-- Fleets Slider Start -->
                    <div class="fleets-slider wow fadeInUp" data-wow-delay="0.2s">
                        <div class="swiper">
                            <div class="swiper-wrapper">
                                {slides.map((slide) => (
                                <div class="swiper-slide">
                                    <div class="fleets-item">
                                        <!-- Fleets Item Image Start -->
                                        <div class="fleets-item-image">
                                            <a href={slide.href} data-cursor-text={slide.cursor}>
                                                <figure>
                                                    <AppImage src={slide.image} alt={slide.alt ?? slide.label} width={600} height={400} />
                                                </figure>
                                            </a>
                                        </div>
                                        <!-- Fleets Item Image End -->

                                        <!-- Fleets Item Button Start -->
                                        <div class="fleets-item-btn">
                                            <a href={slide.href}><img src="/images/arrow-primary.svg" alt="Подробнее" width="24" height="24" /></a>
                                        </div>
                                        <!-- Project Item Button End -->

                                        <!-- Fleets Item Body Start -->
                                        <div class="fleets-item-body">
                                            <!-- Fleets Item Content Start -->
                                            <div class="fleets-item-content">
                                                <p>{slide.label}</p>
                                                <h2>
                                                    {slide.price} {slide.priceUnit && <sub>{slide.priceUnit}</sub>}
                                                    {(slide.priceNote || /₽\/л|\/л|\/литр/i.test(`${slide.price}${slide.priceUnit ?? ''}`)) && (
                                                        <span class="price-min-note">{slide.priceNote ?? 'выезд 80 руб/км'}</span>
                                                    )}
                                                </h2>
                                            </div>
                                            <!-- Fleets Item Content End -->

                                            <!-- Fleets Amenity Item List Start -->
                                            <div class="fleets-amenity-item-list">
                                                <ul>
                                                    {slide.amenities.map((amenity, index) => (
                                                    <li class={/(от|до)\s*20\s*л/i.test(amenity) ? 'price-volume-highlight' : undefined}>
                                                        <img src={amenityIcons[index] ?? amenityIcons[0]} alt="Опция" width="24" height="24" />
                                                        {amenity}
                                                    </li>
                                                    ))}
                                                </ul>
                                            </div>
                                            <!-- Fleets Amenity Item List End -->
                                        </div>
                                        <!-- Fleets Item Header Box End -->
                                    </div>
                                </div>
                                ))}
                            </div>
                            <div class="fleets-pagination"></div>
                        </div>
                    </div>
                    <!-- Fleets Slider End -->
                </div>

                <div class="col-lg-12">
                    <!-- Section Footer Text Start -->
                    <div class="section-footer-text section-satisfy-img wow fadeInUp" data-wow-delay="0.2s">
                        <!-- Satisfy Client Images Start -->
                        <div class="satisfy-client-images">
                            <div class="satisfy-client-image">
                                <figure class="image-anime">
                                    <AppImage src={author1} alt="Водитель" width={60} height={60} />
                                </figure>
                            </div>
                            <div class="satisfy-client-image add-more">
                                <img src="/images/icon-phone-primary.svg" alt="Телефон" width="24" height="24">
                            </div>
                        </div>
                        <!-- Satisfy Client Images End -->    
                        <p>{footerText} <a href={footerLinkHref}>{footerLinkText}</a></p>
                    </div>
                    <!-- Section Footer Text End -->
                </div>
            </div>
        </div>
    </div>
    <!-- Our Fleets Section End -->

---
import GasMap, { type GasMapMode } from '../maps/GasMap.tsx';
import type { MapBounds, StationData } from '../../lib/gasStations';

interface Props {
	stations: StationData[];
	bounds: MapBounds;
	/** Ссылка на чат города для кнопки в подсказке АЗС. */
	chatUrl: string;
	/** Slug города для обновления станций из `gas_daily`. */
	citySlug: string;
	/** Сценарий карты: городской лендинг чата или хаб цен на бензин. */
	mode?: GasMapMode;
	/** Якорь для ссылок вида «Показать на карте». */
	id?: string;
}

const { stations, bounds, chatUrl, citySlug, mode = 'city', id } = Astro.props;
---

<div class="gas-map-section" id={id}>
	<div class="container">
		<div class="gas-map-card">
			<GasMap
				client:only="react"
				mode={mode}
				initialStations={stations}
				bounds={bounds}
				chatUrl={chatUrl}
				citySlug={citySlug}
			/>
		</div>
	</div>
</div>

<style>
	.gas-map-section {
		width: 100%;
		padding: 80px 0 120px;
	}

	.gas-map-card {
		width: 100%;
		min-height: 750px;
		margin-right: auto;
		margin-left: auto;
		overflow: hidden;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
		border-radius: 20px;
		background: #eee;
	}

	@media (max-width: 767px) {
		.gas-map-section {
			padding: 40px 0 60px;
		}

		.gas-map-card {
			border-right: 0;
			border-left: 0;
			border-radius: 12px;
			min-height: 520px;
			box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);
		}
	}
</style>
---
import GasMap from '../maps/GasMap.tsx';

interface Props {
	stations: unknown[];
	bounds?: {
		minLat: number;
		maxLat: number;
		minLon: number;
		maxLon: number;
	};
}

const { stations, bounds } = Astro.props;
---

<div class="gas-map-section">
	<div class="container">
		<div class="gas-map-card wow fadeInUp">
			<GasMap client:only="react" stations={stations} bounds={bounds} />
		</div>
	</div>
</div>

<style>
	.gas-map-section {
		width: 100%;
		padding: 80px 0 120px;
	}

	.gas-map-card {
		width: 100%;
		margin-right: auto;
		margin-left: auto;
		overflow: hidden;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
		border-radius: 20px;
	}

	@media (max-width: 767px) {
		.gas-map-section {
			padding: 40px 0 60px;
		}

		.gas-map-card {
			border-right: 0;
			border-left: 0;
			border-radius: 12px;
			box-shadow: 0 12px 35px rgba(0, 0, 0, 0.12);
		}
	}
</style>
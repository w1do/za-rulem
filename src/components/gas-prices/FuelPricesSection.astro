---
import FuelPricesTable from './FuelPricesTable';
import { getGasCityPrices } from '../../features/gas-prices/server';
import { defaultCity, type ChatCity } from '../../lib/cities';
import { formatPrice } from '../../features/gas-prices/model/format';

interface Props {
	city?: ChatCity;
	title?: string;
	subtitle?: string;
}

const { 
	city = defaultCity,
	title,
	subtitle = "Сводка по городу"
} = Astro.props;

const priceData = await getGasCityPrices(city.slug);

const prices = priceData.brands.map(brandSummary => {
	const findFuel = (type: string) => brandSummary.fuels.find(f => f.fuelType === type);
	const ai92 = findFuel('AI_92');
	const ai95 = findFuel('AI_95');
	const dt = findFuel('DT');

	return {
		brand: brandSummary.brand.name,
		ai92: ai92 ? formatPrice(ai92.average) : '-',
		ai95: ai95 ? formatPrice(ai95.average) : '-',
		diesel: dt ? formatPrice(dt.average) : '-'
	};
}).filter(p => p.ai92 !== '-' || p.ai95 !== '-' || p.diesel !== '-').slice(0, 10);

const displayTitle = title || `Цены на бензин ${city?.inCity || ''} сегодня`;
---

{prices.length > 0 && (
	<section class="fuel-prices-section py-5">
		<div class="container">
			<div class="section-title text-center mb-5">
				<span class="section-sub-title">{subtitle}</span>
				<h2>{displayTitle}</h2>
				<p>Средние цены на популярных сетях АЗС в городе {city.name}. Точные данные по каждой станции уточняйте в чате водителей.</p>
			</div>
			<FuelPricesTable prices={prices} client:load />
		</div>
	</section>
)}

<style>
	.fuel-prices-section {
		background-color: var(--white-color);
	}
	@media (max-width: 767px) {
		.fuel-prices-section {
			padding: 40px 0 !important;
		}
	}
</style>

---
import FuelPricesTable from './FuelPricesTable';
import { fetchGasStations, getFuelPricesFromStations } from '../../lib/gasStations';
import type { MapBounds, StationData } from '../../lib/gasStations';
import { chatCities, DEFAULT_CITY_SLUG } from '../../data/cities';
import type { ChatCity } from '../../data/cities';

interface Props {
	city?: ChatCity;
	title?: string;
	subtitle?: string;
	stations?: StationData[];
}

const { 
	city = chatCities.find(c => c.slug === DEFAULT_CITY_SLUG),
	title,
	subtitle = "Сводка по городу",
	stations: initialStations
} = Astro.props;

let prices = [];
let stations = initialStations;

if (!stations && city?.bounds) {
	stations = await fetchGasStations(city.bounds);
}

if (stations) {
	prices = getFuelPricesFromStations(stations);
}

// Fallback for default city if API is down or returned no data
if (prices.length === 0 && city?.slug === DEFAULT_CITY_SLUG) {
	prices = [
		{ brand: 'Газпромнефть', ai92: '63.60 ₽', ai95: '69.05 ₽', diesel: '80.80 ₽' },
		{ brand: 'Лукойл', ai92: '65.20 ₽', ai95: '71.40 ₽', diesel: '81.90 ₽' },
		{ brand: 'Роснефть', ai92: '63.50 ₽', ai95: '68.90 ₽', diesel: '80.50 ₽' },
	];
}

const displayTitle = title || `Цены на бензин ${city?.inCity || ''} сегодня`;
---

{prices.length > 0 && (
	<section class="fuel-prices-section py-5">
		<div class="container">
			<div class="section-title text-center mb-5">
				<span class="section-sub-title">{subtitle}</span>
				<h2>{displayTitle}</h2>
				<p>Средние цены на популярных сетях АЗС. Точные данные смотрите на карте ниже или уточняйте в чате.</p>
			</div>
			<FuelPricesTable prices={prices} client:load />
		</div>
	</section>
)}

<style>
	.fuel-prices-section {
		background-color: var(--white-color);
	}
	@media (max-width: 767px) {
		.fuel-prices-section {
			padding: 40px 0 !important;
		}
	}
</style>

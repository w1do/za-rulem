---
import AppImage from '../shared/ui/AppImage.astro';

import aboutImg from '../../assets/images/about-us-image.jpg';
import aboutVideoImg from '../../assets/images/about-us-video-image.jpg';
import author1 from '../../assets/images/author-1.jpg';
import author2 from '../../assets/images/author-2.jpg';
import author3 from '../../assets/images/author-3.jpg';

---

<!-- About Us Section Start -->
<div class="about-us">
	<div class="container">
		<div class="row">
			<div class="col-xl-6">
				<!-- About Us Image Box Start -->
				<div class="about-us-image-box wow fadeInUp">
					<!-- About Us Image Start -->
					<div class="about-us-image">
						<figure class="image-anime">
							<AppImage src={aboutImg} alt="Помощь водителям на дороге" />
						</figure>
					</div>
					<!-- About Us Image End -->

					<!-- About Us Video Box Start -->
					<div class="about-us-video-box">
						<!-- About Us Video Start -->
						<div class="about-us-video">
							<figure class="image-anime">
								<AppImage src={aboutVideoImg} alt="Круглосуточная автопомощь" />
							</figure>
							<div class="video-play-button">
								<a href="https://www.youtube.com/watch?v=Y-x0efG1seA" class="popup-video bg-effect" data-cursor-text="Смотреть">
									<i class="fa-solid fa-play"></i>
								</a>
							</div>
						</div>
						<!-- About Us Video End -->

						<!-- About Us Video Box Content Start -->
						<div class="about-us-video-box-content">
							<!--  Satisfaction Client Image Start -->
							<div class="satisfy-client-images">
								<div class="satisfy-client-image">
									<figure class="image-anime">
										<AppImage src={author1} alt="Отзыв о техпомощи" width={60} height={60} />
									</figure>
								</div>
								<div class="satisfy-client-image">
									<figure class="image-anime">
										<AppImage src={author2} alt="Отзыв о техпомощи" width={60} height={60} />
									</figure>
								</div>
								<div class="satisfy-client-image">
									<figure class="image-anime">
										<AppImage src={author3} alt="Отзыв о техпомощи" width={60} height={60} />
									</figure>
								</div>
								<div class="satisfy-client-image add-more">
									<h2><span class="counter">24</span>/7</h2>
								</div>
							</div>
							<!-- Satisfaction Client  Image End -->

							<!--About Satisfy Client Title Start -->
							<div class="about-satisfy-client-title">
								<p>Работаю круглосуточно</p>
							</div>
							<!--About Satisfy Client Title End -->
						</div>
						<!-- About Us Video Box Content End -->
					</div>
					<!-- About Us Video Box End -->
				</div>
				<!-- About Us Image Box End -->
			</div>

			<div class="col-xl-6">
				<!-- About Us Content Start -->
				<div class="about-us-content">
					<!-- Section Title Start -->
					<div class="section-title">
						<span class="section-sub-title wow fadeInUp">О сервисе</span>
						<h2 class="text-anime-style-3" data-cursor="-opaque">Помогаем найти решение дорожной проблемы</h2>
						<p class="wow fadeInUp" data-wow-delay="0.2s">Сервис принимает заявки водителей, уточняет местоположение и задачу, а затем помогает найти доступного исполнителя. Возможность, срок и стоимость выезда подтверждаются после поиска.</p>
					</div>
					<!-- Section Title End -->

					<!-- About Us Body Start -->
					<div class="about-us-body">
						<!-- About Us Body Item Start -->
						<div class="about-us-body-item wow fadeInUp" data-wow-delay="0.4s">
							<div class="icon-box">
								<img src="/images/icon-about-body-item-1.svg" alt="Выезд на помощь" width="60" height="60" />
							</div>
							<div class="about-us-body-item-content">
								<h3>Поиск помощи по заявке</h3>
								<p>Передаём исполнителю местоположение и описание ситуации, чтобы он оценил возможность выезда.</p>
							</div>
						</div>
						<!-- About Us Body Item End -->

						<!-- About Us Body Item Start -->
						<div class="about-us-body-item wow fadeInUp" data-wow-delay="0.6s">
							<div class="icon-box">
								<img src="/images/icon-about-body-item-2.svg" alt="Круглосуточная работа" width="60" height="60" />
							</div>
							<div class="about-us-body-item-content">
								<h3>Заявки круглосуточно</h3>
								<p>Форму можно заполнить в любое время; фактическая доступность исполнителя проверяется отдельно.</p>
							</div>
						</div>
						<!-- About Us Body Item End -->
					</div>
					<!-- About Us Body End -->

					<!-- About Us Footer Start -->
					<div class="about-us-footer wow fadeInUp" data-wow-delay="0.8s">
						<!-- About Us Button Start -->
						<div class="about-us-btn">
							<a
								href="/contacts"
								class="btn-default"
								data-service-request
								data-service-title="Вызвать помощь"
							>
								Вызвать помощь
							</a>
						</div>
						<!-- About Us Button End -->

						<!-- About Us Author Box Start -->
						<div class="about-us-author-box">
							<!-- About Author Image Start -->
							<div class="about-us-author-image">
								<figure class="image-anime">
									<AppImage src={author1} alt="Мастер За рулём" width={60} height={60} />
								</figure>
							</div>
							<!-- About Author Image End -->

							<!-- About Author Content Start -->
							<div class="about-us-author-content">
								<h3>За рулём</h3>
								<p>Сервис помощи водителям</p>
							</div>
							<!-- About Author Content End -->
						</div>
						<!-- About Us Author Box End -->
					</div>
					<!-- About Us Footer End -->
				</div>
				<!-- About Us Content End -->
			</div>
		</div>
	</div>
</div>
<!-- About Us Section End -->

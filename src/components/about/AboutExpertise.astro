---
import { defaultCity, replaceCityPlaceholders, getCityUrl } from '../../lib/cities';
import type { ChatCity } from '../../lib/cities';

interface Props {
	city?: ChatCity;
}

const { city: propCity } = Astro.props;
const city = propCity ?? defaultCity;
---

<!-- Our Expertise Section Start -->
<div class="our-expertise">
	<div class="container">
		<div class="row">
			<div class="col-xl-6">
				<!-- Expertise Image Box Start -->
				<div class="expertise-image-box wow fadeInUp">
					<!-- Expertise Image Start -->
					<div class="expertise-image">
						<figure class="image-anime">
							<img src="/images/expertise-image.jpg" alt={replaceCityPlaceholders("Опыт техпомощи на дороге {inCity}", city)} />
						</figure>
					</div>
					<!-- Expertise Image End -->

					<!-- Expertise Contact Info Start -->
					<div class="expertise-contact-info">
						<div class="expertise-contact-title">
							<h2>Оставьте заявку — приеду на помощь и заведу автомобиль</h2>
						</div>
						<div class="expertise-contact-btn">
							<a href={getCityUrl("/contacts", city.slug)} data-service-request data-service-title="Вызвать помощь">Вызвать помощь</a>
						</div>
					</div>
					<!-- Expertise Contact Info End -->
				</div>
				<!-- Expertise Image Box End -->
			</div>

			<div class="col-xl-6">
				<!-- Expertise Content Start -->
				<div class="expertise-content-box">
					<!-- Section Title Start -->
					<div class="section-title">
						<span class="section-sub-title wow fadeInUp">Мой опыт</span>
						<h2 class="text-anime-style-3" data-cursor="-opaque">Мой опыт в надёжной техпомощи на дороге</h2>
						<p class="wow fadeInUp" data-wow-delay="0.2s">{replaceCityPlaceholders("Мой опыт выездной техпомощи помогает быстро понять причину поломки и безопасно вернуть автомобиль в движение {inCity} и области.", city)}</p>
					</div>
					<!-- Section Title End -->

					<!-- Expertise Skill List Start -->
					<div class="expertise-skill-item-list">
						<!-- Skills Progress Bar Start -->
						<div class="skills-progress-bar">
							<!-- Skill Item Start -->
							<div class="skillbar" data-percent="95%">
								<div class="skill-data">
									<div class="skill-title">Надёжность</div>
									<div class="skill-no">95%</div>
								</div>
								<div class="skill-progress">
									<div class="count-bar"></div>
								</div>
							</div>
							<!-- Skill Item End -->
						</div>
						<!-- Skills Progress Bar End -->

						<!-- Skills Progress Bar Start -->
						<div class="skills-progress-bar">
							<!-- Skill Item Start -->
							<div class="skillbar" data-percent="98%">
								<div class="skill-data">
									<div class="skill-title">Безопасность</div>
									<div class="skill-no">98%</div>
								</div>
								<div class="skill-progress">
									<div class="count-bar"></div>
								</div>
							</div>
							<!-- Skill Item End -->
						</div>
						<!-- Skills Progress Bar End -->

						<!-- Skills Progress Bar Start -->
						<div class="skills-progress-bar">
							<!-- Skill Item Start -->
							<div class="skillbar" data-percent="90%">
								<div class="skill-data">
									<div class="skill-title">Скорость выезда</div>
									<div class="skill-no">90%</div>
								</div>
								<div class="skill-progress">
									<div class="count-bar"></div>
								</div>
							</div>
							<!-- Skill Item End -->
						</div>
						<!-- Skills Progress Bar End -->

						<!-- Skills Progress Bar Start -->
						<div class="skills-progress-bar">
							<!-- Skill Item Start -->
							<div class="skillbar" data-percent="93%">
								<div class="skill-data">
									<div class="skill-title">Аккуратность</div>
									<div class="skill-no">93%</div>
								</div>
								<div class="skill-progress">
									<div class="count-bar"></div>
								</div>
							</div>
							<!-- Skill Item End -->
						</div>
						<!-- Skills Progress Bar End -->
					</div>
					<!-- Expertise Skill List End -->

					<!-- Expertise Button Start -->
					<div class="expertise-btn wow fadeInUp" data-wow-delay="0.4s">
						<a href={getCityUrl("/contacts", city.slug)} class="btn-default">Оставить заявку</a>
					</div>
					<!-- Expertise Button End -->
				</div>
				<!-- Expertise Content End -->
			</div>
		</div>
	</div>
</div>
<!-- Our Expertise Section End -->

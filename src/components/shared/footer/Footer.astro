---
import type { ChatCity } from '../../../lib/cities';
import { defaultCity, getCityUrl, replaceCityPlaceholders } from '../../../lib/cities';
import { getSiteData } from '../../../lib/seo';

export interface Props {
	city?: ChatCity;
	isNational?: boolean;
	nationalVariant?: 'roads' | 'selection' | 'fuel-cards';
	selectionSubject?: string;
	selectionService?: string;
	fuelCardSubject?: string;
	fuelCardService?: string;
}

const {
	city,
	isNational = false,
	nationalVariant = 'roads',
	selectionSubject,
	selectionService,
	fuelCardSubject,
	fuelCardService,
} = Astro.props;
const effectiveCity = city ?? defaultCity;
const site = getSiteData(effectiveCity);
const pageUrl = (path: string): string => isNational ? path : getCityUrl(path, effectiveCity.slug);
const isSelectionNational = isNational && nationalVariant === 'selection';
const isFuelCardsNational = isNational && nationalVariant === 'fuel-cards';
const footerActionHref = pageUrl('/contacts');
const footerRequestService = isSelectionNational
	? selectionService
	: isFuelCardsNational
		? fuelCardService ?? 'fuel-card-catalog'
		: undefined;
const footerRequestSubject = isSelectionNational
	? selectionSubject
	: isFuelCardsNational
		? fuelCardSubject ?? 'Заявка на топливную карту'
		: undefined;

// Общий подвал сайта. Структура перенесена из шаблона, изменены только тексты и ссылки.
const quickLinks = [
	{ label: 'Главная', href: pageUrl('/') },
	{ label: 'О сервисе', href: pageUrl('/about') },
	{ label: 'Услуги', href: pageUrl('/services') },
	{ label: 'Федеральные трассы', href: '/route' },
	{ label: 'Топливные карты', href: '/toplivnye-karty' },
	{ label: 'Отзывы', href: pageUrl('/testimonials') },
	{ label: 'Блог', href: '/blog' },
	{ label: 'Партнёрам', href: pageUrl('/partners') },
	{ label: 'Контакты', href: pageUrl('/contacts') },
];

const serviceLinks = [
	{ label: 'Подбор авто из Владивостока', href: '/podbor-avtomobiley-iz-vladivostoka' },
	{ label: 'Контрактные запчасти', href: '/podbor-kontraktnyh-zapchastey-iz-vladivostoka' },
	{ label: 'Прикурить авто', href: pageUrl('/services/tehpomosch/prikurit-avto') },
	{ label: 'Замена аккумулятора', href: pageUrl('/services/tehpomosch/zamena-akkumulyatora') },
	{ label: 'Отогрев автомобиля', href: pageUrl('/services/tehpomosch/otogrev-avto') },
	{ label: 'Подвоз бензина', href: pageUrl('/services/toplivo/podvoz-benzina') },
	{ label: 'Подвоз дизеля', href: pageUrl('/services/toplivo/podvoz-dizelya') },
	{ label: 'Все услуги', href: pageUrl('/services') },
];
---

<!-- Main Footer Start -->
<div class="main-footer-gold bg-section dark-section">
	<div class="container">
		<div class="row">
			<div class="col-xl-3">
				<!-- About Footer Start -->
				<div class="about-footer-gold">
					<!-- Footer Logo Start -->
					<div class="footer-logo-gold">
						<img src="/images/logo.svg" alt={isNational ? 'За рулём' : site.brand} width="140" height="35" />
					</div>
					<!-- Footer Logo End -->

					<!-- About Footer Content Start -->
					<div class="about-footer-content-gold">
						<p>{isFuelCardsNational ? 'Каталог топливных карт помогает бизнесу сравнивать покрытие АЗС, обслуживание, документы и инструменты контроля расходов.' : isSelectionNational ? 'Подбор автомобилей и контрактных запчастей во Владивостоке с согласованием проверки, покупки и отправки по России.' : isNational ? 'Сервис помогает найти доступную техпомощь или эвакуатор на федеральных трассах России. Возможность и условия выезда подтверждает диспетчер.' : `Я — мастер техпомощи на дороге ${site.inCity}. Приезжаю на вызов круглосуточно: прикурю автомобиль, заменю аккумулятор, отогрею машину в мороз и выручу в других дорожных ситуациях.`}</p>
					</div>
					<!-- About Footer Content End -->

					<!-- Footer Social List Start -->
					<div class="footer-social-links-gold">
						<ul>
							<li><a href="https://vk.com" aria-label="ВКонтакте"><i class="fa-brands fa-vk"></i></a></li>
							<li><a href="https://t.me" aria-label="Telegram"><i class="fa-brands fa-telegram"></i></a></li>
						</ul>
					</div>
					<!-- Footer Social List End -->
				</div>
				<!-- About Footer End -->
			</div>

			<div class="col-xl-9">
				<!-- Footer Links Box Start -->
				<div class="footer-links-box-gold">
					<!-- Footer Link Start -->
					<div class="footer-links-gold footer-quick-links-gold">
						<h2>Навигация</h2>
						<ul>
							{quickLinks.map((link) => (
								<li><a href={link.href}>{link.label}</a></li>
							))}
						</ul>
					</div>
					<!-- Footer Link End -->

					<!-- Footer Link Start -->
					<div class="footer-links-gold footer-service-links-gold">
						<h2>Услуги</h2>
						<ul>
							{serviceLinks.map((link) => (
								<li><a href={link.href}>{link.label}</a></li>
							))}
						</ul>
					</div>
					<!-- Footer Link End -->

					<!-- Footer Link Start -->
					<div class="footer-links-gold footer-contact-box-gold">
						<h2>Контакты</h2>
						<div class="footer-contact-info-list-gold">
							<ul>
								<li>
									<img src="/images/icon-phone-accent.svg" alt="Заявка" width="20" height="20" />
									<a
										href={footerActionHref}
										data-service-request
										data-service-title={isFuelCardsNational ? 'Заказать топливную карту' : isSelectionNational ? 'Голосовая заявка на подбор' : 'Вызвать помощь'}
										data-service-subject={footerRequestSubject}
										data-service={footerRequestService}
									>
										{isFuelCardsNational ? 'Заказать топливную карту' : isSelectionNational ? 'Заявка на подбор' : 'Выезд только по заявке'}
									</a>
								</li>
								<li><img src="/images/icon-location-accent.svg" alt="Адрес" width="20" height="20" />{isFuelCardsNational ? 'Предложения для бизнеса по России' : isSelectionNational ? 'Владивосток — отправка по России' : isNational ? 'Федеральные трассы России, по доступности партнёров' : `${site.addressLocality} и ${site.addressRegion}, выезд 24/7`}</li>
							</ul>
						</div>
					</div>
					<!-- Footer Link End -->

					<!-- Footer Link Start -->
					<div class="footer-links-gold footer-newsletter-form-box-gold">
						<h2>{isFuelCardsNational ? 'Выбираете топливную карту?' : isSelectionNational ? 'Нужен автомобиль или запчасть?' : 'Нужна помощь на дороге?'}</h2>
						<div class="about-footer-content-gold">
							<p>{isFuelCardsNational ? 'Сравните предложения по маршрутам, полной стоимости, документам и возможностям контроля.' : isSelectionNational ? 'Опишите задачу — я уточню параметры подбора и подготовлю порядок работы.' : isNational ? 'Оставьте заявку — диспетчер уточнит участок трассы и проверит доступного партнёра.' : 'Оставьте заявку — перезвоню в течение пары минут и выеду на место.'}</p>
						</div>
						<a
							href={footerActionHref}
							class="btn-default btn-highlighted"
							data-service-request
							data-service-title={isFuelCardsNational ? 'Заказать топливную карту' : isSelectionNational ? 'Голосовая заявка на подбор' : undefined}
							data-service-subject={footerRequestSubject}
							data-service={footerRequestService}
						>
							{isFuelCardsNational ? 'Заказать' : isSelectionNational ? 'Записать голосовую заявку' : 'Оставить заявку'}
						</a>
					</div>
					<!-- Footer Link End -->
				</div>
				<!-- Footer Links Box End -->
			</div>

			<div class="col-xl-12">
				<!-- Footer Copyright Start -->
				<div class="footer-copyright-gold">
					<!-- Footer Copyright Text Start -->
					<div class="footer-copyright-text-gold">
						<p>© 2026 «За рулём» — {isFuelCardsNational ? 'каталог топливных карт для бизнеса' : isSelectionNational ? 'подбор автомобилей и запчастей из Владивостока' : isNational ? 'поиск техпомощи на федеральных трассах' : `техпомощь на дороге ${site.inCity}`}. Разработано <a href="https://w1do.ru" target="_blank" rel="noopener noreferrer">W1DO DIGITAL</a>.</p>
					</div>
					<!-- Footer Copyright Text End -->

					<!-- Footer Privacy Policy Start -->
					<div class="footer-privacy-policy-gold">
						<ul>
						<li><a href={getCityUrl('/privacy-policy', effectiveCity.slug)}>Политика конфиденциальности</a></li>
						<li><a href={getCityUrl('/terms', effectiveCity.slug)}>Условия обслуживания</a></li>
						</ul>
					</div>
					<!-- Footer Privacy Policy End -->
				</div>
				<!-- Footer Copyright End -->
			</div>
		</div>
	</div>
</div>
<!-- Main Footer End -->

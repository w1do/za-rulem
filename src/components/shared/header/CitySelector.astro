---
import { chatCities, type ChatCity } from '../../../data/cities';

interface Props {
	currentCity?: ChatCity;
}

const { currentCity } = Astro.props;
const displayCityName = currentCity?.name || 'Тюмень';
---

<div class="city-selector">
	<button type="button" class="city-selector__button" id="city-selector-trigger" aria-label="Выбрать город">
		<svg width="14" height="18" viewBox="0 0 14 18" fill="none" xmlns="http://www.w3.org/2000/svg">
			<path d="M7 0C3.13 0 0 3.13 0 7C0 12.25 7 18 7 18C7 18 14 12.25 14 7C14 3.13 10.87 0 7 0ZM7 9.5C5.62 9.5 4.5 8.38 4.5 7C4.5 5.62 5.62 4.5 7 4.5C8.38 4.5 9.5 5.62 9.5 7C9.5 8.38 8.38 9.5 7 9.5Z" fill="currentColor"/>
		</svg>
		<span>{displayCityName}</span>
	</button>

	<div class="city-modal" id="city-modal" style="display: none;">
		<div class="city-modal__backdrop" id="city-modal-backdrop"></div>
		<div class="city-modal__content">
			<div class="city-modal__header">
				<h3>Выберите город</h3>
				<button type="button" class="city-modal__close" id="city-modal-close" aria-label="Закрыть">&times;</button>
			</div>
			<div class="city-modal__body">
				<div class="city-modal__grid">
					{[...chatCities].sort((a, b) => a.name.localeCompare(b.name)).map(city => (
						<a 
							href={city.slug === 'tyumen' ? '/' : `/${city.slug}`} 
							class={`city-modal__item ${currentCity?.slug === city.slug ? 'is-active' : ''}`}
							data-city-slug={city.slug}
						>
							{city.name}
						</a>
					))}
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.city-selector {
		display: inline-flex;
		align-items: center;
		margin-right: 20px;
	}

	.city-selector__button {
		display: flex;
		align-items: center;
		gap: 8px;
		background: transparent;
		border: none;
		color: var(--primary-color);
		font-weight: 500;
		cursor: pointer;
		padding: 5px 10px;
		border-radius: 4px;
		transition: background 0.2s;
	}

	.city-selector__button:hover {
		background: rgba(0, 0, 0, 0.05);
	}

	.city-selector__button svg {
		color: var(--accent-color);
	}

	.city-modal {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 10000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 20px;
	}

	.city-modal__backdrop {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(2px);
	}

	.city-modal__content {
		position: relative;
		background: #fff;
		width: 100%;
		max-width: 800px;
		max-height: 80vh;
		border-radius: 12px;
		box-shadow: 0 10px 25px rgba(0,0,0,0.2);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.city-modal__header {
		padding: 20px;
		border-bottom: 1px solid #eee;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.city-modal__header h3 {
		margin: 0;
		font-size: 20px;
	}

	.city-modal__close {
		background: transparent;
		border: none;
		font-size: 28px;
		line-height: 1;
		cursor: pointer;
		color: #999;
	}

	.city-modal__close:hover {
		color: #333;
	}

	.city-modal__body {
		padding: 20px;
		overflow-y: auto;
	}

	.city-modal__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 12px;
	}

	.city-modal__item {
		padding: 8px 12px;
		border-radius: 6px;
		color: #333;
		text-decoration: none;
		font-size: 14px;
		transition: all 0.2s;
		border: 1px solid transparent;
	}

	.city-modal__item:hover {
		background: #f5f5f5;
		color: var(--accent-color);
	}

	.city-modal__item.is-active {
		background: #f0f7ff;
		color: var(--accent-color);
		font-weight: 600;
		border-color: #cce5ff;
	}

	@media (max-width: 768px) {
		.city-modal__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.city-modal__grid {
			grid-template-columns: 1fr;
		}
		
		.city-selector {
			margin-right: 10px;
		}
		
		.city-selector__button span {
			font-size: 13px;
		}
	}
</style>

<script>
	function initCitySelector() {
		const trigger = document.getElementById('city-selector-trigger');
		const modal = document.getElementById('city-modal');
		const closeBtn = document.getElementById('city-modal-close');
		const backdrop = document.getElementById('city-modal-backdrop');
		const cityItems = document.querySelectorAll('.city-modal__item');

		if (!trigger || !modal) return;

		const openModal = () => {
			modal.style.display = 'flex';
			document.body.style.overflow = 'hidden';
		};

		const closeModal = () => {
			modal.style.display = 'none';
			document.body.style.overflow = '';
		};

		trigger.addEventListener('click', openModal);
		closeBtn?.addEventListener('click', closeModal);
		backdrop?.addEventListener('click', closeModal);

		// Handle city selection
		cityItems.forEach(item => {
			item.addEventListener('click', (e) => {
				const slug = (item as HTMLElement).dataset.citySlug;
				if (slug) {
					try {
						if (typeof localStorage !== 'undefined') {
							localStorage.setItem('za-rulem-city', slug);
							window.dispatchEvent(new CustomEvent('city-change', { detail: slug }));
						}
					} catch (e) {
						console.error('Failed to save city to localStorage', e);
					}
				}
			});
		});

		// Check URL and update localStorage
		try {
			const pathParts = window.location.pathname.split('/').filter(Boolean);
			const citiesSlugs = Array.from(cityItems).map(i => (i as HTMLElement).dataset.citySlug);
			if (pathParts.length > 0 && citiesSlugs.includes(pathParts[0])) {
				const urlCity = pathParts[0];
				if (typeof localStorage !== 'undefined') {
					if (localStorage.getItem('za-rulem-city') !== urlCity) {
						localStorage.setItem('za-rulem-city', urlCity);
						window.dispatchEvent(new CustomEvent('city-change', { detail: urlCity }));
					}
				}
			}
		} catch (e) {
			console.error('Failed to sync city from URL', e);
		}
	}

	// Run on initial load
	initCitySelector();
	
	// Run on view transitions if enabled
	document.addEventListener('astro:page-load', initCitySelector);
</script>

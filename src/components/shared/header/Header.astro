---
import HeaderNav from './HeaderNav.astro';
import CitySelector from '../city-selector/CitySelector.astro';
import { defaultCity, type ChatCity } from '../../../lib/cities';

export interface Props {
	city?: ChatCity;
	isNational?: boolean;
}

const { city, isNational = false } = Astro.props;
const effectiveCity = city ?? defaultCity;
---

<!-- Header Start -->
<header class="main-header">
	<div class="header-sticky">
		<nav class="navbar navbar-expand-lg">
			<div class="container">
				{isNational ? <a class="navbar-brand" href="/" aria-label="За рулём — главная"><img src="/images/logo.svg" alt="За рулём" width="140" height="35" /></a> : <CitySelector currentCity={effectiveCity} />}
				
				<!-- Main Menu Start -->
				<HeaderNav city={effectiveCity} isNational={isNational} />
				<!-- Main Menu End -->
				<a
					href="#"
					class="mobile-call-button"
					aria-label="Позвонить"
					title="Позвонить"
					onclick="event.preventDefault(); window.openVoiceRequest && window.openVoiceRequest()"
				>
					<div class="icon-box"><img src="/images/icon-phone-white.svg" alt="Заявка" width="20" height="20" /></div>
				</a>

				<div class="navbar-toggle"></div>
			</div>
		</nav>
		<div class="responsive-menu"></div>
	</div>
</header>
<!-- Header End -->

<style>
	.mobile-call-button {
		display: none;
	}

	@media (max-width: 991px) {
		.mobile-call-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 42px;
			height: 42px;
			margin-left: auto;
			margin-right: 14px;
			border-radius: 50%;
			background: var(--accent-color);
			color: var(--white-color);
			font-size: 16px;
			text-decoration: none;
			transition: background-color 0.3s ease;
		}

		.mobile-call-button:hover,
		.mobile-call-button:focus-visible {
			background: var(--accent-color);
			color: var(--white-color);
		}
	}

	@media (max-width: 374px) {
		.mobile-call-button {
			width: 38px;
			height: 38px;
			margin-right: 8px;
			font-size: 14px;
		}
	}
</style>

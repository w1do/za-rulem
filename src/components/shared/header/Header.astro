---
import HeaderNav from './HeaderNav.astro';
import CitySelector from '../city-selector/CitySelector.astro';
import type { ChatCity } from '../../../data/cities';
import { chatAppUrl } from '../../../data/cities';
import { getCityBySlug, getCityUrl } from '../../../lib/city';
import { getSiteData } from '../../../lib/seo';

export interface Props {
	city?: ChatCity;
}

const { city } = Astro.props;
const effectiveCity = city ?? getCityBySlug();
const site = getSiteData(effectiveCity);
const chatUrl = chatAppUrl(effectiveCity.slug);
---

<!-- Header Start -->
<header class="main-header">
	<div class="header-sticky">
		<nav class="navbar navbar-expand-lg">
			<div class="container">
				<CitySelector currentCity={effectiveCity} />
				
				<!-- Main Menu Start -->
				<HeaderNav city={effectiveCity} />
				<!-- Main Menu End -->
				<a
					href="#"
					class="mobile-call-button"
					aria-label="Позвонить"
					title="Позвонить"
					onclick="event.preventDefault(); window.openVoiceRequest && window.openVoiceRequest()"
				>
					<div class="icon-box"><img src="/images/icon-phone-white.svg" alt="Заявка" width="20" height="20" /></div>
				</a>

				<div class="navbar-toggle"></div>
			</div>
		</nav>
		<div class="responsive-menu"></div>
	</div>
</header>
<!-- Header End -->

<style>
	.header-chat-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		margin-left: auto;
		margin-right: 14px;
		border-radius: 50%;
		background: var(--accent-color);
		color: var(--primary-color);
		font-size: 16px;
		text-decoration: none;
		transition: opacity 0.3s ease;
	}

	.header-chat-button:hover,
	.header-chat-button:focus-visible {
		opacity: 0.85;
		color: var(--primary-color);
	}

	.mobile-call-button {
		display: none;
	}

	@media (max-width: 991px) {
		.header-chat-button {
			margin-right: 12px;
		}

		.mobile-call-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 42px;
			height: 42px;
			margin-left: auto;
			margin-right: 14px;
			border-radius: 50%;
			background: var(--accent-color);
			color: var(--white-color);
			font-size: 16px;
			text-decoration: none;
			transition: background-color 0.3s ease;
		}

		.mobile-call-button:hover,
		.mobile-call-button:focus-visible {
			background: var(--accent-color);
			color: var(--white-color);
		}
	}

	@media (max-width: 374px) {
		.header-chat-button,
		.mobile-call-button {
			width: 38px;
			height: 38px;
			margin-right: 8px;
			font-size: 14px;
		}
	}
</style>

---
import HeaderNav from './HeaderNav.astro';
import CitySelector from './CitySelector.astro';
import type { ChatCity } from '../../../data/cities';
import { getCityUrl } from '../../../lib/city';
import { getSiteData } from '../../../lib/seo';

export interface Props {
	city?: ChatCity;
}

const { city } = Astro.props;
const site = getSiteData(city);
---

<!-- Header Start -->
<header class="main-header">
	<div class="header-sticky">
		<nav class="navbar navbar-expand-lg">
			<div class="container">
				<!-- Logo Start -->
				<a class="navbar-brand" href={getCityUrl('/', city?.slug)}>
					<img src="/images/logo.svg" alt={site.brand} />
				</a>
				<!-- Logo End -->
				
				<CitySelector currentCity={city} />
				
				<!-- Main Menu Start -->
				<HeaderNav city={city} />
				<!-- Main Menu End -->

				<a
					href="#"
					class="mobile-call-button"
					aria-label="Позвонить"
					title="Позвонить"
					onclick="event.preventDefault(); window.openVoiceRequest && window.openVoiceRequest()"
				>
					<div class="icon-box"><img src="/images/icon-phone-white.svg" alt="Заявка" /></div>
				</a>

				<div class="navbar-toggle"></div>
			</div>
		</nav>
		<div class="responsive-menu"></div>
	</div>
</header>
<!-- Header End -->

<style>
	.mobile-call-button {
		display: none;
	}

	@media (max-width: 991px) {
		.mobile-call-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 42px;
			height: 42px;
			margin-left: auto;
			margin-right: 14px;
			border-radius: 50%;
			background: var(--accent-color);
			color: var(--white-color);
			font-size: 16px;
			text-decoration: none;
			transition: background-color 0.3s ease;
		}

		.mobile-call-button:hover,
		.mobile-call-button:focus-visible {
			background: var(--accent-color);
			color: var(--white-color);
		}
	}

	@media (max-width: 374px) {
		.mobile-call-button {
			width: 38px;
			height: 38px;
			margin-right: 8px;
			font-size: 14px;
		}
	}
</style>

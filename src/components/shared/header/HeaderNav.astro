---
import { defaultCity, fuelLandingUrl, getCityUrl, type ChatCity } from '../../../lib/cities';

export interface Props {
	city?: ChatCity;
	isNational?: boolean;
	showRequestButton?: boolean;
}

const { city, isNational = false, showRequestButton = true } = Astro.props;
const pageUrl = (path: string): string => isNational ? path : getCityUrl(path, city?.slug);

// Главное меню сайта. Пункты вынесены в массив для переиспользования и лёгкого расширения.
const menu = [
	{ label: 'Главная', href: pageUrl('/') },
	{
		label: 'Услуги',
		href: pageUrl('/services'),
		children: [
			{ label: 'Подбор авто из Владивостока', href: '/podbor-avtomobiley-iz-vladivostoka' },
			{ label: 'Контрактные запчасти', href: '/podbor-kontraktnyh-zapchastey-iz-vladivostoka' },
			{ label: 'Прикурить авто', href: pageUrl('/services/tehpomosch/prikurit-avto') },
			{ label: 'Замена аккумулятора', href: pageUrl('/services/tehpomosch/zamena-akkumulyatora') },
			{ label: 'Отогрев автомобиля', href: pageUrl('/services/tehpomosch/otogrev-avto') },
			{ label: 'Подвоз топлива', href: pageUrl('/services/toplivo') },
			{ label: 'Автопомощь на карте', href: pageUrl('/avtopomoshch') },
			{ label: 'Занять очередь на АЗС', href: pageUrl('/queue') },
			{ label: 'Калькулятор доставки', href: pageUrl('/calculator') },
		],
	},
	{ label: 'Трассы', href: '/route' },
	{ label: 'Водители', href: pageUrl('/drivers') },
	{ label: 'Отзывы', href: pageUrl('/testimonials') },
	{ label: 'Бензин', href: pageUrl('/ceny-na-benzin') },
	{
		label: 'Чат',
		href: pageUrl('/chat-voditeley'),
		children: [
			{ label: '92', href: fuelLandingUrl(city?.slug ?? defaultCity.slug, 'ai92') },
			{ label: '95', href: fuelLandingUrl(city?.slug ?? defaultCity.slug, 'ai95') },
			{ label: 'ДТ', href: fuelLandingUrl(city?.slug ?? defaultCity.slug, 'dt') },
		],
	},
	{ label: 'Контакты', href: pageUrl('/contacts') },
];
---

<div class="collapse navbar-collapse main-menu">
	<div class="nav-menu-wrapper">
		<ul class="navbar-nav mr-auto" id="menu">
			{
				menu.map((item) =>
					item.children ? (
						<li class="nav-item submenu">
							<a class="nav-link" href={item.href}>
								{item.label}
							</a>
							<ul>
								{item.children.map((child) => (
									<li class="nav-item">
										<a class="nav-link" href={child.href}>
											{child.label}
										</a>
									</li>
								))}
							</ul>
						</li>
					) : (
						<li class="nav-item">
							<a class="nav-link" href={item.href}>
								{item.label}
							</a>
						</li>
					),
				)
			}
		</ul>
	</div>

	<!-- Header Btn Start -->
	{showRequestButton && <div class="header-btn d-flex align-items-center">
		<a
			href="#"
			class="btn-default btn-highlighted"
			onclick="event.preventDefault(); window.openVoiceRequest && window.openVoiceRequest()"
		>
			Позвонить
		</a>
	</div>}
	<!-- Header Btn End -->
</div>

<style>
	@media (max-width: 991px) {
		.header-btn {
			flex-direction: column;
			align-items: flex-start !important;
			padding: 20px 0;
		}
	}
</style>

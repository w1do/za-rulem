---
import { chatCities, cityLandingUrl, type ChatCity } from '../../../data/cities';
import { getCityUrl } from '../../../lib/city';

export interface Props {
	city?: ChatCity;
}

const { city } = Astro.props;

// Главное меню сайта. Пункты вынесены в массив для переиспользования и лёгкого расширения.
const menu = [
	{ label: 'Главная', href: getCityUrl('/', city?.slug) },
	{
		label: 'Услуги',
		href: getCityUrl('/services', city?.slug),
		children: [
			{ label: 'Прикурить авто', href: getCityUrl('/services/tehpomosch/prikurit-avto', city?.slug) },
			{ label: 'Замена аккумулятора', href: getCityUrl('/services/tehpomosch/zamena-akkumulyatora', city?.slug) },
			{ label: 'Отогрев автомобиля', href: getCityUrl('/services/tehpomosch/otogrev-avto', city?.slug) },
			{ label: 'Подвоз топлива', href: getCityUrl('/services/toplivo', city?.slug) },
			{ label: 'Калькулятор доставки', href: getCityUrl('/calculator', city?.slug) },
		],
	},
	{ label: 'Водители', href: getCityUrl('/drivers', city?.slug) },
	{ label: 'Отзывы', href: getCityUrl('/testimonials', city?.slug) },
	{ label: 'Бензин', href: getCityUrl('/ceny-na-benzin', city?.slug) },
	{
		label: 'Чат',
		href: getCityUrl('/chat-voditeley', city?.slug),
		children: chatCities.slice(0, 8).map((c) => ({
			label: c.name,
			href: cityLandingUrl(c.slug),
		})),
	},
	{ label: 'Контакты', href: getCityUrl('/contacts', city?.slug) },
];
---

<div class="collapse navbar-collapse main-menu">
	<div class="nav-menu-wrapper">
		<ul class="navbar-nav mr-auto" id="menu">
			{
				menu.map((item) =>
					item.children ? (
						<li class="nav-item submenu">
							<a class="nav-link" href={item.href}>
								{item.label}
							</a>
							<ul>
								{item.children.map((child) => (
									<li class="nav-item">
										<a class="nav-link" href={child.href}>
											{child.label}
										</a>
									</li>
								))}
							</ul>
						</li>
					) : (
						<li class="nav-item">
							<a class="nav-link" href={item.href}>
								{item.label}
							</a>
						</li>
					),
				)
			}
		</ul>
	</div>

	<!-- Header Btn Start -->
	<div class="header-btn d-flex align-items-center">
		<a
			href="#"
			class="btn-default btn-highlighted"
			onclick="event.preventDefault(); window.openVoiceRequest && window.openVoiceRequest()"
		>
			Позвонить
		</a>
	</div>
	<!-- Header Btn End -->
</div>

<style>
	@media (max-width: 991px) {
		.header-btn {
			flex-direction: column;
			align-items: flex-start !important;
			padding: 20px 0;
		}
	}
</style>

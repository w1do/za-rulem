---
// Главное меню сайта. Пункты вынесены в массив для переиспользования и лёгкого расширения.
const menu = [
	{ label: 'Главная', href: '/' },
	{
		label: 'Услуги',
		href: '/services',
		children: [
			{ label: 'Прикурить авто', href: '/services/tehpomosch/prikurit-avto' },
			{ label: 'Замена аккумулятора', href: '/services/tehpomosch/zamena-akkumulyatora' },
			{ label: 'Отогрев автомобиля', href: '/services/tehpomosch/otogrev-avto' },
			{ label: 'Подвоз топлива', href: '/services/toplivo' }
		],
	},
	{ label: 'Водители', href: '/drivers' },
	{ label: 'Очередь', href: '/queue' },
	{ label: 'Бензин', href: '/ceny-na-benzin' },
	{ label: 'Контакты', href: '/contacts' },
];
---

<div class="collapse navbar-collapse main-menu">
	<div class="nav-menu-wrapper">
		<ul class="navbar-nav mr-auto" id="menu">
			{
				menu.map((item) =>
					item.children ? (
						<li class="nav-item submenu">
							<a class="nav-link" href={item.href}>
								{item.label}
							</a>
							<ul>
								{item.children.map((child) => (
									<li class="nav-item">
										<a class="nav-link" href={child.href}>
											{child.label}
										</a>
									</li>
								))}
							</ul>
						</li>
					) : (
						<li class="nav-item">
							<a class="nav-link" href={item.href}>
								{item.label}
							</a>
						</li>
					),
				)
			}
		</ul>
	</div>

	<!-- Header Btn Start -->
	<div class="header-btn d-flex align-items-center">
		<a
			href="#"
			class="btn-default btn-highlighted"
			onclick="event.preventDefault(); window.openVoiceRequest && window.openVoiceRequest()"
		>
			Позвонить
		</a>
	</div>
	<!-- Header Btn End -->
</div>

<style>
	@media (max-width: 991px) {
		.header-btn {
			flex-direction: column;
			align-items: flex-start !important;
			padding: 20px 0;
		}
	}
</style>

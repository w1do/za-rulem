---
interface Props {
	cityName: string;
	modalId: string;
}

const { cityName, modalId } = Astro.props;
---

<button
	type="button"
	class="city-trigger"
	data-city-trigger
	aria-haspopup="dialog"
	aria-expanded="false"
	aria-controls={modalId}
>
	<span class="city-trigger__icon" aria-hidden="true">
		<i class="fa-solid fa-location-dot"></i>
	</span>
	<span class="city-trigger__text">
		<span class="city-trigger__name">{cityName}</span>
	</span>
	<i class="fa-solid fa-chevron-down city-trigger__arrow" aria-hidden="true"></i>
</button>

<style>
	.city-trigger {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-right: 20px;
		padding: 7px 16px 7px 7px;
		background: var(--white-color);
		border: 1px solid var(--divider-color);
		border-radius: 100px;
		font-family: var(--default-font);
		color: var(--primary-color);
		cursor: pointer;
		transition: all 0.3s ease-in-out;
	}

	.city-trigger:hover,
	.city-trigger:focus-visible {
		border-color: var(--accent-color);
		box-shadow: 0 6px 18px rgba(41, 49, 58, 0.08);
	}

	.city-trigger__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--accent-color);
		color: var(--primary-color);
		font-size: 14px;
	}

	.city-trigger__text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 3px;
		line-height: 1em;
	}

	.city-trigger__name {
		font-size: 12px;
		font-weight: 600;
	}

	.city-trigger__arrow {
		font-size: 11px;
		color: var(--text-color);
		transition: transform 0.3s ease-in-out;
	}

	.city-trigger[aria-expanded='true'] .city-trigger__arrow {
		transform: rotate(180deg);
	}

	@media (max-width: 991px) {
		.city-trigger {
			margin-right: 12px;
		}
	}

	@media (max-width: 575px) {
		.city-trigger {
			gap: 8px;
			padding: 5px 12px 5px 5px;
		}

		.city-trigger__icon {
			width: 28px;
			height: 28px;
			font-size: 12px;
		}

		.city-trigger__name {
			font-size: 11px;
		}
	}
</style>

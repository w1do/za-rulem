---
interface Props {
	label?: string;
	service?: string;
	subject?: string;
	title?: string;
}

const {
	label = 'Вызвать помощь',
	service,
	subject,
	title = 'Вызвать помощь',
} = Astro.props;
---

<div class="page-header-help wow fadeInUp" data-wow-delay="0.2s">
	<a
		href="/contacts"
		class="btn-default btn-highlighted"
		data-service-request
		data-service={service}
		data-service-subject={subject}
		data-service-title={title}
	>
		{label}
	</a>
</div>

<style>
	.page-header-help {
		margin-top: 24px;
		display: inline-block;
	}

	@media (max-width: 767px) {
		.page-header-help {
			margin-top: 20px;
		}
	}
</style>

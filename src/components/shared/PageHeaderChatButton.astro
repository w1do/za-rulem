---
// Кнопка перехода в чат для использования в шапках страниц (page-header parallaxie).
interface Props {
	href?: string;
}

const { href = '/chats' } = Astro.props;
---
<div class="page-header-chat wow fadeInUp" data-wow-delay="0.2s">
	<a
		href={href}
		class="btn-default btn-highlighted"
	>
		Перейти в чат
	</a>
</div>

<style>
	.page-header-chat {
		margin-top: 24px;
		display: inline-block;
		margin-left: 10px;
	}

	@media (max-width: 767px) {
		.page-header-chat {
			margin-top: 20px;
			margin-left: 0;
		}
	}
</style>

---
interface Props {
	class?: string;
	/** Ссылка на чат: по умолчанию общий чат без предвыбранного города. */
	chatHref?: string;
}

const { class: className = '', chatHref = '/chat' } = Astro.props;
---
<div class:list={["dark-section bg-section community-alert", className]}>
	<div class="container-fluid py-4">
		<div class="row align-items-center">
			<div class="col-xl-9 col-lg-8">
				<div class="section-title mb-lg-0">
					<span class="section-sub-title wow fadeInUp" style="color: var(--accent-color);">Сообщество водителей</span>
					<h2 class="text-anime-style-3 mb-2" data-cursor="-opaque" style="color: white; font-size: 28px;">Хотите быть в курсе всех заправок, очередей и наличия бензина?</h2>
					<p class="wow fadeInUp mb-0" data-wow-delay="0.2s" style="color: white; opacity: 0.9;">Вступайте в Telegram и VK группу, давайте развивать сообщество и помогать друг другу в такие непростые времена!</p>
				</div>
			</div>
			<div class="col-xl-3 col-lg-4 text-lg-end mt-4 mt-lg-0">
				<div class="wow fadeInUp" data-wow-delay="0.4s">
					<a href={chatHref} class="btn-default btn-highlighted me-2 mb-2"><i class="fa-solid fa-comments me-2"></i> Перейти в чат</a>
					<a href="https://t.me/zarulem72" class="btn-default btn-highlighted me-2 mb-2"><i class="fa-brands fa-telegram me-2"></i> Telegram</a>
					<a href="https://vk.ru/za_rulem72" class="btn-default btn-white mb-2"><i class="fa-brands fa-vk me-2"></i> VK группа</a>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.community-alert {
		position: relative;
		z-index: 1;
		margin-top: 0 !important;
		margin-bottom: 30px;
	}
	.community-alert .container-fluid {
		padding-top: 60px !important;
		padding-bottom: 80px !important;
		padding-left: 15px !important;
		padding-right: 15px !important;
	}
	@media (min-width: 992px) {
		.community-alert .container-fluid {
			padding-left: 30px !important;
			padding-right: 30px !important;
		}
	}
	@media (min-width: 1200px) {
		.community-alert .container-fluid {
			padding-left: 50px !important;
			padding-right: 50px !important;
		}
	}
	@media (max-width: 767px) {
		.section-title h2 {
			font-size: 22px !important;
		}
		.btn-default {
			width: 100%;
			margin-right: 0 !important;
			margin-bottom: 10px !important;
			display: block;
			text-align: center;
		}
	}
</style>

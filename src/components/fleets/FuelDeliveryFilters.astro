---
import type { ChatCity } from '../../lib/cities';

interface Props {
	city: ChatCity;
	districts: string[];
}

const { city, districts } = Astro.props;
---

<aside class="page-single-sidebar fuel-delivery-sidebar" aria-label="Параметры доставки топлива">
	<div class="fleet-category-item wow fadeInUp">
		<div class="fleets-search-box">
			<div class="form-group">
				<label for="city">Город</label>
				<select class="form-control" id="city">
					<option>{city.name}</option>
				</select>
			</div>
			<div class="form-group">
				<label for="district">Район</label>
				<select class="form-control" id="district">
					<option value="all">Все районы {city.ofCity}</option>
					{districts.map((district) => <option value={district}>{district}</option>)}
				</select>
			</div>
		</div>

		<div class="fleet-category-options">
			<h2 class="fleet-category-options-title">Выберите топливо</h2>
			<ul>
				{[
					['ai92', 'АИ-92'],
					['ai98', 'АИ-98'],
					['ai100', 'АИ-100'],
					['dt', 'ДТ'],
				].map(([value, label]) => (
					<li>
						<input class="form-check-input fuel-filter" type="checkbox" id={value} value={value} checked />
						<label for={value}>{label}</label>
					</li>
				))}
			</ul>
		</div>

		<div class="fleet-category-options">
			<h2 class="fleet-category-options-title">Скорость доставки</h2>
			<ul>
				<li>
					<input class="form-check-input speed-filter" type="radio" name="speed" id="fast" value="fast" checked />
					<label for="fast">Быстро — от 1 часа</label>
				</li>
				<li>
					<input class="form-check-input speed-filter" type="radio" name="speed" id="wait" value="wait" />
					<label for="wait">Могу подождать</label>
				</li>
			</ul>
		</div>

		<div class="fleet-category-options">
			<h2 class="fleet-category-options-title">Причина вызова</h2>
			<ul>
				{[
					['all', 'Любая ситуация'],
					['stalled', 'Заглох на трассе'],
					['empty-tank', 'Закончился бензин'],
					['refueling', 'Срочная дозаправка авто'],
					['highway', 'Топливо на трассу'],
					['country-trip', 'Бензин на дачу или за город'],
				].map(([value, label], index) => (
					<li>
						<input class="form-check-input reason-filter" type="radio" name="reason" id={`reason-${value}`} value={value} checked={index === 0} />
						<label for={`reason-${value}`}>{label}</label>
					</li>
				))}
			</ul>
		</div>

		<div class="fleet-category-btn">
			<a href="#fuel-options" class="btn-default" id="filter-submit">Показать варианты</a>
		</div>
	</div>
</aside>

<style>
	.fuel-delivery-sidebar {
		position: sticky;
		top: 110px;
	}

	.fleets-search-box {
		display: grid;
		gap: 18px;
	}

	.form-group label {
		display: block;
		margin-bottom: 8px;
		font-family: var(--accent-font);
		font-weight: 600;
		color: var(--primary-color);
	}

	.fleet-category-options label {
		flex: 1;
		cursor: pointer;
	}

	.fleet-category-btn .btn-default {
		width: 100%;
		text-align: center;
	}

	@media (max-width: 991px) {
		.fuel-delivery-sidebar {
			position: static;
		}

		.fleets-search-box {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 575px) {
		.fleets-search-box {
			grid-template-columns: 1fr;
		}
	}
</style>

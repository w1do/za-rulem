---
// Обложка статьи (перенос блока "Post Featured Image" из source/blog-single.html).
import ContentImage from '../shared/ui/ContentImage.astro';

const { image, imageAlt } = Astro.props;
---

<!-- Post Featured Image Start -->
<div class="post-image">
	<figure class="image-anime reveal">
		<ContentImage src={image} alt={imageAlt} width={1200} height={600} loading="eager" />
	</figure>
</div>
<!-- Post Featured Image End -->

---
import { SITE, baseGraph, getSiteData } from '../lib/seo';
import VoiceRequestModal from '../components/forms/VoiceRequestModal.tsx';
import type { ChatCity } from '../data/cities';
import '../styles/fonts.css';
import '../styles/main.css';
import criticalStyles from '../styles/critical.css?inline';
import lazyStylesUrl from '../styles/lazy.css?url';
import heroBgUrl from '../assets/images/hero-bg-image-gold.webp?url';

export interface Props {
	title: string;
	description: string;
	ogTitle?: string;
	ogDescription?: string;
	ogImage?: string;
	ogType?: string;
	keywords?: string;
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
	city?: ChatCity;
}

const {
	title,
	description,
	ogTitle,
	ogDescription,
	ogImage = '/images/logo.svg',
	ogType = 'website',
	keywords,
	jsonLd,
	city,
} = Astro.props;

const site = getSiteData(city);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageAbsolute = new URL(ogImage, Astro.site).href;

// Единый граф структурированных данных: базовые узлы (WebSite + LocalBusiness)
// объединяются со страничными узлами, переданными через проп jsonLd.
const pageNodes = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [...baseGraph(city), ...pageNodes],
};
---

<!doctype html>
<html lang="ru">
	<head>
		<!-- Meta -->
		<meta charset="utf-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
		<meta name="theme-color" content="#F5B754" />
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		<meta name="author" content={`${site.name} — техпомощь ${site.addressLocality}`} />

		<!-- Page Title -->
		<title>{title}</title>
		<link rel="canonical" href={canonical} />

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={site.brand} />
		<meta property="og:title" content={ogTitle ?? title} />
		<meta property="og:description" content={ogDescription ?? description} />
		<meta property="og:image" content={ogImageAbsolute} />
		<meta property="og:image:alt" content={ogTitle ?? title} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="ru_RU" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle ?? title} />
		<meta name="twitter:description" content={ogDescription ?? description} />
		<meta name="twitter:image" content={ogImageAbsolute} />

		<!-- Structured Data (JSON-LD / Schema.org) -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

		<script>window.yaContextCb=window.yaContextCb||[]</script>
		<script src="https://yandex.ru/ads/system/context.js" async></script>

		<!-- Favicon Icon -->
		<link rel="shortcut icon" type="image/x-icon" href="/images/favicon.png" />

		<!-- Montserrat Font Preload -->
		<link
			rel="preload"
			href="/fonts/montserrat-normal-cyrillic.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<!-- LCP Hero Background Preload -->
		<link rel="preload" href={heroBgUrl} as="image" type="image/webp" />

		<!-- Critical CSS Inline -->
		<style is:inline set:html={criticalStyles} />

		<!-- Lazy CSS (Non-blocking) -->
		<link rel="preload" href={lazyStylesUrl} as="style" />
		<link rel="stylesheet" href={lazyStylesUrl} media="print" onload="this.media='all'" />
		<noscript><link rel="stylesheet" href={lazyStylesUrl} /></noscript>

		<meta name="generator" content={Astro.generator} />

		<!-- Дополнительные теги <head> для конкретной страницы (напр. PWA-манифест). -->
		<slot name="head" />
	</head>
	<body>
		<!-- Preloader Start -->
		<div class="preloader">
			<div class="loading-container">
				<div class="loading"></div>
				<div id="loading-icon"><img src="/images/loader.svg" alt="Загрузка" /></div>
			</div>
		</div>
		<!-- Preloader End -->

		<slot />

		<div class="cookie-consent" data-cookie-consent hidden>
			<div class="cookie-consent__content">
				<p>Мы принимаем cookie, чтобы сайт работал стабильно, а заявка на помощь отправлялась без сбоев.</p>
				<a href="/privacy-policy" data-skip-service-request>Политика конфиденциальности</a>
			</div>
			<button class="cookie-consent__button" type="button" data-cookie-accept>Принять</button>
		</div>

		<!-- Глобальная универсальная форма заявки -->
		<VoiceRequestModal client:idle />

		<!-- Синхронизация города с URL и localStorage -->
		<script is:inline define:vars={{ citySlug: city?.slug || 'tyumen' }}>
			(function() {
				try {
					const CITY_STORAGE_KEY = 'za-rulem-city';
					if (typeof localStorage !== 'undefined') {
						if (localStorage.getItem(CITY_STORAGE_KEY) !== citySlug) {
							localStorage.setItem(CITY_STORAGE_KEY, citySlug);
							window.dispatchEvent(new CustomEvent('city-change', { detail: citySlug }));
						}
					}
				} catch (e) {
					console.error('City sync failed:', e);
				}

				// Скрытие прелоадера по готовности DOM
				const hidePreloader = function() {
					const preloader = document.querySelector('.preloader');
					if (preloader && preloader.style.display !== 'none') {
						preloader.style.opacity = '0';
						setTimeout(function() { preloader.style.display = 'none'; }, 600);
					}
				};
				window.addEventListener('DOMContentLoaded', hidePreloader);

				// Аварийное скрытие через 5 секунд
				setTimeout(hidePreloader, 5000);
			})();
		</script>

		<!--
			Ранний перехват tel / WhatsApp / CTA «Вызвать помощь» и др.
			Работает до гидрации React-острова и кладёт pending, если модалка ещё не готова.
		-->
		<script is:inline>
			(function () {
				var COOKIE_KEY = 'za-rulem-cookie-accepted';
				var OPEN_EVENT = 'za-rulem:open-service-request';
				var cookieConsent = document.querySelector('[data-cookie-consent]');
				var cookieAccept = document.querySelector('[data-cookie-accept]');

				if (cookieConsent && localStorage.getItem(COOKIE_KEY) !== 'true') {
					cookieConsent.hidden = false;
				}

				if (cookieAccept) {
					cookieAccept.addEventListener('click', function () {
						localStorage.setItem(COOKIE_KEY, 'true');
						if (cookieConsent) cookieConsent.hidden = true;
					});
				}

				function isContactsHref(href) {
					if (!href) return false;
					try {
						var url = new URL(href, window.location.origin);
						var path = url.pathname.replace(/\/+$/, '') || '/';
						return path === '/contacts';
					} catch (e) {
						return href === '/contacts' || /\/contacts\/?(\?|#|$)/.test(href);
					}
				}

				function shouldIntercept(anchor) {
					if (!anchor || !anchor.getAttribute) return false;
					if (anchor.closest && anchor.closest('[data-service-request-modal]')) return false;
					if (anchor.hasAttribute('data-skip-service-request')) return false;

					var href = anchor.getAttribute('href') || '';
					if (href.indexOf('tel:') === 0) return true;
					if (/wa\.me|api\.whatsapp\.com/i.test(href)) return true;
					if (anchor.hasAttribute('data-service-request')) return true;

					var isBtn =
						anchor.classList.contains('btn-default') ||
						anchor.classList.contains('btn-highlighted');
					if (isContactsHref(href) && isBtn) return true;

					var text = (anchor.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();
					if (
						isContactsHref(href) &&
						/(вызвать помощь|заказать доставку|оставить заявку|вызвать эвакуатор)/i.test(text)
					) {
						return true;
					}

					return false;
				}

				function openFromAnchor(anchor) {
					var href = anchor.getAttribute('href') || '';
					var isTel = href.indexOf('tel:') === 0;
					var isWhatsApp = /wa\.me|api\.whatsapp\.com/i.test(href);
					var detail = {
						service: anchor.getAttribute('data-service') || undefined,
						subject:
							anchor.getAttribute('data-service-subject') ||
							(isTel
								? 'Заявка перед звонком — za-rulem'
								: isWhatsApp
									? 'Заявка перед WhatsApp — za-rulem'
									: 'Заявка с CTA — za-rulem'),
						title:
							anchor.getAttribute('data-service-title') ||
							(isTel || isWhatsApp ? 'Сначала заявка — потом звонок' : 'Заявка на выезд'),
					};

					if (typeof window.openServiceRequest === 'function') {
						window.openServiceRequest(detail);
					} else {
						window.__pendingServiceRequest = detail;
						document.dispatchEvent(new CustomEvent(OPEN_EVENT, { detail: detail }));
					}
				}

				document.addEventListener(
					'click',
					function (event) {
						var target = event.target;
						if (!target || !target.closest) return;
						var anchor = target.closest('a');
						if (!shouldIntercept(anchor)) return;
						event.preventDefault();
						event.stopPropagation();
						if (typeof event.stopImmediatePropagation === 'function') {
							event.stopImmediatePropagation();
						}
						openFromAnchor(anchor);
					},
					true,
				);
			})();
		</script>

		<!-- Yandex.Metrika counter -->
		<script type="text/javascript">
			(function() {
				var runYm = function() {
					(function(m,e,t,r,i,k,a){
						m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
						m[i].l=1*new Date();
						for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
						k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
					})(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=108393118', 'ym');

					ym(108393118, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
				};

				if ('requestIdleCallback' in window) {
					requestIdleCallback(runYm);
				} else {
					setTimeout(runYm, 3000);
				}
			})();
		</script>
		<noscript><div><img src="https://mc.yandex.ru/watch/108393118" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
		<!-- /Yandex.Metrika counter -->

		<!-- Yandex.RTB R-A-19681102-1 -->
		<script>
			window.yaContextCb.push(() => {
				Ya.Context.AdvManager.render({
					"blockId": "R-A-19681102-1",
					"type": "fullscreen",
					"platform": "touch"
				})
			})
		</script>

		<!-- Jquery Library File -->
		<script is:inline defer src="/js/jquery-3.7.1.min.js"></script>
		<!-- Circle Progress Js File -->
		<script is:inline defer src="/js/circle-progress.min.js"></script>
		<!-- Bootstrap js file -->
		<script is:inline defer src="/js/bootstrap.min.js"></script>
		<!-- Validator js file -->
		<script is:inline defer src="/js/validator.min.js"></script>
		<!-- SlickNav js file -->
		<script is:inline defer src="/js/jquery.slicknav.js"></script>
		<!-- Swiper js file -->
		<script is:inline defer src="/js/swiper-bundle.min.js"></script>
		<!-- Counter js file -->
		<script is:inline defer src="/js/jquery.waypoints.min.js"></script>
		<script is:inline defer src="/js/jquery.counterup.min.js"></script>
		<!-- Magnific js file -->
		<script is:inline defer src="/js/jquery.magnific-popup.min.js"></script>
		<!-- SmoothScroll -->
		<script is:inline defer src="/js/SmoothScroll.js"></script>
		<!-- Parallax js -->
		<script is:inline defer src="/js/parallaxie.js"></script>
		<!-- MagicCursor js file -->
		<script is:inline defer src="/js/gsap.min.js"></script>
		<script is:inline defer src="/js/magiccursor.js"></script>
		<!-- Text Effect js file -->
		<script is:inline defer src="/js/SplitText.min.js"></script>
		<script is:inline defer src="/js/ScrollTrigger.min.js"></script>
		<!-- YTPlayer js File -->
		<script is:inline defer src="/js/jquery.mb.YTPlayer.min.js"></script>
		<!-- Wow js file -->
		<script is:inline defer src="/js/wow.min.js"></script>
		<!-- Main Custom js file -->
		<script is:inline defer src="/js/function.js"></script>
	</body>
</html>

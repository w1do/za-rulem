---
// Макет хаба услуги — полноценный лендинг (как страница «О сервисе»).
// Принимает frontmatter услуги (pillar) и список её посадочных страниц (spokes)
// и собирает страницу из hub-компонентов. Тело pillar выводится через <slot />.
import Layout from './Layout.astro';
import Header from '../components/shared/header/Header.astro';
import Footer from '../components/shared/footer/Footer.astro';

import HubPageHeader from '../components/hub/HubPageHeader.astro';
import HubIntro from '../components/hub/HubIntro.astro';
import HubServices from '../components/hub/HubServices.astro';
import HubApproach from '../components/hub/HubApproach.astro';
import HubWhyChoose from '../components/hub/HubWhyChoose.astro';
import HubWhatWeDo from '../components/hub/HubWhatWeDo.astro';
import HubProcess from '../components/hub/HubProcess.astro';
import HubPricing from '../components/hub/HubPricing.astro';
import HubCta from '../components/hub/HubCta.astro';
import HubExpertise from '../components/hub/HubExpertise.astro';
import HubFaqs from '../components/hub/HubFaqs.astro';
import HubTestimonials from '../components/hub/HubTestimonials.astro';
import FuelDeliveryCalculator from '../components/calculators/FuelDeliveryCalculator.tsx';
import { serviceNode, breadcrumbNode, faqNode } from '../lib/seo';
import { getCityBySlug, replaceCityPlaceholders, getCityUrl } from '../lib/city';
import type { ChatCity } from '../data/cities';

export interface Props {
	frontmatter: any;
	spokes?: any[];
	cluster: string;
	city?: ChatCity;
}

const { frontmatter, spokes = [], cluster, city: propCity } = Astro.props;
const city = propCity ?? getCityBySlug();

const seoTitle = replaceCityPlaceholders(frontmatter.seo?.title ?? `${frontmatter.title} — техпомощь {inCity}`, city);
const seoDescription = replaceCityPlaceholders(frontmatter.seo?.description ?? frontmatter.description, city);
const keywords = Array.isArray(frontmatter.tags) ? frontmatter.tags.join(', ') : undefined;

const jsonLd = [
	serviceNode({
		name: replaceCityPlaceholders(frontmatter.title, city),
		description: seoDescription,
		url: Astro.url.pathname,
		city,
	}),
	breadcrumbNode([
		{ name: 'Главная', url: getCityUrl('/', city.slug) },
		{ name: 'Услуги', url: getCityUrl('/services', city.slug) },
		{ name: replaceCityPlaceholders(frontmatter.title, city), url: Astro.url.pathname },
	]),
	faqNode(frontmatter.faqs),
].filter(Boolean);

// Карточки услуг для перелинковки на посадочные страницы.
const services = spokes.map((spoke) => ({
	title: replaceCityPlaceholders(spoke.title, city),
	description: replaceCityPlaceholders(spoke.excerpt ?? spoke.description, city),
	icon: spoke.icon,
	url: getCityUrl(spoke.url, city.slug),
}));

// Шаги процесса из frontmatter услуги.
const process = frontmatter.process;
const steps = process
	? [
			{
				title: replaceCityPlaceholders(process.step1Title, city),
				description: replaceCityPlaceholders(process.step1Desc, city),
			},
			{
				title: replaceCityPlaceholders(process.step2Title, city),
				description: replaceCityPlaceholders(process.step2Desc, city),
			},
			{
				title: replaceCityPlaceholders(process.step3Title, city),
				description: replaceCityPlaceholders(process.step3Desc, city),
			},
			{
				title: replaceCityPlaceholders(process.step4Title, city),
				description: replaceCityPlaceholders(process.step4Desc, city),
			},
		].filter((s) => s.title)
	: [];

const pricing = frontmatter.pricing;
const pricingItems = (pricing?.items ?? []).map((item: any) => ({
	...item,
	title: replaceCityPlaceholders(item.title, city),
	features: (item.features ?? []).map((f: any) => replaceCityPlaceholders(f, city)),
}));

const approach = frontmatter.approach;
const whyChoose = frontmatter.whyChoose;
const showFuelCalculator = cluster === 'toplivo';
---

<Layout title={seoTitle} description={seoDescription} keywords={keywords} jsonLd={jsonLd} city={city}>
	<Header city={city} />

	<HubPageHeader
		title={replaceCityPlaceholders(frontmatter.title, city)}
		showChatButton={cluster === 'toplivo'}
		city={city}
	/>

	<HubIntro title={replaceCityPlaceholders(frontmatter.title, city)} description={seoDescription} city={city}>
		<slot />
	</HubIntro>

	<HubPricing title={replaceCityPlaceholders(pricing?.title, city)} items={pricingItems} />

	{
		showFuelCalculator && (
			<div class="fuel-calculator-section bg-section">
				<div class="container">
					<FuelDeliveryCalculator client:visible />
				</div>
			</div>
		)
	}

	<HubServices services={services} />

	<HubProcess title={replaceCityPlaceholders(process?.title, city)} steps={steps} />

	<HubApproach
		city={city}
		subtitle={replaceCityPlaceholders(approach?.subtitle, city)}
		title={replaceCityPlaceholders(approach?.title, city)}
		items={approach?.items}
		image={approach?.image}
		imageAlt={replaceCityPlaceholders(approach?.imageAlt, city)}
		footerText={replaceCityPlaceholders(approach?.footerText, city)}
		footerLinkHref={getCityUrl(approach?.footerLinkHref ?? '/services', city.slug)}
		footerLinkLabel={replaceCityPlaceholders(approach?.footerLinkLabel, city)}
		footerBadge={replaceCityPlaceholders(approach?.footerBadge, city)}
	/>

	<HubWhyChoose
		city={city}
		subtitle={replaceCityPlaceholders(whyChoose?.subtitle, city)}
		title={replaceCityPlaceholders(whyChoose?.title, city)}
		items={whyChoose?.items}
		image1={whyChoose?.image1}
		image1Alt={replaceCityPlaceholders(whyChoose?.image1Alt, city)}
		image2={whyChoose?.image2}
		image2Alt={replaceCityPlaceholders(whyChoose?.image2Alt, city)}
		counterLabel={replaceCityPlaceholders(whyChoose?.counterLabel, city)}
	/>

	<HubWhatWeDo city={city} />

	<HubExpertise city={city} />

	<HubCta city={city} />

	<HubFaqs
		faqs={frontmatter.faqs?.map((f: any) => ({
			question: replaceCityPlaceholders(f.question, city),
			answer: replaceCityPlaceholders(f.answer, city),
		}))}
		title={replaceCityPlaceholders('Частые вопросы {inCity}', city)}
	/>

	<HubTestimonials city={city} />

	<Footer city={city} />
</Layout>

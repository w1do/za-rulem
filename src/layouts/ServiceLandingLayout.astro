---
import { getCollection, getEntry } from 'astro:content';
import Layout from './Layout.astro';
import Header from '../components/shared/header/Header.astro';
import Footer from '../components/shared/footer/Footer.astro';
import ServicePageHeader from '../components/services/single/ServicePageHeader.astro';
import ServiceSidebar from '../components/services/single/ServiceSidebar.astro';
import ServiceSingleImage from '../components/services/single/ServiceSingleImage.astro';
import ServiceFaqs from '../components/services/single/ServiceFaqs.astro';
import FuelDeliveryCalculator from '../components/calculators/FuelDeliveryCalculator.tsx';
import FuelPricesSection from '../components/gas-prices/FuelPricesSection.astro';
import { serviceNode, breadcrumbNode, faqNode } from '../lib/seo';
import type { ChatCity } from '../data/cities';
import { getCityBySlug, replaceCityPlaceholders, removeCityPlaceholders, getCityUrl } from '../lib/city';

export interface Props {
	frontmatter: any;
	city?: ChatCity;
}

const { frontmatter, city: propCity } = Astro.props;
const city = propCity ?? getCityBySlug();

const cluster = frontmatter.cluster;
const pillar = await getEntry('services', cluster);
const hubUrl = getCityUrl(`/services/${cluster}`, city.slug);
const hubTitle = removeCityPlaceholders(pillar?.data.title ?? 'Услуги');

const siblings = (await getCollection('serviceLanding', ({ data }) => data.cluster === cluster))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		title: removeCityPlaceholders(entry.data.title),
		url: getCityUrl(`/services/${entry.id}`, city.slug),
	}));

const sidebarLinks = [{ title: `Все услуги: ${hubTitle}`, url: hubUrl }, ...siblings];

const seoTitle = replaceCityPlaceholders(frontmatter.seo?.title ?? `${frontmatter.title} — техпомощь {inCity}`, city);
const seoDescription = replaceCityPlaceholders(frontmatter.seo?.description ?? frontmatter.description, city);
const faqs = (frontmatter.faqs ?? []).map((faq: any) => ({
	question: replaceCityPlaceholders(faq.question, city),
	answer: replaceCityPlaceholders(faq.answer, city),
}));
const image = frontmatter.image ?? '/images/service-single-image.jpg';
const imageAlt = replaceCityPlaceholders(frontmatter.imageAlt ?? frontmatter.title, city);
const showFuelCalculator = cluster === 'toplivo' && /бензин/i.test(frontmatter.title);
const showFuelPricesTable = cluster === 'toplivo' && /очередь/i.test(frontmatter.title);

const jsonLd = [
	serviceNode({
		name: replaceCityPlaceholders(frontmatter.title, city),
		description: seoDescription,
		url: Astro.url.pathname,
		city,
	}),
	breadcrumbNode([
		{ name: 'Главная', url: getCityUrl('/', city.slug) },
		{ name: 'Услуги', url: getCityUrl('/services', city.slug) },
		{ name: hubTitle, url: hubUrl },
		{ name: replaceCityPlaceholders(frontmatter.title, city), url: Astro.url.pathname },
	]),
	faqNode(faqs),
].filter(Boolean);

// Рендерим контент слота и заменяем плейсхолдеры города в HTML
const contentHtml = await Astro.slots.render('default');
const replacedContentHtml = replaceCityPlaceholders(contentHtml, city);
---

<Layout title={seoTitle} description={seoDescription} jsonLd={jsonLd} city={city}>
	<Header city={city} />

	<ServicePageHeader
		title={replaceCityPlaceholders(frontmatter.title, city)}
		showChatButton={cluster === 'toplivo'}
	/>

	<!-- Page Service Single Start -->
	<div class="page-service-single">
		<div class="container">
			<div class="row">
				<div class="col-lg-4">
					<ServiceSidebar links={sidebarLinks} city={city} />
				</div>

				<div class="col-lg-8">
					<!-- Service Single Content Start -->
					<div class="service-single-content">
						<ServiceSingleImage image={image} alt={imageAlt} />

						<!-- Service Entry Start -->
						<div class="service-entry post-body" set:html={replacedContentHtml} />
						<!-- Service Entry End -->

						{showFuelCalculator && <FuelDeliveryCalculator client:visible />}

						{
							showFuelPricesTable && (
								<FuelPricesSection city={city} />
							)
						}

						<ServiceFaqs faqs={faqs} />
					</div>
					<!-- Service Single Content End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Service Single End -->

	<Footer city={city} />
</Layout>

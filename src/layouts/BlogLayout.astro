---
import Layout from './Layout.astro';
import Header from '../components/shared/header/Header.astro';
import Footer from '../components/shared/footer/Footer.astro';
import BlogSingleHeader from '../components/blog/BlogSingleHeader.astro';
import BlogSingleImage from '../components/blog/BlogSingleImage.astro';
import BlogPostTagLinks from '../components/blog/BlogPostTagLinks.astro';
import FuelPricesTable from '../components/FuelPricesTable.tsx';
import { articleNode, breadcrumbNode } from '../lib/seo';

const { frontmatter } = Astro.props;
const showFuelPricesTable = frontmatter.showFuelPricesTable === true;
const seoTitle = frontmatter.seo?.title ?? `${frontmatter.title} — блог «За рулём»`;
const seoDescription = frontmatter.seo?.description ?? frontmatter.description;
const dateLabel = frontmatter.date
	? new Date(frontmatter.date).toLocaleDateString('ru-RU', {
			day: 'numeric',
			month: 'long',
			year: 'numeric',
		})
	: '';

const publishedIso = frontmatter.date ? new Date(frontmatter.date).toISOString() : undefined;
const jsonLd = [
	articleNode({
		title: frontmatter.title,
		description: frontmatter.description,
		url: Astro.url.pathname,
		image: frontmatter.image,
		author: frontmatter.author,
		datePublished: publishedIso,
		dateModified: publishedIso,
	}),
	breadcrumbNode([
		{ name: 'Главная', url: '/' },
		{ name: 'Блог', url: '/blog' },
		{ name: frontmatter.title, url: Astro.url.pathname },
	]),
];
---

<Layout
	title={seoTitle}
	description={seoDescription}
	ogImage={frontmatter.image}
	ogType="article"
	jsonLd={jsonLd}
>
	<Header />

	<BlogSingleHeader title={frontmatter.title} author={frontmatter.author} dateLabel={dateLabel} />

	<!-- Page Single Post Start -->
	<div class="page-single-post">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					{
						frontmatter.image && (
							<BlogSingleImage
								image={frontmatter.image}
								imageAlt={frontmatter.imageAlt ?? frontmatter.title}
							/>
						)
					}

					<!-- Post Single Content Start -->
					<div class="w-100">
						<!-- Post Entry Start -->
						<div class="post-entry">
							<slot />
							{
								showFuelPricesTable && (
									<div class="fuel-prices-section mt-5 mb-5">
										<h3 class="mb-4">Справочные цены на топливо в сетях РФ (июль 2026)</h3>
										<FuelPricesTable client:load />
									</div>
								)
							}
						</div>
						<!-- Post Entry End -->

						<BlogPostTagLinks tags={frontmatter.tags} />
					</div>
					<!-- Post Single Content End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Single Post End -->

	<Footer />
</Layout>

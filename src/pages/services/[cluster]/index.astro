---
import { getCollection } from 'astro:content';
import { getCityUrl } from '../../../lib/cities';

export const prerender = false;

const cluster = Astro.params.cluster;
const pillar = cluster
	? (await getCollection('services', ({ data, id }) => data.hub === true && id === cluster))[0]
	: undefined;

if (!pillar) return new Response('Страница не найдена', { status: 404 });

return Astro.redirect(
	`${getCityUrl(`/services/${pillar.id}`)}${Astro.url.search}`,
	301,
);
---

---
import { getCollection } from 'astro:content';
import { getCityUrl } from '../../../lib/cities';

export const prerender = false;

const cluster = Astro.params.cluster;
const post = Astro.params.post;
const entry = cluster && post
	? (await getCollection('serviceLanding')).find(
			(item) => item.data.cluster === cluster && item.id.split('/').pop() === post,
		)
	: undefined;

if (!entry) return new Response('Страница не найдена', { status: 404 });

return Astro.redirect(
	`${getCityUrl(`/services/${entry.data.cluster}/${post}`)}${Astro.url.search}`,
	301,
);
---

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/shared/header/Header.astro';
import Footer from '../components/shared/footer/Footer.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeAbout from '../components/home/HomeAbout.astro';
import HomeServices from '../components/home/HomeServices.astro';
import HomeWhyChoose from '../components/home/HomeWhyChoose.astro';
import HomeFleets from '../components/home/HomeFleets.astro';
import HomeWhatWeDo from '../components/home/HomeWhatWeDo.astro';
import HomeCollection from '../components/home/HomeCollection.astro';
import HomeDrivers from '../components/home/HomeDrivers.astro';
import HomeHowItWork from '../components/home/HomeHowItWork.astro';
import HomeTestimonials from '../components/home/HomeTestimonials.astro';
import HomePricing from '../components/home/HomePricing.astro';
import HomeBlog from '../components/home/HomeBlog.astro';
import { breadcrumbNode, webPageNode } from '../lib/seo';

const services = [
	{ icon: '/images/icon-service-1.svg', title: 'Доставлять бензин и дизель', text: 'Партнёр должен уточнить марку и объём топлива, купить его на АЗС и доставить к машине с пустым баком в Тюмени, пригороде или на трассе.', href: '/contacts', linkText: 'Подключить доставку' },
	{ icon: '/images/icon-service-2.svg', title: 'Устранять поломки на месте', text: 'Партнёр должен запустить двигатель, провести первичную диагностику и выполнять только тот ремонт, для которого у него есть опыт, инструмент и расходники.', href: '/contacts', linkText: 'Стать автомастером' },
	{ icon: '/images/icon-service-3.svg', title: 'Буксировать и эвакуировать авто', text: 'Партнёр должен безопасно вытащить, дотащить или перевезти неисправный автомобиль до стоянки либо сервиса, если продолжать движение нельзя.', href: '/contacts', linkText: 'Получать вызовы' },
];

const benefits = [
	{ icon: '/images/icon-hero-info-list-1-gold.svg', title: '01. Указать реальные услуги', text: 'Партнёр отмечает только те виды доставки, ремонта или буксировки, которые способен выполнить самостоятельно и безопасно.' },
	{ icon: '/images/icon-hero-info-list-2-gold.svg', title: '02. Соблюдать район и срок', text: 'Партнёр заранее задаёт район выезда, радиус за городом и время прибытия, а после принятия вызова соблюдает эти условия.' },
	{ icon: '/images/icon-hero-info-list-3-gold.svg', title: '03. Перечислить комиссию', text: 'После выполненного заказа партнёр передаёт системе 5% от согласованной стоимости и оставляет себе остальные 95%.' },
];

const steps = [
	{ icon: '/images/icon-how-it-work-1-gold.svg', number: '01', title: 'Заполнить анкету', text: 'Партнёр указывает контакты, данные автомобиля, перечень работ, районы выезда, оборудование и реальный срок прибытия.' },
	{ icon: '/images/icon-how-it-work-2-gold.svg', number: '02', title: 'Подтвердить оснащение', text: 'Партнёр предоставляет документы, исправный транспорт и оснащение, необходимое для безопасного выполнения выбранных услуг.' },
	{ icon: '/images/icon-how-it-work-3-gold.svg', number: '03', title: 'Выполнить первый заказ', text: 'Партнёр включает статус готовности, подтверждает подходящий вызов, согласует цену и приезжает к водителю в названный срок.' },
];

const jsonLd = [
	webPageNode({ type: 'WebPage', name: 'Стать партнёром Za-Rulem.org — заказы водителям и мастерам', description: 'Подключение водителей и выездных автомастеров в Тюмени к заказам на доставку топлива, ремонт, буксировку и помощь на дороге. Комиссия — 5% только с выполненного заказа.', url: '/partners' }),
	breadcrumbNode([{ name: 'Главная', url: '/' }, { name: 'Партнёрам', url: '/partners' }]),
];
---

<Layout
	title="Стать партнёром услуги помощи на дороге — доставка бензина/дизеля на дом"
	description="Заказы водителям и автомастерам в Тюмени: доставка бензина, ремонт, буксировка и помощь на дороге 24/7. Комиссия — 5% только после выполнения."
	ogTitle="Заказы водителям и автомастерам — комиссия 5%"
	ogDescription="Станьте партнёром Za-Rulem.org: выбирайте районы и дорожные услуги, получайте вызовы и оставляйте себе 95% стоимости заказа."
	keywords="стать партнером помощь на дороге, заказы водителям тюмень, заказы автомастерам, водитель на своем авто тюмень, доставка бензина работа, выездной автомастер работа, партнер эвакуатор, подработка помощь на дороге"
	jsonLd={jsonLd}
>
	<Header />
	<HomeHero
		subtitle="Заказы водителям и автомастерам в Тюмени"
		title="Станьте партнёром помощи на дороге с комиссией 5%"
		description="Партнёр должен быть готов доставлять топливо, запускать и ремонтировать машины либо буксировать их после поломки. Он указывает реальные услуги и районы, соблюдает согласованные цену и срок, а после выполнения заказа передаёт системе 5%."
		ctaText="Стать партнёром"
		reviewText="Обязанности партнёра на каждом вызове"
		counterValue="5"
		counterText="Комиссия только после выполненного заказа."
		benefits={benefits}
	/>
	<HomeAbout
		subtitle="Кому подходит партнёрство"
		title="Водителям на своём авто и мастерам с выездным инструментом"
		taskTitle="Что обязан делать партнёр"
		taskText="Оставаться на связи в отмеченные часы, честно указывать компетенции, заранее подтверждать срок и цену, безопасно выполнять работу и отвечать за принятый вызов."
		principleTitle="Что даёт Za-Rulem.org"
		principleText="Система показывает профиль исполнителя людям с конкретной дорожной проблемой и передаёт заявку по услуге и географии. Партнёр перечисляет фиксированную комиссию 5% только после выполнения."
		counters={[
			{ value: '24', suffix: '/7', label: 'Готовность к заказам' },
			{ value: '5', suffix: '%', label: 'Комиссия системы' },
			{ value: '4', suffix: '+', label: 'Вида дорожных заказов' },
			{ value: '95', suffix: '%', label: 'Оплаты остаётся партнёру' },
		]}
		footerText="Есть автомобиль, инструмент или эвакуатор и готовность отвечать за результат —"
		footerLinkText="стать партнёром"
	/>
	<HomeServices
		subtitle="Что предстоит делать"
		title="Что должен делать партнёр Za-Rulem.org"
		services={services}
		footerText="Партнёр отмечает только работы, которые может выполнить безопасно и без посредников —"
		footerLinkText="стать партнёром"
		footerLinkHref="/contacts"
		rating="24/7"
		ratingText="Можно отмечать круглосуточную готовность"
	/>
	<HomeWhyChoose
		subtitle="Условия для партнёра"
		title="Партнёр обязан заранее указать условия выезда"
		description="В профиле партнёр фиксирует районы Тюмени, пригород или трассу, доступные работы, ориентир цены и срок прибытия. Он не должен подтверждать вызов вне своего радиуса, оснащения или компетенции."
		items={[
			{ icon: '/images/icon-why-choose-body-1-gold.svg', title: 'Целевой профиль', text: 'Клиент видит специализацию, транспорт, районы, сроки, ориентиры стоимости и текущий статус до обращения.' },
			{ icon: '/images/icon-why-choose-body-2-gold.svg', title: 'Понятный расчёт', text: 'Партнёр согласует с клиентом цену до выезда, не меняет её без дополнительной работы и после выполнения передаёт системе 5%.' },
		]}
		ctaText="Стать партнёром"
		authorName="Za-Rulem.org"
		authorText="Проект помощи на дороге"
	/>
	<HomeFleets
		subtitle="Направления партнёрства"
		title="Четыре направления заказов для дорожного партнёра"
		slides={[
			{ image: '/images/fleets-image-4.jpg', label: 'Доставка топлива', price: '5%', priceUnit: '/заказ', amenities: ['АИ-92, 95, 100, ДТ', 'Тюмень, пригород, трасса'], href: '/services/toplivo' },
			{ image: '/images/fleets-image-3.jpg', label: 'Выездной ремонт', price: '5%', priceUnit: '/заказ', amenities: ['Поиск причины поломки', 'Ремонт на месте'], href: '/services/tehpomosch' },
			{ image: '/images/fleets-image-1.jpg', label: 'Запуск двигателя', price: '5%', priceUnit: '/заказ', amenities: ['Разряжен аккумулятор', 'Мотор не запускается'], href: '/services/tehpomosch/prikurit-avto' },
			{ image: '/images/fleets-image-5.jpg', label: 'Буксировка и эвакуация', price: '5%', priceUnit: '/заказ', amenities: ['Дотащить до сервиса', 'Перевезти неисправное авто'], href: '/services' },
		]}
		footerText="В профиле партнёра фиксируются только подтверждённые направления —"
		footerLinkText="подать заявку"
		footerLinkHref="/contacts"
	/>
	<HomeWhatWeDo
		subtitle="Как работает партнёрство"
		title="Как заявка превращается в оплаченный дорожный заказ"
		description="Клиент описывает проблему и место остановки. После получения заявки партнёр должен связаться с водителем, уточнить детали, проверить возможность выполнения, назвать срок и полную стоимость, затем подтвердить заказ."
		counters={[{ value: '0.95', title: 'Оплаты остаётся партнёру' }, { value: '0.05', title: 'Комиссия системы с заказа' }]}
		checklist={['Связаться с клиентом после заявки', 'Согласовать цену и срок до выезда', 'Передать системе 5% после выполнения']}
		infoTitle="Что нужно подготовить к вызову"
		infoText="Партнёр держит телефон доступным, транспорт исправным и заправленным, а оборудование укомплектованным. Подтверждать можно только безопасный вызов в своём радиусе и по своей компетенции."
		ctaText="Подключиться к системе"
		authorName="Za-Rulem.org"
		authorText="Система дорожной помощи"
	/>
	<HomeCollection
		subtitle="Семантика дорожных вызовов"
		title="С какими проблемами обращаются к партнёру"
		description="Партнёр должен уметь закрыть конкретную задачу: привезти топливо, запустить двигатель, устранить доступную поломку или перевезти машину. Для каждого направления он заранее указывает оборудование и границы работ."
		ctaText="Стать партнёром"
		categories={[
			{ icon: '/images/icon-car-collection-1-gold.svg', title: 'Доставка бензина', image: '/images/car-collection-image-1-gold.png' },
			{ icon: '/images/icon-car-collection-2-gold.svg', title: 'Запуск двигателя', image: '/images/car-collection-image-2-gold.png' },
			{ icon: '/images/icon-car-collection-3-gold.svg', title: 'Помощь при поломке', image: '/images/car-collection-image-3-gold.png' },
			{ icon: '/images/icon-car-collection-4-gold.svg', title: 'Буксировка и эвакуация', image: '/images/car-collection-image-4-gold.png' },
			{ icon: '/images/icon-car-collection-5-gold.svg', title: 'Диагностика мотора', image: '/images/car-collection-image-5-gold.png' },
			{ icon: '/images/icon-car-collection-6-gold.svg', title: 'Доставка дизеля', image: '/images/car-collection-image-6-gold.png' },
		]}
	/>
	<HomeDrivers
		subtitle="Кто может стать партнёром"
		title="Кто может получать заказы на помощь автомобилистам"
		drivers={[
			{ image: '/images/driver/ekip-1.jpg', title: 'Водитель на своём авто', text: 'Подходит для доставки бензина и дизеля, прикуривания аккумулятора и передачи расходников в Тюмени и за городом.', href: '/contacts' },
			{ image: '/images/driver/ekip-2.jpg', title: 'Выездной автомастер', text: 'Берёт заявки на диагностику двигателя, запуск, настройку и ремонт, который можно безопасно выполнить на месте остановки.', href: '/contacts' },
			{ image: '/images/driver/ekip-3.jpg', title: 'Владелец эвакуатора или тягача', text: 'Получает вызовы на буксировку, вытаскивание и перевозку автомобиля до выбранного сервиса или безопасной стоянки.', href: '/contacts' },
		]}
		footerText="Есть транспорт, опыт и готовность помогать 24/7 —"
		footerLinkText="подать заявку"
		footerLinkHref="/contacts"
	/>
	<HomeHowItWork
		subtitle="Подключение партнёра"
		title="Как подключиться и начать получать дорожные заявки"
		steps={steps}
		footerList={['Исправный транспорт', 'Подтверждённые навыки', 'Безопасное оборудование', 'Связь во время заказа']}
		footerText="Проверка нужна, чтобы клиент видел реальные услуги, а партнёр получал выполнимые вызовы без потери времени."
		footerLinkText="Стать партнёром проекта"
	/>
	<HomeTestimonials
		subtitle="Ответственность сторон"
		title="За что отвечает партнёр при выполнении заказа"
		intro="Za-Rulem.org передаёт целевой запрос, а партнёр уточняет проблему, называет честный срок, согласует полную цену, соблюдает безопасность и доводит принятую работу до результата."
		satisfyText="Партнёры дорожной помощи"
		reviews={[
			{ title: 'Система отвечает за точность заявки', text: 'В обращении должны быть услуга, место, контакты и описание ситуации. Эти данные позволяют сразу оценить маршрут, оборудование и возможность выполнить работу.', author: 'Za-Rulem.org', authorRole: 'Передача дорожного заказа', image: '/images/author-3.jpg' },
			{ title: 'Партнёр отвечает за выполнение', text: 'После подтверждения партнёр приезжает в согласованный срок, не меняет цену без новой работы и соблюдает правила перевозки топлива, ремонта или буксировки.', author: 'Партнёр', authorRole: 'Выполнение помощи на дороге', image: '/images/author-2.jpg' },
		]}
		footerText="Готов принимать дорожные вызовы —"
		footerLinkText="стать партнёром"
		footerLinkHref="/contacts"
	/>
	<HomePricing
		subtitle="Комиссия системы"
		title="Одна комиссия для водителя, мастера и эвакуатора"
		plans={[
			{ icon: '/images/icon-pricing-1-gold.svg', title: 'Доставка топлива', text: 'Для водителя со своим исправным автомобилем и безопасной тарой.', price: '5%', priceUnit: '/заказ', features: ['Уточнить марку и объём', 'Соблюсти район и срок', 'Передать 5% после заказа'], ctaText: 'Подключить доставку', ctaHref: '/contacts' },
			{ icon: '/images/icon-pricing-2-gold.svg', title: 'Выездной ремонт', text: 'Для мастера с диагностикой, инструментом и опытом дорожных работ.', price: '5%', priceUnit: '/заказ', features: ['Уточнить симптомы поломки', 'Согласовать работу до выезда', 'Отвечать за результат'], ctaText: 'Стать мастером', ctaHref: '/contacts' },
			{ icon: '/images/icon-pricing-3-gold.svg', title: 'Буксировка', text: 'Для партнёра с подходящим транспортом и оснащением для перевозки.', price: '5%', priceUnit: '/заказ', features: ['Маршрут известен заранее', 'Городские и загородные вызовы', 'Цена согласуется до старта'], ctaText: 'Получать заказы', ctaHref: '/contacts' },
		]}
		benefits={['Комиссия только с заказа', '95% остаётся партнёру', 'Готовность к вызовам 24/7']}
	/>
	<HomeBlog
		subtitle="Перед подключением"
		title="Что проверить до подачи заявки партнёра"
		description="Партнёр должен подготовить документы, проверить транспорт и связь, перечислить реальные услуги, районы и оборудование. Точная анкета сокращает неподходящие вызовы и споры о сроке или цене."
		posts={[
			{ image: '/images/post-1.jpg', title: 'Безопасная доставка бензина и дизеля водителю', href: '/services/toplivo', btnText: 'Изучить направление' },
			{ image: '/images/post-2.jpg', title: 'Какие поломки можно устранить прямо на дороге', href: '/services/tehpomosch', btnText: 'Изучить направление' },
			{ image: '/images/post-3.jpg', title: 'Как подготовиться к круглосуточным дорожным вызовам', href: '/contacts', btnText: 'Стать партнёром' },
		]}
	/>
	<Footer />
</Layout>
---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/shared/header/Header.astro';
import Footer from '../../components/shared/footer/Footer.astro';
import BlogPageHeader from '../../components/blog/BlogPageHeader.astro';
import PostCard from '../../components/blog/PostCard.astro';
import BlogPagination from '../../components/blog/BlogPagination.astro';
import { webPageNode, breadcrumbNode, itemListNode } from '../../lib/seo';
import { getCityBySlug, replaceCityPlaceholders } from '../../lib/city';

const city = getCityBySlug();

const posts = (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);

const POSTS_PER_PAGE = 9;
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));

const jsonLd = [
	webPageNode({
		type: 'Blog',
		name: replaceCityPlaceholders('Блог о техпомощи на дороге — советы автовладельцам {ofCity}', city),
		description: replaceCityPlaceholders(
			'Разбираю частые дорожные ситуации: почему не заводится авто, как прикурить машину, что делать в мороз и как выбрать аккумулятор. Опыт мастера автопомощи {inCity}.',
			city,
		),
		url: '/blog',
	}),
	breadcrumbNode([
		{ name: 'Главная', url: '/' },
		{ name: 'Блог', url: '/blog' },
	]),
	itemListNode(posts.map((post) => ({ name: post.data.title, url: `/blog/${post.id}` }))),
];
---

<Layout
	title={replaceCityPlaceholders('Блог о техпомощи на дороге — советы автовладельцам {ofCity} | За рулём', city)}
	description={replaceCityPlaceholders('Разбираю частые дорожные ситуации: почему не заводится авто, как прикурить машину, что делать в мороз и как выбрать аккумулятор. Опыт мастера {inCity}.', city)}
	keywords={`блог техпомощь ${city.name}, не заводится авто, как прикурить машину, отогрев авто, выбор аккумулятора`}
	jsonLd={jsonLd}
	city={city}
>
	<Header city={city} />

	<BlogPageHeader title="Блог" breadcrumb="Блог" />

	<!-- Page Blog Start -->
	<div class="page-blog">
		<div class="container">
			<div class="row">
				{
					posts.map((post, i) => (
						<PostCard
							title={post.data.title}
							image={post.data.image}
							imageAlt={post.data.imageAlt}
							url={`/blog/${post.id}`}
							delay={i % 3 === 0 ? undefined : `${(i % 3) * 0.2}s`}
						/>
					))
				}

				<BlogPagination currentPage={1} totalPages={totalPages} basePath="/blog" />
			</div>
		</div>
	</div>
	<!-- Page Blog End -->

	<Footer city={city} />
</Layout>

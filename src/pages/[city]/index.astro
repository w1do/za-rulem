---
import HomePage from '../../components/pages/HomePage.astro';
import { chatCities } from '../../data/cities';

export function getStaticPaths() {
	return chatCities.map((city) => ({
		params: { city: city.slug },
		props: { city },
	}));
}

const { city } = Astro.props;
---

<HomePage city={city} />

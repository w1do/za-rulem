---
import TermsPage from '../../components/pages/TermsPage.astro';
import { chatCities } from '../../data/cities';

export function getStaticPaths() {
	return chatCities.map((city) => ({
		params: { city: city.slug },
		props: { city },
	}));
}

const { city } = Astro.props;
---

<TermsPage city={city} />

---
import ChatCityLanding from '../../../components/driver-chat/ChatCityLanding.astro';
import { findCity } from '../../../data/cities';

export const prerender = false;

const city = findCity(Astro.params.city);
if (!city) return new Response('Город не найден', { status: 404 });
---

<ChatCityLanding city={city} />

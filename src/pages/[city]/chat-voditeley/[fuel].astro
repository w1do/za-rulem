---
import ChatFuelLanding from '../../../components/driver-chat/ChatFuelLanding.astro';
import { findCity } from '../../../lib/cities';
import { chatFuels } from '../../../data/chatCluster';

export const prerender = false;

const city = findCity(Astro.params.city);
const fuel = chatFuels.find((item) => item.slug === Astro.params.fuel);
if (!city || !fuel) return new Response('Страница не найдена', { status: 404 });
---

<ChatFuelLanding city={city} fuel={fuel} />

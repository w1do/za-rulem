---
import { getCollection, render } from 'astro:content';
import HubLayout from '../../../../layouts/HubLayout.astro';
import { findCity } from '../../../../lib/cities';
import { removeCityPlaceholders, getCityUrl } from '../../../../lib/cities';

export const prerender = false;

const city = findCity(Astro.params.city);
const pillar = city
	? (await getCollection('services', ({ data, id }) => data.hub === true && id === Astro.params.cluster))[0]
	: undefined;
if (!city || !pillar) return new Response('Страница не найдена', { status: 404 });

const spokes = (await getCollection('serviceLanding', ({ data }) => data.cluster === pillar.id))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		title: removeCityPlaceholders(entry.data.title),
		description: removeCityPlaceholders(entry.data.description),
		excerpt: removeCityPlaceholders(entry.data.excerpt),
		icon: entry.data.icon,
		tags: entry.data.tags,
		url: getCityUrl(`/services/${pillar.id}/${entry.id.split('/').pop()}`, city.slug),
	}));

const { Content } = await render(pillar);
---

<HubLayout frontmatter={pillar.data} spokes={spokes} cluster={pillar.id} city={city}>
	<Content />
</HubLayout>

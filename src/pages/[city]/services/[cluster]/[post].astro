---
import { getCollection, render } from 'astro:content';
import ServiceLandingLayout from '../../../../layouts/ServiceLandingLayout.astro';
import { findCity } from '../../../../lib/cities';

export const prerender = false;

const city = findCity(Astro.params.city);
const entry = city
	? (await getCollection('serviceLanding')).find(
			(item) => item.data.cluster === Astro.params.cluster && item.id.split('/').pop() === Astro.params.post,
		)
	: undefined;
if (!city || !entry) return new Response('Страница не найдена', { status: 404 });

const { Content } = await render(entry);
---

<ServiceLandingLayout frontmatter={entry.data} city={city}>
	<Content />
</ServiceLandingLayout>

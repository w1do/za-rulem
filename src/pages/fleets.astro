---
import Layout from '../layouts/Layout.astro';
import Header from '../components/shared/header/Header.astro';
import Footer from '../components/shared/footer/Footer.astro';

const title = "Доставка бензина и ДТ — Маркетплейс мастеров";
const description = "Доставка бензина АИ-92, АИ-95, АИ-100 и дизельного топлива прямо к автомобилю. Отстою в очереди и привезу топливо на точку.";

const fuels = [
	{
		id: 1,
		name: "Бензин АИ-92",
		price: "120 руб",
		unit: "/за литр",
		image: "/images/fleets-image-1.jpg",
		features: ["Доставка до двери", "Любой объем"],
		delay: "0s"
	},
	{
		id: 2,
		name: "Бензин АИ-95",
		price: "130 руб",
		unit: "/за литр",
		image: "/images/fleets-image-2.jpg",
		features: ["Доставка до двери", "Любой объем"],
		delay: "0.2s"
	},
	{
		id: 3,
		name: "Бензин АИ-100",
		price: "160 руб",
		unit: "/за литр",
		image: "/images/fleets-image-3.jpg",
		features: ["Доставка до двери", "Премиум качество"],
		delay: "0.4s"
	},
	{
		id: 4,
		name: "Дизельное топливо (ДТ)",
		price: "120 руб",
		unit: "/за литр",
		image: "/images/fleets-image-4.jpg",
		features: ["Доставка до двери", "Для легковых и грузовых"],
		delay: "0.6s"
	}
];
---

<Layout title={title} description={description}>
	<Header />

	<!-- Page Header Section Start -->
	<div class="page-header parallaxie">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<!-- Page Header Box Start -->
					<div class="page-header-box">
						<h1 class="text-anime-style-3" data-cursor="-opaque">Доставка бензина</h1>
						<nav class="wow fadeInUp">
							<ol class="breadcrumb">
								<li class="breadcrumb-item"><a href="/">Главная</a></li>
								<li class="breadcrumb-item active" aria-current="page">Маркетплейс</li>
							</ol>
						</nav>
					</div>
					<!-- Page Header Box End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Header Section End -->

	<!-- Page Fleets Section Start -->
	<div class="page-fleets">
		<div class="container">
			<div class="row">
				<div class="col-lg-4">
					<!-- Page Single Sidebar Start -->
					<div class="page-single-sidebar">
						<!-- Fleet Category Item Start -->
						<div class="fleet-category-item wow fadeInUp">
							<!-- Fleets Search Box Start -->
							<div class="fleets-search-box">
								<form id="fleetsForm" action="#" method="POST">
									<div class="form-group">
										<input type="text" name="search" class="form-control" id="search" placeholder="Поиск мастера..." required="">
									</div>
								</form>
							</div>
							<!-- Fleets Search Box End -->

							<!-- Fleet Category Options Start -->
							<div class="fleet-category-options">
								<h2 class="fleet-category-options-title">Виды топлива</h2>
								<ul>
									<li>
										<input class="form-check-input" type="checkbox" id="ai92" name="interest" value="ai92" checked>
										<label for="ai92">АИ-92</label>
									</li>
									<li>
										<input class="form-check-input" type="checkbox" id="ai95" name="interest" value="ai95" checked>
										<label for="ai95">АИ-95</label>
									</li>
									<li>
										<input class="form-check-input" type="checkbox" id="ai100" name="interest" value="ai100" checked>
										<label for="ai100">АИ-100</label>
									</li>
									<li>
										<input class="form-check-input" type="checkbox" id="dt" name="interest" value="dt" checked>
										<label for="dt">ДТ</label>
									</li>
								</ul>
							</div>
							<!-- Fleet Category Options End -->

							<!-- Fleet Category Button Start -->
							<div class="fleet-category-btn">
								<a href="#" class="btn-default">Найти</a>
							</div>
							<!-- Fleet Category Button End -->
						</div>
						<!-- Fleet Category Item End -->
					</div>
					<!-- Page Single Sidebar End -->
				</div>

				<div class="col-lg-8">
					<!-- Info Box Start -->
					<div class="mb-4 wow fadeInUp">
						<div class="service-content">
							<h2>Почему такая цена?</h2>
							<p>Я беру на себя все хлопоты: <strong>отстою в очереди</strong> на АЗС и <strong>привезу топливо прямо к автомобилю</strong>. Не нужно тратить время и жечь остатки бензина в пробках.</p>
						</div>
					</div>
					<!-- Info Box End -->

					<!-- Fleet Item List Start -->
					<div class="fleet-item-list">
						{fuels.map((fuel) => (
							<div class="fleets-item wow fadeInUp" data-wow-delay={fuel.delay}>
								<!-- Fleets Item Image Start -->
								<div class="fleets-item-image">
									<a
										href="/contacts"
										data-cursor-text="Заказать"
										data-service-request
										data-service="toplivo"
										data-service-title="Заказать доставку топлива"
									>
										<figure>
											<img src={fuel.image} alt={fuel.name}>
										</figure>
									</a>
								</div>
								<!-- Fleets Item Image End -->

								<!-- Fleets Item Button Start -->
								<div class="fleets-item-btn">
									<a
										href="/contacts"
										data-service-request
										data-service="toplivo"
										data-service-title="Заказать доставку топлива"
										aria-label={`Заказать ${fuel.name}`}
									>
										<img src="/images/arrow-primary.svg" alt="">
									</a>
								</div>
								<!-- Project Item Button End -->

								<!-- Fleets Item Body Start -->
								<div class="fleets-item-body">
									<!-- Fleets Item Content Start -->
									<div class="fleets-item-content">
										<p>{fuel.name}</p>
										<h2>
											{fuel.price} <sub>{fuel.unit}</sub>
											<span class="price-min-note">выезд от 2 800 руб</span>
										</h2>
									</div>
									<!-- Fleets Item Content End -->

									<!-- Fleets Amenity Item List Start -->
									<div class="fleets-amenity-item-list">
										<ul>
											{fuel.features.map((feature) => (
												<li><img src="/images/icon-amenity-item-2.svg" alt="">{feature}</li>
											))}
										</ul>
									</div>
									<!-- Fleets Amenity Item List End -->
								</div>
								<!-- Fleets Item Header Box End -->
							</div>
						))}
					</div>
					<!-- Fleet Item List End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Fleets Section End -->

	<Footer />
</Layout>

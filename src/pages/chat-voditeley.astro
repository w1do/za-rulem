---
import Layout from '../layouts/Layout.astro';
import Header from '../components/shared/header/Header.astro';
import Footer from '../components/shared/footer/Footer.astro';
import PageHeader from '../components/shared/PageHeader.astro';
import ChatCityCards from '../components/driver-chat/ChatCityCards.astro';
import HubProcess from '../components/hub/HubProcess.astro';
import HubCta from '../components/hub/HubCta.astro';
import { webPageNode, breadcrumbNode } from '../lib/seo';
import { getCityBySlug } from '../lib/city';

const city = getCityBySlug('tyumen');

// SEO Data
const title = 'Чат водителей: города, цены на бензин и наличие топлива на АЗС';
const h1 = 'Чат водителей: выберите ваш город';
const description = 'Объединенное сообщество водителей. Выберите город, чтобы узнать актуальные цены на бензин, наличие топлива на АЗС и очереди в реальном времени через живой чат.';
const url = '/chat-voditeley';

const jsonLd = [
	webPageNode({ name: title, description, url }),
	breadcrumbNode([{ name: 'Главная', url: '/' }, { name: 'Чат водителей', url }]),
];
---

<Layout title={title} description={description} jsonLd={jsonLd} city={city}>
	<Header city={city} />
	<main>
		<PageHeader title={h1} items={[{ label: 'Главная', href: '/' }, { label: 'Чат водителей' }]} showChatButton={true} chatLink="/chat" />
		
		<section class="hub-intro py-5">
			<div class="container">
				<div class="section-title text-center mb-5">
					<span class="section-sub-title">Наше сообщество</span>
					<h2>Взаимовыручка водителей в реальном времени</h2>
					<p>Я создаю сеть локальных чатов, где водители помогают друг другу: делятся ценами на бензин, сообщают о наличии топлива и очередях на заправках. Выберите город, чтобы присоединиться.</p>
				</div>
			</div>
		</section>

		<ChatCityCards />

		<HubProcess
			subtitle="Как это работает"
			title="Четыре шага к экономии времени"
			steps={[
				{ title: 'Выберите город', description: 'Найдите свой город в списке выше, чтобы попасть в локальное сообщество.' },
				{ title: 'Зайдите в чат', description: 'Для каждой марки бензина и города у нас есть отдельные каналы.' },
				{ title: 'Уточните наличие', description: 'Спросите у других участников, где сейчас есть топливо и нет очередей.' },
				{ title: 'Помогайте другим', description: 'Если вы уже на АЗС — напишите об обстановке, это поможет другим водителям.' },
			]}
		/>

		<HubCta
			city={city}
			subtitle="Всегда под рукой"
			title="Пользуйтесь чатом как приложением"
			description="Вы можете добавить чат на главный экран своего телефона. Это позволит получать пуш-уведомления и заходить в чат в один клик, без поиска ссылки."
			btnText="Как установить"
			btnHref="/chat"
			showContact={false}
			features={['Быстрый доступ', 'Пуш-уведомления', 'Работает на iOS и Android']}
		/>
	</main>
	<Footer city={city} />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import DriverChatBox from '../components/driver-chat/DriverChatBox.astro';
import { breadcrumbNode, webPageNode } from '../lib/seo';

const title = 'Чат водителей — где есть топливо сейчас | Тюмень';
const description = 'Приложение-чат водителей Тюмени: где сейчас есть бензин и дизель и какие очереди на АЗС. Вход по номеру без пароля, можно установить на телефон.';
const url = '/chat';
const jsonLd = [
	webPageNode({ name: title, description, url }),
	breadcrumbNode([{ name: 'Главная', url: '/' }, { name: 'Чат водителей', url }]),
];
---

<Layout title={title} description={description} keywords="чат водителей, где есть топливо, чат азс тюмень, есть бензин, очереди на азс, чат бензин" jsonLd={jsonLd}>
	<link slot="head" rel="manifest" href="/manifest.webmanifest" />
	<meta slot="head" name="apple-mobile-web-app-capable" content="yes" />
	<meta slot="head" name="apple-mobile-web-app-status-bar-style" content="default" />
	<meta slot="head" name="apple-mobile-web-app-title" content="Чат топлива" />

	<div class="chat-app">
		<header class="chat-app__bar">
			<a class="chat-app__brand" href="/" aria-label="На главную">
				<img src="/images/logo.svg" alt="За рулём" width="132" height="34" />
			</a>
			<a class="chat-app__back" href="/chat-voditeley">
				<i class="fa-solid fa-circle-info"></i>
				<span>О чате</span>
			</a>
		</header>

		<main class="chat-app__body">
			<DriverChatBox variant="app" />
		</main>
	</div>
</Layout>

<style>
	.chat-app {
		display: flex;
		flex-direction: column;
		height: 100vh;
		height: 100dvh;
		background: var(--secondary-color);
	}
	.chat-app__bar {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 12px 20px;
		border-bottom: 1px solid #ececec;
		background: var(--secondary-color);
	}
	.chat-app__brand img { display: block; height: 34px; width: auto; }
	.chat-app__back {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 16px;
		border: 1px solid #e2e5e9;
		border-radius: 999px;
		font-size: 14px;
		color: var(--primary-color);
	}
	.chat-app__back:hover { border-color: var(--accent-color); color: var(--primary-color); }
	.chat-app__body { flex: 1; min-height: 0; }

	@media (max-width: 575px) {
		.chat-app__bar { padding: 10px 14px; }
		.chat-app__back span { display: none; }
	}
</style>

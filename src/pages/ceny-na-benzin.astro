---
import Layout from '../layouts/Layout.astro';
import Header from '../components/shared/header/Header.astro';
import Footer from '../components/shared/footer/Footer.astro';
import PageHeader from '../components/shared/PageHeader.astro';
import Alert from '../components/shared/Alert.astro';
import GasPricesIntro from '../components/gas-prices/GasPricesIntro.astro';
import GasPricesMapSection from '../components/gas-prices/GasPricesMapSection.astro';
import HomeHowItWork from '../components/home/HomeHowItWork.astro';
import HomeWhyChoose from '../components/home/HomeWhyChoose.astro';
import HubFaqs from '../components/hub/HubFaqs.astro';
import HubCta from '../components/hub/HubCta.astro';
import QueueDriversPreview from '../components/queues/QueueDriversPreview.astro';
import { gasStationLabels, queueDrivers } from '../data/queueDrivers';
import { chatCities, DEFAULT_CITY_SLUG } from '../data/chatCluster';

import { webPageNode, breadcrumbNode } from '../lib/seo';

// Fetch gasoline data for Tyumen
const tyumen = chatCities.find(c => c.slug === DEFAULT_CITY_SLUG);
const bounds = tyumen?.bounds;

let stations = [];
let pageData = {
  title: "Цены на бензин в Тюмени сегодня | Где бензин",
  h1: "Цены на бензин в Тюмени сегодня: где заправиться дешевле?",
  description: "Актуальные цены на бензин АИ-92, АИ-95 и ДТ в Тюмени на сегодня. Смотрите карту заправок с ценами и экономьте на топливе.",
  text: ""
};

if (bounds) {
  try {
    const { minLat, maxLat, minLon, maxLon } = bounds;
    const response = await fetch(`https://benzin.api.2gis.ru/api/v1/stations?minLat=${minLat}&maxLat=${maxLat}&minLon=${minLon}&maxLon=${maxLon}`);
    if (response.ok) {
      stations = await response.json();
    }
  } catch (error) {
    console.error('Error fetching gas prices from 2GIS:', error);
  }
}

const url = '/benzin-tyumen';
const jsonLd = [
	webPageNode({
		name: pageData.title,
		description: pageData.description,
		url: url,
	}),
	breadcrumbNode([
		{ name: 'Главная', url: '/' },
		{ name: 'Цены на бензин', url: url },
	]),
];

const faqs = [
  {
    question: "Где самый дешевый бензин в Тюмени сегодня?",
    answer: "Цены на топливо постоянно меняются. На нашей интерактивной карте вы можете в реальном времени сравнить стоимость АИ-92, АИ-95 и дизеля на всех популярных АЗС Тюмени, включая Газпромнефть, Лукойл, Роснефть и другие."
  },
  {
    question: "Как часто обновляются данные о ценах?",
    answer: "Информация на карте обновляется ежедневно на основе данных от поставщиков и отзывов пользователей. Мы стараемся предоставлять самые свежие сведения, чтобы вы могли сэкономить на каждой заправке."
  },
  {
    question: "Что делать, если закончился бензин посреди дороги?",
    answer: "Если вы не рассчитали запас топлива и заглохли, я готов прийти на помощь. Я осуществляю подвоз бензина или дизельного топлива в любую точку Тюмени и области. Просто оставьте заявку на сайте, и я приеду к вам в течение 15-30 минут."
  },
  {
    question: "Какое топливо лучше заправлять в Тюмени?",
    answer: "Я рекомендую придерживаться рекомендаций производителя вашего автомобиля. В Тюмени представлены все крупные федеральные сети (Газпромнефть, Лукойл, Роснефть), и качество топлива на них, как правило, высокое. Моя карта поможет вам найти АИ-95, АИ-92 или дизель с актуальным ценником."
  },
  {
    question: "Как сэкономить на бензине в Тюмени?",
    answer: "Помимо мониторинга цен на моей карте, используйте бонусные программы сетей АЗС. Также следите за давлением в шинах и исправностью двигателя — это снижает расход. А планирование заправок через мой сервис позволит вам избежать переплат на 'дорогих' станциях города."
  }
];

const availableQueueDrivers = queueDrivers.filter((driver) => driver.status === 'free').slice(0, 6);
const queueGasStations = Object.values(gasStationLabels);
---

<Layout
	title={pageData.title}
	description={pageData.description}
	jsonLd={jsonLd}
>
	<Header />

	<PageHeader title={pageData.h1} items={[{ label: 'главная', href: '/' }, { label: 'цены на бензин' }]} showChatButton={true} />

	<!-- Gasoline Map Section Start -->
	<GasPricesIntro
		subtitle="Карта заправок Тюмени"
		title="Бензин по наличию на АЗС"
		description="Я отслеживаю актуальное наличие топлива и цены на заправках Тюмени. Используйте поиск и список слева, чтобы быстро найти нужную марку бензина (АИ-92, АИ-95) или дизельное топливо. Карта поможет проложить маршрут до ближайшей работающей станции."
		image="/images/blog/azs.jpg"
		imageAlt="Карта заправок и цены на бензин в Тюмени"
		features={[
			{ icon: '/images/icon-about-body-item-1.svg', iconAlt: 'Поиск АЗС', title: 'Быстрый поиск', text: 'Выберите нужное топливо и найдите ближайшую работающую АЗС.' },
			{ icon: '/images/icon-about-body-item-2.svg', iconAlt: 'Цены и наличие топлива', title: 'Цены и наличие', text: 'Сравните стоимость топлива, статус станции и информацию об очереди.' },
		]}
	/>

	<Alert />

	<GasPricesMapSection stations={stations} bounds={bounds} />
	<!-- Gasoline Map Section End -->

	<QueueDriversPreview drivers={availableQueueDrivers} stations={queueGasStations} />

	<!-- How It Work Section Start -->
	<HomeHowItWork 
		subtitle="Как пользоваться"
		title="Три простых шага к экономии"
		steps={[
			{
				icon: '/images/icon-how-it-work-1-gold.svg',
				number: '01',
				title: 'Выберите район',
				text: 'Найдите ближайшие к вам АЗС на интерактивной карте Тюмени.',
			},
			{
				icon: '/images/icon-how-it-work-2-gold.svg',
				number: '02',
				title: 'Сравните цены',
				text: 'Посмотрите актуальную стоимость вашего типа топлива в списке слева.',
			},
			{
				icon: '/images/icon-how-it-work-3-gold.svg',
				number: '03',
				title: 'Заправляйтесь выгодно',
				text: 'Выберите лучшую цену, проверьте отсутствие очередей и отправляйтесь в путь.',
			},
		]}
		footerList={[
			'Актуальные цены АИ-92 и АИ-95',
			'Наличие дизельного топлива',
			'Информация об очередях',
			'Подвоз бензина при пустом баке',
		]}
		footerText="Нужна помощь с топливом?"
		footerLinkText="Оставить заявку"
		footerLinkHref="/contacts"
	/>
	<!-- How It Work Section End -->

	<!-- Why Choose Section Start -->
	<HomeWhyChoose 
		subtitle="Мой мониторинг"
		title="Почему удобно смотреть цены здесь"
		description="Я объединил данные всех крупных сетей АЗС Тюмени, чтобы вы могли экономить время и деньги, не отвлекаясь от дороги. Больше не нужно объезжать город в поисках выгодного предложения."
		items={[
			{
				icon: '/images/icon-why-choose-body-1-gold.svg',
				title: 'Актуальность 24/7',
				text: 'Прямая интеграция с API гарантирует точность цен и статусов работы станций в реальном времени.',
			},
			{
				icon: '/images/icon-why-choose-body-2-gold.svg',
				title: 'Все марки топлива',
				text: 'Сравните стоимость АИ-92, АИ-95, 100-го бензина, ДТ и газа на одной удобной карте.',
			},
		]}
		ctaText="Вызвать подвоз топлива"
		ctaHref="/contacts"
		authorName="Ваш помощник «За рулём»"
		authorText="Всегда на связи в Тюмени"
	/>
	<!-- Why Choose Section End -->

    <!-- FAQ Section Start -->
	<HubFaqs 
		subtitle="Частые вопросы"
		title="Все о заправке в Тюмени"
		description="Я собрал ответы на самые частые вопросы водителей о ценах на бензин, наличии топлива и экстренной помощи на дорогах города."
		faqs={faqs}
	/>
    <!-- FAQ Section End -->

	<div class="gas-cta-section">
		<HubCta 
			subtitle="Маркетплейс водителей"
			title="Водители займут место на АЗС для вас"
			description="Не тратьте время в бесконечных очередях. Наши помощники приедут заранее, займут место у колонки и подождут вас. Вы просто подъезжаете к назначенному времени и заправляетесь без ожидания."
			btnText="Занять очередь"
			btnHref="/queue"
			contactTitle="Услуги водителей"
			contactText="Заказать очередь"
			contactLinkText="Перейти к выбору"
			contactLinkHref="/queue"
			features={[
				"Экономия от 1 до 3 часов времени",
				"Работаем на всех популярных АЗС",
				"Связь напрямую с водителем",
				"Доступно с 4 утра круглосуточно"
			]}
		/>
	</div>

	<style is:global>
		@media (max-width: 767px) {
			.section-title h2 {
				font-size: 26px !important;
			}
			.container-fluid.px-4 {
				padding-left: 15px !important;
				padding-right: 15px !important;
			}
			.how-it-work-gold,
			.why-choose-us-gold,
			.our-faqs {
				padding-top: 60px;
				padding-bottom: 60px;
			}
			.how-it-work-item-gold,
			.why-choose-item-gold,
			.accordion-item {
				width: 100%;
			}
			.how-it-work-footer-gold,
			.why-choose-footer-gold,
			.cta-content-footer {
				align-items: stretch;
				flex-direction: column;
			}
			.why-choose-btn-gold .btn-default,
			.cta-content-btn .btn-default,
			.faqs-btn .btn-default {
				width: 100%;
				justify-content: center;
				text-align: center;
			}
			.accordion-button {
				padding: 18px 48px 18px 18px;
				font-size: 16px;
				line-height: 1.4;
			}
			.gas-cta-section {
				margin-top: 50px;
				margin-bottom: 50px;
			}
			.gas-cta-section .cta-box {
				border-radius: 0;
			}
		}
	</style>

	<Footer />
</Layout>

<style>
    .gas-cta-section {
        margin-top: 90px;
        margin-bottom: 90px;
    }
    .accordion-button:not(.collapsed) {
        background-color: var(--primary-color, #ffb703);
        color: #000;
    }
    .accordion-button:focus {
        box-shadow: none;
        border-color: rgba(0,0,0,.125);
    }
</style>

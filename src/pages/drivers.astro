---
import Layout from '../layouts/Layout.astro';
import Header from '../components/shared/header/Header.astro';
import Footer from '../components/shared/footer/Footer.astro';
import ServiceFaqs from '../components/services/single/ServiceFaqs.astro';
import AboutCta from '../components/about/AboutCta.astro';
import FuelDeliveryCalculator from '../components/calculators/FuelDeliveryCalculator';
import FuelDeliveryFilters from '../components/fleets/FuelDeliveryFilters.astro';
import FuelDriverCard from '../components/fleets/FuelDriverCard.astro';
import { fuelDrivers } from '../data/fuelDrivers';

const title = "Доставка бензина от 1 часа в Тюмени — АИ-92, АИ-98, АИ-100 и ДТ";
const description = "Закажу доставку бензина и дизельного топлива от 1 часа в Тюмени и районах города. Выберите топливо, адрес и скорость выезда.";

const faqs = [
	{ question: 'Сколько занимает доставка бензина в Тюмени?', answer: 'Быстрый выезд занимает от 1 часа. Точное время зависит от района, загруженности дорог и выбранного адреса.' },
	{ question: 'В какие районы Тюмени выезжаете?', answer: 'Работаю по Тюмени: Центр, Заречный, КПД, Мыс, Ватутино, Тюменский, Дом Обороны и другие районы города. Адрес уточняю при оформлении заявки.' },
	{ question: 'Какое топливо можно заказать?', answer: 'Привезу АИ-92, АИ-98, АИ-100 или дизельное топливо. Перед выездом фиксирую марку, объем и итоговую стоимость.' },
	{ question: 'Можно ли заказать доставку, если машина не заводится?', answer: 'Да. Подъеду к автомобилю на парковке, во дворе или на дороге и передам топливо в безопасной таре.' },
	{ question: 'Как оформить доставку?', answer: 'Выберите топливо и скорость, укажите район или адрес и оставьте заявку. Я свяжусь с вами, подтвержу заказ и время приезда.' },
];
---

<Layout title={title} description={description}>
	<Header />

	<!-- Page Header Section Start -->
	<div class="page-header parallaxie">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<!-- Page Header Box Start -->
					<div class="page-header-box">
										<h1 class="text-anime-style-3" data-cursor="-opaque">Доставка бензина от 1 часа в Тюмени</h1>
						<nav class="wow fadeInUp">
							<ol class="breadcrumb">
								<li class="breadcrumb-item"><a href="/">Главная</a></li>
												<li class="breadcrumb-item active" aria-current="page">Доставка топлива</li>
							</ol>
						</nav>
					</div>
					<!-- Page Header Box End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Header Section End -->

	<!-- Page Fleets Section Start -->
	<div class="page-fleets">
		<div class="container">

			<div class="dark-section bg-section mb-5">
				<div class="container-fluid p-5">
					<div class="row align-items-center">
						<div class="col-xl-9 col-lg-8">
							<div class="section-title mb-lg-0">
								<span class="section-sub-title wow fadeInUp" style="color: var(--accent-color);">Сообщество водителей</span>
								<h2 class="text-anime-style-3 mb-2" data-cursor="-opaque" style="color: white; font-size: 28px;">Хотите быть в курсе всех заправок, очередей и наличия бензина?</h2>
								<p class="wow fadeInUp mb-0" data-wow-delay="0.2s" style="color: white; opacity: 0.9;">Вступайте в Telegram и VK группу, давайте развивать сообщество и помогать друг другу в такие непростые времена!</p>
							</div>
						</div>
						<div class="col-xl-3 col-lg-4 text-lg-end mt-4 mt-lg-0">
							<div class="wow fadeInUp" data-wow-delay="0.4s">
								<a href="https://t.me/zarulem72" class="btn-default btn-highlighted me-2 mb-2"><i class="fa-brands fa-telegram me-2"></i> Telegram</a>
								<a href="https://vk.ru/za_rulem72" class="btn-default btn-white mb-2"><i class="fa-brands fa-vk me-2"></i> VK группа</a>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="row fuel-delivery-layout">
				<div class="col-lg-3">
					<FuelDeliveryFilters />
				</div>

				<div class="col-lg-9">
					<!-- Info Box Start -->
					<div class="fuel-delivery-intro wow fadeInUp">
						<div class="service-content">
							<span class="section-sub-title">Доставка по Тюмени</span>
							<h2>Ближайший водитель уже готов помочь</h2>
							<p>Я заберу топливо на АЗС и привезу его прямо к автомобилю. Не нужно оставлять машину на обочине или искать канистру: выберите марку, район и скорость доставки.</p>
						</div>
					</div>
					<!-- Info Box End -->

					<!-- Fleet Item List Start -->
					<div class="driver-grid" id="fuel-options">
						{fuelDrivers.map((driver) => <FuelDriverCard driver={driver} />)}
					</div>
					<p class="driver-grid__empty" id="drivers-empty" hidden>По выбранным параметрам водителей пока нет. Измените район, топливо или скорость доставки.</p>
					<nav class="driver-pagination" id="driver-pagination" aria-label="Страницы водителей"></nav>
					<!-- Fleet Item List End -->
				</div>
			</div>
		</div>
	</div>
	<!-- Page Fleets Section End -->

	<section class="fuel-delivery-calculator-section bg-section">
		<div class="container"><FuelDeliveryCalculator client:visible /></div>
	</section>
	<section class="fuel-delivery-faq-section">
		<div class="container"><ServiceFaqs faqs={faqs} title="FAQ о доставке топлива в Тюмени" /></div>
	</section>
	<section class="fuel-delivery-cta-section">
		<AboutCta />
	</section>

	<script>
		const cards = [...document.querySelectorAll<HTMLElement>('[data-driver-card]')];
		const pagination = document.querySelector<HTMLElement>('#driver-pagination');
		const empty = document.querySelector<HTMLElement>('#drivers-empty');
		let page = 1;
		const pageSize = 10;

		const filter = () => {
			const selected = [...document.querySelectorAll<HTMLInputElement>('.fuel-filter:checked')].map((input) => input.value);
			const district = document.querySelector<HTMLSelectElement>('#district')?.value ?? 'all';
			const speed = document.querySelector<HTMLInputElement>('.speed-filter:checked')?.value ?? 'fast';
			const reason = document.querySelector<HTMLInputElement>('.reason-filter:checked')?.value ?? 'all';
			const matches = cards.filter((card) => {
				const fuels = card.dataset.fuels?.split(',') ?? [];
				return (district === 'all' || card.dataset.district === district)
					&& selected.some((fuel) => fuels.includes(fuel))
					&& card.dataset.speed === speed
					&& (reason === 'all' || card.dataset.reason === reason);
			});
			const pages = Math.ceil(matches.length / pageSize);
			page = Math.min(page, Math.max(pages, 1));
			cards.forEach((card) => card.hidden = true);
			matches.slice((page - 1) * pageSize, page * pageSize).forEach((card) => card.hidden = false);
			empty?.toggleAttribute('hidden', matches.length > 0);
			if (pagination) {
				pagination.innerHTML = Array.from({ length: pages }, (_, index) => `<button type="button" class="${page === index + 1 ? 'is-active' : ''}" data-page="${index + 1}" aria-label="Страница ${index + 1}">${index + 1}</button>`).join('');
			}
		};

		document.querySelectorAll('.fuel-filter, .speed-filter, .reason-filter, #district').forEach((input) => input.addEventListener('change', () => { page = 1; filter(); }));
		document.querySelector('#filter-submit')?.addEventListener('click', () => { page = 1; filter(); });
		pagination?.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-page]');
			if (!button) return;
			page = Number(button.dataset.page);
			filter();
			document.querySelector('#fuel-options')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
		filter();
	</script>

	<style>
		.fuel-delivery-layout {
			row-gap: 40px;
		}

		.fuel-delivery-intro {
			margin-bottom: 36px;
			padding: 32px;
			background: var(--secondary-color);
			border-radius: 20px;
		}

		.fuel-delivery-intro .section-sub-title {
			display: inline-block;
			margin-bottom: 12px;
		}

		.fuel-delivery-intro h2 {
			margin-bottom: 16px;
		}

		.fuel-delivery-intro p {
			margin-bottom: 0;
		}

		.driver-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 18px;
		}

		.driver-grid__empty { padding: 30px; border-radius: 16px; background: var(--secondary-color); text-align: center; }
		.driver-pagination { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 36px; }
		.driver-pagination :global(button) { width: 42px; height: 42px; border: 0; border-radius: 50%; background: var(--secondary-color); color: var(--primary-color); font-weight: 700; transition: .3s ease; }
		.driver-pagination :global(button:hover), .driver-pagination :global(button.is-active) { background: var(--accent-color); }

		.fuel-delivery-calculator-section,
		.fuel-delivery-faq-section {
			padding: 120px 0;
		}

		.fuel-delivery-cta-section {
			padding-bottom: 120px;
		}

		.fuel-delivery-calculator-section :global(.fuel-calculator) {
			margin: 0;
		}

		.fuel-delivery-faq-section :global(.page-single-faqs) {
			max-width: 980px;
			margin: 0 auto;
		}

		.fuel-delivery-faq-section :global(.section-title) {
			margin-bottom: 40px;
			text-align: center;
		}

		@media (max-width: 991px) {
			.driver-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
			.fuel-delivery-calculator-section,
			.fuel-delivery-faq-section {
				padding: 80px 0;
			}

			.fuel-delivery-cta-section {
				padding-bottom: 80px;
			}
		}

		@media (max-width: 767px) {
			.driver-grid { grid-template-columns: 1fr; }
			.fuel-delivery-intro {
				margin-bottom: 24px;
				padding: 24px 20px;
			}

			.fuel-delivery-calculator-section,
			.fuel-delivery-faq-section {
				padding: 60px 0;
			}

			.fuel-delivery-cta-section {
				padding-bottom: 60px;
			}
		}
	</style>

	<Footer />
</Layout>

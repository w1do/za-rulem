---
import QueueBucket from './QueueBucket.astro';
import { formatGasDate } from '../../gas-prices';
import { chatAppUrl, getCityUrl, type ChatCity } from '../../../lib/cities';
import type { CityQueueBoard } from '../model/types';

interface Props {
	board: CityQueueBoard;
	city: ChatCity;
	subtitle?: string;
	title?: string;
	description?: string;
	mapHref?: string;
	headingLevel?: 'h2' | 'h3';
}

const {
	board,
	city,
	subtitle = 'Очереди на АЗС сейчас',
	title = `Где сейчас заправиться без очереди ${city.inCity}`,
	description = 'Я разложил заправки города по загруженности: данные приходят из отчётов АЗС и обновляются в течение дня.',
	mapHref = '#gas-stations-map',
	headingLevel = 'h2',
} = Astro.props;

const Heading = headingLevel;
const queueHref = getCityUrl('/queue', city.slug);
const chatHref = chatAppUrl(city.slug);
const summary = board.buckets.map((bucket) => ({
	id: bucket.id,
	title: bucket.title,
	total: bucket.total,
	color: bucket.color,
}));
---

<section class="queue-board-section">
	<div class="container">
		<div class="section-title queue-board-section__title">
			<span class="section-sub-title wow fadeInUp">{subtitle}</span>
			<Heading class="text-anime-style-3" data-cursor="-opaque">{title}</Heading>
			<p class="wow fadeInUp" data-wow-delay="0.2s">{description}</p>
		</div>

		{
			board.hasData ? (
				<>
					<ul class="queue-board-summary" aria-label="Сводка по очередям на АЗС">
						{summary.map((item) => (
							<li style={`--queue-status-color: ${item.color};`}>
								<strong>{item.total}</strong>
								<span>{item.title}</span>
							</li>
						))}
						{board.updatedAt && (
							<li class="queue-board-summary__updated">
								Обновлено:{' '}
								<time datetime={board.updatedAt}>{formatGasDate(board.updatedAt)}</time>
							</li>
						)}
					</ul>

					{board.buckets
						.filter((bucket) => bucket.stations.length > 0)
						.map((bucket) => (
							<QueueBucket
								bucket={bucket}
								mapHref={mapHref}
								queueHref={queueHref}
								chatHref={chatHref}
							/>
						))}
				</>
			) : (
				<div class="queue-board-empty">
					<p>
						Сейчас у меня нет свежих данных об очередях на АЗС {city.inCity}.
						Я не показываю статусы, в которых не уверен.
					</p>
					<div class="queue-board-empty__actions">
						<a href={mapHref} class="btn-default">Открыть карту АЗС</a>
						<a href={chatHref} class="queue-board-empty__link">Спросить водителей в чате</a>
					</div>
				</div>
			)
		}
	</div>
</section>

<style>
	.queue-board-section { padding: 70px 0 30px; }
	.queue-board-section__title { max-width: 820px; margin: 0 auto 28px; text-align: center; }
	.queue-board-section__title p { margin-bottom: 0; }

	.queue-board-summary {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 12px;
		margin: 0 0 40px;
		padding: 0;
		list-style: none;
	}

	.queue-board-summary li {
		display: flex;
		align-items: baseline;
		gap: 8px;
		padding: 8px 16px;
		border: 1px solid var(--divider-color);
		border-radius: 999px;
		background: var(--white-color);
		font-size: 15px;
	}

	.queue-board-summary li strong { color: var(--queue-status-color); font-size: 18px; }

	.queue-board-summary__updated {
		border-style: dashed;
		color: var(--text-color);
		font-size: 14px;
	}

	.queue-board-empty {
		max-width: 720px;
		margin: 0 auto;
		padding: 28px;
		border: 1px solid var(--divider-color);
		border-radius: 20px;
		background: var(--secondary-color);
		text-align: center;
	}

	.queue-board-empty p { margin: 0 0 20px; }

	.queue-board-empty__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 18px;
	}

	.queue-board-empty__link { color: var(--accent-color); font-weight: 600; text-decoration: underline; }

	@media (max-width: 767px) {
		.queue-board-section { padding: 45px 0 20px; }
		.queue-board-section__title { margin-bottom: 22px; text-align: left; }
		.queue-board-summary { justify-content: flex-start; margin-bottom: 28px; }
		.queue-board-empty { padding: 22px; text-align: left; }
		.queue-board-empty__actions { justify-content: flex-start; }
	}
</style>

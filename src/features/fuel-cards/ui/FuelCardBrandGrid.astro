---
import { fuelCardBrandUrl } from '../model/brands';
import type { FuelCardBrand } from '../model/types';

interface Props {
	brands: FuelCardBrand[];
	id?: string;
	subtitle?: string;
	title?: string;
	description?: string;
}

const {
	brands,
	id = 'fuel-card-brands',
	subtitle = 'Популярные сети АЗС',
	title = 'Топливные карты по брендам заправок',
	description = 'Выберите сеть, чтобы посмотреть параметры подбора и оставить заявку на топливную карту для бизнеса.',
} = Astro.props;
---

<section id={id} class="fuel-card-brands" aria-labelledby={`${id}-title`}>
	<div class="container">
		<div class="section-title section-title-center">
			<span class="section-sub-title wow fadeInUp">{subtitle}</span>
			<h2 id={`${id}-title`} class="text-anime-style-3" data-cursor="-opaque">{title}</h2>
			<p>{description}</p>
		</div>

		<div class="fuel-card-brands__grid">
			{brands.map((brand, index) => (
				<a
					class="fuel-card-brand wow fadeInUp"
					href={fuelCardBrandUrl(brand.slug)}
					data-wow-delay={index % 3 === 0 ? undefined : `${(index % 3) * 0.15}s`}
				>
					<span class="fuel-card-brand__mark" aria-hidden="true">{brand.name.slice(0, 2).toUpperCase()}</span>
					<span class="fuel-card-brand__audience">Для ИП, ООО и автопарков</span>
					<h3>Топливная карта {brand.name}</h3>
					<p>Подбор по маршрутам, расходу топлива, документам и управлению картами водителей.</p>
					<span class="fuel-card-brand__link">Подробнее и заказать <span aria-hidden="true">→</span></span>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.fuel-card-brands {
		padding: 100px 0;
		background: var(--white-color);
	}

	.fuel-card-brands .section-title {
		max-width: 820px;
		margin: 0 auto 45px;
	}

	.fuel-card-brands .section-title p {
		margin: 18px auto 0;
	}

	.fuel-card-brands__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}

	.fuel-card-brand {
		display: flex;
		min-height: 310px;
		padding: 28px;
		flex-direction: column;
		border: 1px solid var(--divider-color);
		border-radius: 20px;
		background: var(--white-color);
		box-shadow: 0 12px 35px rgba(22, 22, 22, 0.06);
		transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.fuel-card-brand:hover,
	.fuel-card-brand:focus-visible {
		border-color: var(--accent-color);
		box-shadow: 0 16px 40px rgba(22, 22, 22, 0.1);
		transform: translateY(-4px);
	}

	.fuel-card-brand__mark {
		display: inline-flex;
		width: 64px;
		height: 64px;
		margin-bottom: 22px;
		align-items: center;
		justify-content: center;
		border-radius: 16px;
		background: var(--accent-color);
		color: var(--primary-color);
		font-size: 20px;
		font-weight: 800;
	}

	.fuel-card-brand__audience {
		margin-bottom: 10px;
		color: var(--accent-color);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.fuel-card-brand h3 {
		margin-bottom: 12px;
		color: var(--primary-color);
		font-size: 24px;
	}

	.fuel-card-brand p {
		margin-bottom: 24px;
		color: var(--text-color);
	}

	.fuel-card-brand__link {
		margin-top: auto;
		color: var(--primary-color);
		font-weight: 700;
	}

	@media (max-width: 991px) {
		.fuel-card-brands__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 767px) {
		.fuel-card-brands {
			padding: 70px 0;
		}

		.fuel-card-brands__grid {
			grid-template-columns: 1fr;
		}

		.fuel-card-brand {
			min-height: 0;
		}
	}
</style>

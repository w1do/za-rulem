---
/**
 * Блок аналитики очередей: текущая обстановка на АЗС города по снимкам `gas_daily`
 * и подсказки, когда и на какой заправке выгоднее занимать очередь.
 */

import { buildQueueAnalytics } from '../model/queueAnalytics';
import type { MapStation } from '../model/types';

export interface Props {
	cityName: string;
	stations: MapStation[];
}

const { cityName, stations } = Astro.props;
const analytics = buildQueueAnalytics(stations);

const toneLabel: Record<string, string> = {
	calm: 'Спокойно',
	moderate: 'Средняя загрузка',
	busy: 'Час пик',
};

const currentDate = new Intl.DateTimeFormat('ru-RU', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
}).format(new Date());

const analyticsTitle = `Обстановка на заправках ${cityName} ${currentDate}, занять очередь на АЗС`;
---

<section class="queue-analytics" aria-label={analyticsTitle}>
	<div class="container">
		<div class="queue-analytics__head">
			<h2>{analyticsTitle}</h2>
			<p>
				Данные берутся из ежедневных снимков заправок <code>gas_daily</code>: сколько АЗС стоит без
				очереди прямо сейчас, где ожидание самое долгое и в какие часы место в очереди обходится
				дешевле.
			</p>
		</div>

		<div class="queue-analytics__grid">
			<article class={`queue-analytics__card queue-analytics__card--${analytics.tone}`}>
				<span class="queue-analytics__label">Обстановка сейчас</span>
				<h3>{analytics.free} из {analytics.total} АЗС без очереди</h3>
				<p>{analytics.verdict}</p>
				<ul class="queue-analytics__stats">
					<li><b>{analytics.free}</b> без очереди</li>
					<li><b>{analytics.small}</b> небольшая очередь</li>
					<li><b>{analytics.large}</b> большая очередь</li>
					{analytics.closed > 0 && <li><b>{analytics.closed}</b> закрыты</li>}
				</ul>
			</article>

			<article class="queue-analytics__card">
				<span class="queue-analytics__label">Куда ехать без ожидания</span>
				<h3>Спокойные заправки</h3>
				{analytics.calmStations.length > 0 ? (
					<ul class="queue-analytics__stations">
						{analytics.calmStations.map((station) => (
							<li>
								<b>{station.name}</b>
								{station.address && <span>{station.address}</span>}
							</li>
						))}
					</ul>
				) : (
					<p>Сейчас свободных АЗС в снимке нет — проверьте карту, данные обновляются в течение дня.</p>
				)}
			</article>

			<article class="queue-analytics__card">
				<span class="queue-analytics__label">Где стоят дольше всего</span>
				<h3>Загруженные заправки</h3>
				{analytics.busyStations.length > 0 ? (
					<ul class="queue-analytics__stations">
						{analytics.busyStations.map((station) => (
							<li>
								<b>{station.name}</b>
								{station.address && <span>{station.address}</span>}
							</li>
						))}
					</ul>
				) : (
					<p>Больших очередей в последнем снимке нет — можно заправляться самому.</p>
				)}
				<p class="queue-analytics__note">
					На этих АЗС заявку выгоднее подавать заранее: повышенный тариф +80% включается, когда ждать
					уже некогда.
				</p>
			</article>
		</div>

		<div class="queue-analytics__windows" data-queue-windows>
			<h3>Когда лучше занимать очередь</h3>
			<p class="queue-analytics__note">
				Типовой суточный ритм заправок города. Текущее окно подсвечивается по времени вашего
				устройства.
			</p>
			<div class="queue-analytics__windows-grid">
				{analytics.windows.map((window) => (
					<article
						class={`queue-window queue-window--${window.tone}`}
						data-from={window.fromHour}
						data-to={window.toHour}
					>
						<span class="queue-window__time">{window.label}</span>
						<span class="queue-window__tone">{toneLabel[window.tone]}</span>
						<p>{window.advice}</p>
					</article>
				))}
			</div>
		</div>
	</div>
</section>

<script is:inline>
	(function () {
		var root = document.querySelector('[data-queue-windows]');
		if (!root) return;
		var hour = new Date().getHours();
		var cards = root.querySelectorAll('.queue-window');
		for (var i = 0; i < cards.length; i += 1) {
			var from = Number(cards[i].getAttribute('data-from'));
			var to = Number(cards[i].getAttribute('data-to'));
			if (hour >= from && hour < to) cards[i].classList.add('is-now');
		}
	})();
</script>

<style>
	.queue-analytics {
		padding: 8px 0 56px;
	}

	.queue-analytics__head {
		max-width: 780px;
		margin-bottom: 28px;
	}

	.queue-analytics__head h2 {
		margin-bottom: 10px;
		font-size: 32px;
	}

	.queue-analytics__head p {
		margin-bottom: 0;
	}

	.queue-analytics__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 20px;
		margin-bottom: 32px;
	}

	.queue-analytics__card {
		padding: 26px 24px;
		border: 1px solid #e5e7eb;
		border-radius: 18px;
		background: #fff;
		box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
	}

	.queue-analytics__card--busy {
		border-color: #fecaca;
		background: #fef2f2;
	}

	.queue-analytics__card--moderate {
		border-color: #fde68a;
		background: #fffbeb;
	}

	.queue-analytics__card--calm {
		border-color: #bbf7d0;
		background: #f0fdf4;
	}

	.queue-analytics__label {
		display: inline-block;
		margin-bottom: 8px;
		color: #6b7280;
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.queue-analytics__card h3 {
		margin-bottom: 10px;
		font-size: 21px;
	}

	.queue-analytics__stats,
	.queue-analytics__stations {
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
	}

	.queue-analytics__stats li {
		display: inline-block;
		margin: 0 14px 6px 0;
		color: #374151;
		font-size: 15px;
	}

	.queue-analytics__stations li {
		display: flex;
		flex-direction: column;
		padding: 8px 0;
		border-top: 1px solid #e5e7eb;
		font-size: 15px;
	}

	.queue-analytics__stations li span {
		color: #6b7280;
		font-size: 14px;
	}

	.queue-analytics__note {
		margin: 12px 0 0;
		color: #6b7280;
		font-size: 14px;
	}

	.queue-analytics__windows h3 {
		margin-bottom: 8px;
		font-size: 24px;
	}

	.queue-analytics__windows-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 16px;
		margin-top: 18px;
	}

	.queue-window {
		padding: 20px;
		border: 1px solid #e5e7eb;
		border-radius: 16px;
		background: #fff;
	}

	.queue-window p {
		margin: 8px 0 0;
		color: #374151;
		font-size: 15px;
	}

	.queue-window__time {
		display: block;
		font-size: 18px;
		font-weight: 700;
	}

	.queue-window__tone {
		display: inline-block;
		margin-top: 6px;
		padding: 2px 10px;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 600;
	}

	.queue-window--calm .queue-window__tone {
		background: #dcfce7;
		color: #047857;
	}

	.queue-window--moderate .queue-window__tone {
		background: #fef3c7;
		color: #b45309;
	}

	.queue-window--busy .queue-window__tone {
		background: #fee2e2;
		color: #b91c1c;
	}

	.queue-window.is-now {
		border-color: #f5b754;
		box-shadow: 0 10px 26px rgba(245, 183, 84, 0.28);
	}

	@media (max-width: 767px) {
		.queue-analytics__head h2 {
			font-size: 26px;
		}
	}
</style>
